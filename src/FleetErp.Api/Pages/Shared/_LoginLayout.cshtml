<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | FleetERP</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <!-- Custom CSS -->
    <link href="~/css/colors.css" rel="stylesheet" />

    <style>
        html, body {
            height: 100%;
        }

        body {
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, var(--main-color) 0%, #1a1f5c 100%);
        }

        .login-card {
            background: white;
            border-radius: 15px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
            max-width: 400px;
            width: 100%;
            padding: 2rem;
        }

        .login-header {
            text-align: center;
            margin-bottom: 2rem;
        }

        .login-header h1 {
            color: var(--main-color);
            font-size: 2rem;
            font-weight: 700;
        }

        .login-header p {
            color: #6c757d;
            margin-bottom: 0;
        }

        .form-control:focus {
            border-color: var(--main-color);
            box-shadow: 0 0 0 0.2rem rgba(10, 15, 55, 0.25);
        }

        .btn-login {
            background-color: var(--main-color);
            border-color: var(--main-color);
            color: white;
            padding: 0.75rem;
            font-weight: 600;
        }

        .btn-login:hover {
            background-color: #080b29;
            border-color: #080b29;
            color: white;
        }

        .login-icon {
            font-size: 3rem;
            color: var(--main-color);
            margin-bottom: 1rem;
        }
    </style>
</head>
<body>
    <div class="login-card">
        @RenderBody()
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
