@page "{id:int}"
@model FleetErp.Api.Pages.Admin.Rentals.DetailsModel
@{
    ViewData["Title"] = $"Rental Details - {Model.Rental.RentalNumber}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">
        <i class="fas fa-file-contract me-2"></i>Rental: <code>@Model.Rental.RentalNumber</code>
    </h1>
    <div>
        @if (Model.Rental.StatusName?.ToUpper() == "ACTIVE")
        {
            <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#completeModal">
                <i class="fas fa-check-circle me-2"></i>Complete Rental
            </button>
        }
        @if (Model.Rental.StatusName?.ToUpper() != "COMPLETED" && Model.Rental.StatusName?.ToUpper() != "CANCELLED")
        {
            <form method="post" asp-page-handler="Cancel" class="d-inline">
                <button type="submit" class="btn btn-warning" onclick="return confirm('Are you sure you want to cancel this rental?');">
                    <i class="fas fa-ban me-2"></i>Cancel
                </button>
            </form>
        }
        <a asp-page="Edit" asp-route-id="@Model.Rental.Id" class="btn btn-primary">
            <i class="fas fa-edit me-2"></i>Edit
        </a>
        <a asp-page="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i>Back to List
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <div class="col-lg-8">
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between">
                <h5 class="mb-0"><i class="fas fa-info-circle me-2"></i>Rental Information</h5>
                <div>
                    @{
                        var statusBadge = Model.Rental.StatusName?.ToUpper() switch
                        {
                            "RESERVED" => "bg-info",
                            "ACTIVE" => "bg-primary",
                            "COMPLETED" => "badge-active",
                            "CANCELLED" => "badge-inactive",
                            _ => "bg-secondary"
                        };
                        var paymentBadge = Model.Rental.PaymentStatusName?.ToUpper() switch
                        {
                            "PAID" => "badge-active",
                            "PARTIAL" => "bg-warning text-dark",
                            "UNPAID" => "bg-danger",
                            _ => "bg-secondary"
                        };
                    }
                    <span class="badge @statusBadge fs-6 me-1">@Model.Rental.StatusName</span>
                    <span class="badge @paymentBadge fs-6">@Model.Rental.PaymentStatusName</span>
                </div>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label text-muted">Vehicle</label>
                        <div>
                            <strong class="fs-5">@Model.Rental.VehiclePlateNumber</strong><br />
                            <span class="text-muted">@Model.Rental.VehicleDescription</span>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label text-muted">Customer</label>
                        <div class="fw-bold fs-5">@Model.Rental.CustomerName</div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label class="form-label text-muted">Start Date</label>
                        <div class="fw-bold">@Model.Rental.StartDate.ToString("MMM dd, yyyy")</div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label text-muted">End Date</label>
                        <div class="fw-bold">@Model.Rental.EndDate.ToString("MMM dd, yyyy")</div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label text-muted">Actual Return</label>
                        <div class="fw-bold">@(Model.Rental.ActualReturnDate?.ToString("MMM dd, yyyy") ?? "Not returned")</div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label text-muted">Total Days</label>
                        <div class="fw-bold">@Model.Rental.TotalDays days</div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label text-muted">Odometer Start</label>
                        <div class="fw-bold">@Model.Rental.OdometerStart.ToString("N0") km</div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label text-muted">Odometer End</label>
                        <div class="fw-bold">@(Model.Rental.OdometerEnd?.ToString("N0") ?? "N/A") km</div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label text-muted">Distance Traveled</label>
                        <div class="fw-bold">
                            @if (Model.Rental.OdometerEnd.HasValue)
                            {
                                @((Model.Rental.OdometerEnd.Value - Model.Rental.OdometerStart).ToString("N0"))<text> km</text>
                            }
                            else
                            {
                                <text>N/A</text>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0"><i class="fas fa-dollar-sign me-2"></i>Pricing</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label class="form-label text-muted">Daily Rate</label>
                        <div class="fw-bold">@Model.Rental.DailyRate.ToString("C")</div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label text-muted">SubTotal</label>
                        <div class="fw-bold">@Model.Rental.SubTotal.ToString("C")</div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label text-muted">Discount</label>
                        <div class="fw-bold text-danger">-@Model.Rental.Discount.ToString("C")</div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label text-muted">Total Amount</label>
                        <div class="fw-bold fs-4 text-primary">@Model.Rental.TotalAmount.ToString("C")</div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label text-muted">Paid Amount</label>
                        <div class="fw-bold fs-5 text-success">@Model.Rental.PaidAmount.ToString("C")</div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label text-muted">Remaining</label>
                        <div class="fw-bold fs-5 @(Model.Rental.RemainingAmount > 0 ? "text-danger" : "text-success")">
                            @Model.Rental.RemainingAmount.ToString("C")
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Rental.Notes))
        {
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-sticky-note me-2"></i>Notes</h5>
                </div>
                <div class="card-body">
                    <div class="border rounded p-3 bg-light">@Model.Rental.Notes</div>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-4">
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="fas fa-credit-card me-2"></i>Payments</h5>
                @if (Model.Rental.RemainingAmount > 0)
                {
                    <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addPaymentModal">
                        <i class="fas fa-plus me-1"></i>Add Payment
                    </button>
                }
            </div>
            <div class="card-body">
                @if (Model.Payments.Count == 0)
                {
                    <p class="text-muted mb-0">No payments recorded.</p>
                }
                else
                {
                    <div class="list-group">
                        @foreach (var payment in Model.Payments)
                        {
                            <div class="list-group-item">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <strong class="text-success">@payment.Amount.ToString("C")</strong>
                                        <br />
                                        <small class="text-muted">@payment.PaymentMethodName</small>
                                        <br />
                                        <small class="text-muted">@payment.PaymentDate.ToString("MMM dd, yyyy")</small>
                                        @if (!string.IsNullOrWhiteSpace(payment.TransactionReference))
                                        {
                                            <br />
                                            <small class="text-muted">Ref: @payment.TransactionReference</small>
                                        }
                                    </div>
                                    <form method="post" asp-page-handler="DeletePayment" asp-route-id="@Model.Rental.Id" asp-route-paymentId="@payment.Id" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this payment?');">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="fas fa-clock me-2"></i>Audit Info</h5>
            </div>
            <div class="card-body">
                <div class="mb-2">
                    <label class="form-label text-muted mb-0">Created</label>
                    <div class="small">@Model.Rental.CreatedAt.ToString("MMM dd, yyyy HH:mm")</div>
                </div>
                @if (Model.Rental.UpdatedAt.HasValue)
                {
                    <div class="mb-2">
                        <label class="form-label text-muted mb-0">Last Updated</label>
                        <div class="small">@Model.Rental.UpdatedAt.Value.ToString("MMM dd, yyyy HH:mm")</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Complete Rental Modal -->
<div class="modal fade" id="completeModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Complete">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-check-circle me-2"></i>Complete Rental</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label asp-for="CompleteInput.ActualReturnDate" class="form-label">Return Date <span class="text-danger">*</span></label>
                        <input asp-for="CompleteInput.ActualReturnDate" class="form-control" type="date" />
                        <span asp-validation-for="CompleteInput.ActualReturnDate" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="CompleteInput.OdometerEnd" class="form-label">Odometer End <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <input asp-for="CompleteInput.OdometerEnd" class="form-control" type="number" min="@Model.Rental.OdometerStart" />
                            <span class="input-group-text">km</span>
                        </div>
                        <small class="text-muted">Start: @Model.Rental.OdometerStart.ToString("N0") km</small>
                        <span asp-validation-for="CompleteInput.OdometerEnd" class="text-danger"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Complete Rental</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Add Payment Modal -->
<div class="modal fade" id="addPaymentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="AddPayment">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-credit-card me-2"></i>Add Payment</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-info">
                        <strong>Remaining:</strong> @Model.Rental.RemainingAmount.ToString("C")
                    </div>
                    <div class="mb-3">
                        <label asp-for="PaymentInput.Amount" class="form-label">Amount <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="PaymentInput.Amount" class="form-control" type="number" step="0.01" min="0.01" max="@Model.Rental.RemainingAmount" />
                        </div>
                        <span asp-validation-for="PaymentInput.Amount" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="PaymentInput.PaymentDate" class="form-label">Payment Date <span class="text-danger">*</span></label>
                        <input asp-for="PaymentInput.PaymentDate" class="form-control" type="date" />
                        <span asp-validation-for="PaymentInput.PaymentDate" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="PaymentInput.PaymentMethodId" class="form-label">Payment Method <span class="text-danger">*</span></label>
                        <select asp-for="PaymentInput.PaymentMethodId" asp-items="Model.PaymentMethodOptions" class="form-select">
                            <option value="">-- Select Method --</option>
                        </select>
                        <span asp-validation-for="PaymentInput.PaymentMethodId" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="PaymentInput.TransactionReference" class="form-label">Transaction Reference</label>
                        <input asp-for="PaymentInput.TransactionReference" class="form-control" />
                        <span asp-validation-for="PaymentInput.TransactionReference" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="PaymentInput.Notes" class="form-label">Notes</label>
                        <textarea asp-for="PaymentInput.Notes" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="PaymentInput.Notes" class="text-danger"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Add Payment</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
