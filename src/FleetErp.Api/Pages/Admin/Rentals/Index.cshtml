@page
@model FleetErp.Api.Pages.Admin.Rentals.IndexModel
@{
    ViewData["Title"] = "Rentals";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">
        <i class="fas fa-file-contract me-2"></i>Rentals
    </h1>
    <a asp-page="Create" class="btn btn-primary">
        <i class="fas fa-plus me-2"></i>New Rental
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="card-body">
        <table id="rentalsTable" class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Rental #</th>
                    <th>Vehicle</th>
                    <th>Customer</th>
                    <th>Dates</th>
                    <th>Total</th>
                    <th>Paid</th>
                    <th>Status</th>
                    <th>Payment</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var rental in Model.Rentals)
                {
                    <tr>
                        <td><code>@rental.RentalNumber</code></td>
                        <td>
                            <strong>@rental.VehiclePlateNumber</strong><br />
                            <small class="text-muted">@rental.VehicleDescription</small>
                        </td>
                        <td>@rental.CustomerName</td>
                        <td>
                            @rental.StartDate.ToString("MMM dd") - @rental.EndDate.ToString("MMM dd, yyyy")
                        </td>
                        <td>@rental.TotalAmount.ToString("C")</td>
                        <td>@rental.PaidAmount.ToString("C")</td>
                        <td>
                            @{
                                var statusBadge = rental.StatusName?.ToUpper() switch
                                {
                                    "RESERVED" => "bg-info",
                                    "ACTIVE" => "bg-primary",
                                    "COMPLETED" => "badge-active",
                                    "CANCELLED" => "badge-inactive",
                                    _ => "bg-secondary"
                                };
                            }
                            <span class="badge @statusBadge">@rental.StatusName</span>
                        </td>
                        <td>
                            @{
                                var paymentBadge = rental.PaymentStatusName?.ToUpper() switch
                                {
                                    "PAID" => "badge-active",
                                    "PARTIAL" => "bg-warning text-dark",
                                    "UNPAID" => "bg-danger",
                                    _ => "bg-secondary"
                                };
                            }
                            <span class="badge @paymentBadge">@rental.PaymentStatusName</span>
                        </td>
                        <td>
                            <div class="btn-group btn-group-sm">
                                <a asp-page="Details" asp-route-id="@rental.Id" class="btn btn-outline-info" title="View">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a asp-page="Edit" asp-route-id="@rental.Id" class="btn btn-outline-primary" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a asp-page="Delete" asp-route-id="@rental.Id" class="btn btn-outline-danger" title="Delete">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#rentalsTable').DataTable({
                pageLength: 20,
                order: [[0, 'desc']],
                language: {
                    search: "Search:",
                    lengthMenu: "Show _MENU_ entries",
                    info: "Showing _START_ to _END_ of _TOTAL_ rentals",
                    paginate: {
                        first: "First",
                        last: "Last",
                        next: "Next",
                        previous: "Previous"
                    }
                }
            });
        });
    </script>
}
