@page "{id:int}"
@model FleetErp.Api.Pages.Admin.Rentals.DeleteModel
@{
    ViewData["Title"] = $"Delete Rental - {Model.Rental.RentalNumber}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">
        <i class="fas fa-trash me-2 text-danger"></i>Delete Rental
    </h1>
    <a asp-page="Index" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-2"></i>Back to List
    </a>
</div>

<div class="card border-danger">
    <div class="card-header bg-danger text-white">
        <h5 class="mb-0"><i class="fas fa-exclamation-triangle me-2"></i>Confirm Deletion</h5>
    </div>
    <div class="card-body">
        <p class="lead">Are you sure you want to delete this rental?</p>

        <div class="row mb-4">
            <div class="col-md-6">
                <dl class="row">
                    <dt class="col-sm-4">Rental #</dt>
                    <dd class="col-sm-8"><code class="fs-5">@Model.Rental.RentalNumber</code></dd>

                    <dt class="col-sm-4">Vehicle</dt>
                    <dd class="col-sm-8">
                        <strong>@Model.Rental.VehiclePlateNumber</strong><br />
                        <small class="text-muted">@Model.Rental.VehicleDescription</small>
                    </dd>

                    <dt class="col-sm-4">Customer</dt>
                    <dd class="col-sm-8">@Model.Rental.CustomerName</dd>

                    <dt class="col-sm-4">Dates</dt>
                    <dd class="col-sm-8">@Model.Rental.StartDate.ToString("MMM dd") - @Model.Rental.EndDate.ToString("MMM dd, yyyy")</dd>

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">
                        @{
                            var statusBadge = Model.Rental.StatusName?.ToUpper() switch
                            {
                                "RESERVED" => "bg-info",
                                "ACTIVE" => "bg-primary",
                                "COMPLETED" => "badge-active",
                                "CANCELLED" => "badge-inactive",
                                _ => "bg-secondary"
                            };
                        }
                        <span class="badge @statusBadge">@Model.Rental.StatusName</span>
                    </dd>

                    <dt class="col-sm-4">Total Amount</dt>
                    <dd class="col-sm-8">@Model.Rental.TotalAmount.ToString("C")</dd>

                    <dt class="col-sm-4">Paid Amount</dt>
                    <dd class="col-sm-8">@Model.Rental.PaidAmount.ToString("C")</dd>
                </dl>
            </div>
        </div>

        <div class="alert alert-warning">
            <i class="fas fa-info-circle me-2"></i>
            This action will soft-delete the rental. The record will be marked as deleted but can be recovered if needed.
        </div>

        <form method="post">
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">
                    <i class="fas fa-trash me-2"></i>Delete Rental
                </button>
                <a asp-page="Index" class="btn btn-secondary">
                    <i class="fas fa-times me-2"></i>Cancel
                </a>
            </div>
        </form>
    </div>
</div>
