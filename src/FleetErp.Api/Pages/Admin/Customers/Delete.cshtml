@page "{id:int}"
@model FleetErp.Api.Pages.Admin.Customers.DeleteModel
@{
    ViewData["Title"] = $"Delete Customer - {Model.Customer.FullName}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">
        <i class="fas fa-trash me-2 text-danger"></i>Delete Customer
    </h1>
    <a asp-page="Index" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-2"></i>Back to List
    </a>
</div>

<div class="card border-danger">
    <div class="card-header bg-danger text-white">
        <h5 class="mb-0"><i class="fas fa-exclamation-triangle me-2"></i>Confirm Deletion</h5>
    </div>
    <div class="card-body">
        <p class="lead">Are you sure you want to delete this customer?</p>

        <div class="row mb-4">
            <div class="col-md-6">
                <dl class="row">
                    <dt class="col-sm-4">Full Name</dt>
                    <dd class="col-sm-8 fs-5">@Model.Customer.FullName</dd>

                    <dt class="col-sm-4">Phone</dt>
                    <dd class="col-sm-8">@(Model.Customer.Phone ?? "N/A")</dd>

                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8">@(Model.Customer.Email ?? "N/A")</dd>

                    <dt class="col-sm-4">National ID</dt>
                    <dd class="col-sm-8"><code>@(Model.Customer.NationalId ?? "N/A")</code></dd>

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">
                        @{
                            var badgeClass = Model.Customer.StatusName?.ToUpper() switch
                            {
                                "ACTIVE" => "badge-active",
                                "SUSPENDED" => "bg-warning text-dark",
                                "BLACKLISTED" => "bg-danger",
                                _ => "bg-secondary"
                            };
                        }
                        <span class="badge @badgeClass">@Model.Customer.StatusName</span>
                    </dd>
                </dl>
            </div>
        </div>

        <div class="alert alert-warning">
            <i class="fas fa-info-circle me-2"></i>
            This action will soft-delete the customer. The record will be marked as deleted but can be recovered if needed.
        </div>

        <form method="post">
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">
                    <i class="fas fa-trash me-2"></i>Delete Customer
                </button>
                <a asp-page="Index" class="btn btn-secondary">
                    <i class="fas fa-times me-2"></i>Cancel
                </a>
            </div>
        </form>
    </div>
</div>
