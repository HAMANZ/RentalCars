@page
@model FleetErp.Api.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">
        <i class="fas fa-tachometer-alt me-2"></i>Dashboard
    </h1>
    @if (Model.UnreadNotifications > 0)
    {
        <a asp-page="/Admin/Notifications/Index" class="btn btn-outline-primary position-relative">
            <i class="fas fa-bell me-2"></i>Notifications
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                @Model.UnreadNotifications
            </span>
        </a>
    }
</div>

<!-- Main Stats Cards -->
<div class="row g-4 mb-4">
    <div class="col-md-6 col-xl-3">
        <div class="card dashboard-card bg-primary text-white">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="card-value">@Model.TotalVehicles</div>
                    <div class="card-label">Total Vehicles</div>
                </div>
                <div class="card-icon">
                    <i class="fas fa-car"></i>
                </div>
            </div>
            <a asp-page="/Admin/Vehicles/Index" class="card-footer bg-transparent text-white border-0 text-decoration-none">
                View all <i class="fas fa-arrow-right ms-1"></i>
            </a>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card dashboard-card bg-success text-white">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="card-value">@Model.AvailableVehicles</div>
                    <div class="card-label">Available Vehicles</div>
                </div>
                <div class="card-icon">
                    <i class="fas fa-check-circle"></i>
                </div>
            </div>
            <a asp-page="/Admin/Vehicles/Index" class="card-footer bg-transparent text-white border-0 text-decoration-none">
                View all <i class="fas fa-arrow-right ms-1"></i>
            </a>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card dashboard-card bg-info text-white">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="card-value">@Model.ActiveRentals</div>
                    <div class="card-label">Active Rentals</div>
                </div>
                <div class="card-icon">
                    <i class="fas fa-key"></i>
                </div>
            </div>
            <a asp-page="/Admin/Rentals/Index" class="card-footer bg-transparent text-white border-0 text-decoration-none">
                View all <i class="fas fa-arrow-right ms-1"></i>
            </a>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card dashboard-card bg-secondary text-white">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="card-value">@Model.TotalCustomers</div>
                    <div class="card-label">Total Customers</div>
                </div>
                <div class="card-icon">
                    <i class="fas fa-users"></i>
                </div>
            </div>
            <a asp-page="/Admin/Customers/Index" class="card-footer bg-transparent text-white border-0 text-decoration-none">
                View all <i class="fas fa-arrow-right ms-1"></i>
            </a>
        </div>
    </div>
</div>

<!-- Alert Stats Cards -->
<div class="row g-4 mb-4">
    <div class="col-md-6 col-xl-3">
        <div class="card dashboard-card @(Model.MaintenanceDue > 0 ? "bg-warning text-dark" : "bg-light")">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="card-value">@Model.MaintenanceDue</div>
                    <div class="card-label">Maintenance Due</div>
                </div>
                <div class="card-icon">
                    <i class="fas fa-wrench"></i>
                </div>
            </div>
            <a asp-page="/Admin/Maintenance/Index" class="card-footer bg-transparent @(Model.MaintenanceDue > 0 ? "text-dark" : "text-muted") border-0 text-decoration-none">
                View all <i class="fas fa-arrow-right ms-1"></i>
            </a>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card dashboard-card @(Model.InsuranceExpiringSoon > 0 ? "bg-danger text-white" : "bg-light")">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="card-value">@Model.InsuranceExpiringSoon</div>
                    <div class="card-label">Insurance Expiring</div>
                </div>
                <div class="card-icon">
                    <i class="fas fa-shield-alt"></i>
                </div>
            </div>
            <a asp-page="/Admin/Insurance/Index" class="card-footer bg-transparent @(Model.InsuranceExpiringSoon > 0 ? "text-white" : "text-muted") border-0 text-decoration-none">
                View all <i class="fas fa-arrow-right ms-1"></i>
            </a>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card dashboard-card bg-light">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="card-value">@Model.TotalInvestors</div>
                    <div class="card-label">Total Investors</div>
                </div>
                <div class="card-icon text-primary">
                    <i class="fas fa-user-tie"></i>
                </div>
            </div>
            <a asp-page="/Admin/Investors/Index" class="card-footer bg-transparent text-muted border-0 text-decoration-none">
                View all <i class="fas fa-arrow-right ms-1"></i>
            </a>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card dashboard-card bg-light">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="card-value">@Model.TotalUsers</div>
                    <div class="card-label">System Users</div>
                </div>
                <div class="card-icon text-success">
                    <i class="fas fa-user-shield"></i>
                </div>
            </div>
            <a asp-page="/Admin/Users/Index" class="card-footer bg-transparent text-muted border-0 text-decoration-none">
                View all <i class="fas fa-arrow-right ms-1"></i>
            </a>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Recent Notifications -->
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <i class="fas fa-bell me-2"></i>Recent Notifications
                </div>
                @if (Model.UnreadNotifications > 0)
                {
                    <span class="badge bg-danger">@Model.UnreadNotifications unread</span>
                }
            </div>
            <div class="card-body">
                @if (Model.RecentNotifications.Count == 0)
                {
                    <p class="text-muted mb-0"><i class="fas fa-check-circle me-2 text-success"></i>No pending notifications</p>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var notification in Model.RecentNotifications)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-start px-0">
                                <div>
                                    <div class="fw-bold">@notification.Title</div>
                                    <small class="text-muted">@notification.Message</small>
                                </div>
                                <small class="text-muted">@notification.CreatedAt.ToString("MMM dd")</small>
                            </div>
                        }
                    </div>
                }
            </div>
            @if (Model.RecentNotifications.Count > 0)
            {
                <div class="card-footer">
                    <a asp-page="/Admin/Notifications/Index" class="text-decoration-none">
                        View all notifications <i class="fas fa-arrow-right ms-1"></i>
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header">
                <i class="fas fa-bolt me-2"></i>Quick Actions
            </div>
            <div class="card-body">
                <div class="row g-2">
                    <div class="col-6">
                        <a asp-page="/Admin/Rentals/Create" class="btn btn-outline-primary w-100">
                            <i class="fas fa-plus me-2"></i>New Rental
                        </a>
                    </div>
                    <div class="col-6">
                        <a asp-page="/Admin/Customers/Create" class="btn btn-outline-success w-100">
                            <i class="fas fa-user-plus me-2"></i>New Customer
                        </a>
                    </div>
                    <div class="col-6">
                        <a asp-page="/Admin/Vehicles/Create" class="btn btn-outline-info w-100">
                            <i class="fas fa-car me-2"></i>Add Vehicle
                        </a>
                    </div>
                    <div class="col-6">
                        <a asp-page="/Admin/Maintenance/Create" class="btn btn-outline-warning w-100">
                            <i class="fas fa-wrench me-2"></i>Schedule Maintenance
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- System Information -->
        <div class="card mt-4">
            <div class="card-header">
                <i class="fas fa-info-circle me-2"></i>System Information
            </div>
            <div class="card-body">
                <table class="table table-borderless table-sm mb-0">
                    <tbody>
                        <tr>
                            <td class="text-muted">Application</td>
                            <td class="text-end fw-bold">FleetERP v1.0</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Environment</td>
                            <td class="text-end">@(Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT") ?? "Production")</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Server Time</td>
                            <td class="text-end">@DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        </tr>
                        <tr>
                            <td class="text-muted">.NET Version</td>
                            <td class="text-end">@System.Runtime.InteropServices.RuntimeInformation.FrameworkDescription</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
