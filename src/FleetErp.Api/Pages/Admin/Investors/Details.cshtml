@page "{id:int}"
@model FleetErp.Api.Pages.Admin.Investors.DetailsModel
@{
    ViewData["Title"] = "Investor Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">
        <i class="fas fa-user-tie me-2"></i>Investor Details
    </h1>
    <div>
        <a asp-page="Edit" asp-route-id="@Model.Investor?.Id" class="btn btn-primary">
            <i class="fas fa-edit me-2"></i>Edit
        </a>
        <a asp-page="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i>Back to List
        </a>
    </div>
</div>

@if (Model.Investor != null)
{
    <div class="row">
        <div class="col-lg-6">
            <div class="card mb-4">
                <div class="card-header">
                    <i class="fas fa-info-circle me-2"></i>Basic Information
                </div>
                <div class="card-body">
                    <table class="table table-borderless">
                        <tbody>
                            <tr>
                                <th style="width: 40%;">ID</th>
                                <td>@Model.Investor.Id</td>
                            </tr>
                            <tr>
                                <th>Full Name</th>
                                <td>@Model.Investor.FullName</td>
                            </tr>
                            <tr>
                                <th>Phone</th>
                                <td>@(Model.Investor.Phone ?? "-")</td>
                            </tr>
                            <tr>
                                <th>Email</th>
                                <td>@(Model.Investor.Email ?? "-")</td>
                            </tr>
                            <tr>
                                <th>National ID</th>
                                <td>@(Model.Investor.NationalId ?? "-")</td>
                            </tr>
                            <tr>
                                <th>Status</th>
                                <td>
                                    @{
                                        var badgeClass = Model.Investor.StatusName?.ToUpper() switch
                                        {
                                            "ACTIVE" => "badge-active",
                                            "INACTIVE" => "badge-inactive",
                                            "SUSPENDED" => "badge-suspended",
                                            "PENDING APPROVAL" => "badge-pending",
                                            _ => "bg-secondary"
                                        };
                                    }
                                    <span class="badge @badgeClass">@Model.Investor.StatusName</span>
                                </td>
                            </tr>
                            <tr>
                                <th>Created At</th>
                                <td>@Model.Investor.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span><i class="fas fa-file-alt me-2"></i>Documents (@Model.Documents.Count)</span>
                    <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addDocumentModal">
                        <i class="fas fa-plus"></i>
                    </button>
                </div>
                <div class="card-body">
                    @if (Model.Documents.Count > 0)
                    {
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Type</th>
                                    <th>Expires</th>
                                    <th>Status</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var doc in Model.Documents)
                                {
                                    <tr>
                                        <td>@doc.DocumentTypeName</td>
                                        <td>@(doc.ExpiresAt?.ToString("yyyy-MM-dd") ?? "N/A")</td>
                                        <td>
                                            @if (doc.IsExpired)
                                            {
                                                <span class="badge bg-danger">Expired</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">Valid</span>
                                            }
                                        </td>
                                        <td>
                                            <form method="post" asp-page-handler="DeleteDocument" asp-route-documentId="@doc.Id" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this document?')">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No documents uploaded yet.</p>
                    }
                </div>
            </div>
        </div>
    </div>
}

<!-- Add Document Modal -->
<div class="modal fade" id="addDocumentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="AddDocument">
                <div class="modal-header">
                    <h5 class="modal-title">Add Document</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label asp-for="NewDocument.DocumentTypeId" class="form-label">Document Type</label>
                        <select asp-for="NewDocument.DocumentTypeId" asp-items="Model.DocumentTypeOptions" class="form-select">
                            <option value="">-- Select Type --</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewDocument.FilePath" class="form-label">File Path</label>
                        <input asp-for="NewDocument.FilePath" class="form-control" placeholder="/documents/investor/file.pdf" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewDocument.ExpiresAt" class="form-label">Expires At</label>
                        <input asp-for="NewDocument.ExpiresAt" type="date" class="form-control" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Add Document</button>
                </div>
            </form>
        </div>
    </div>
</div>
