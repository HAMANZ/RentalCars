@page
@model FleetErp.Api.Pages.Admin.Investors.IndexModel
@{
    ViewData["Title"] = "Investors";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">
        <i class="fas fa-user-tie me-2"></i>Investors
    </h1>
    <a asp-page="Create" class="btn btn-primary">
        <i class="fas fa-plus me-2"></i>Add Investor
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="card-body">
        <table id="investorsTable" class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Full Name</th>
                    <th>Phone</th>
                    <th>Email</th>
                    <th>Status</th>
                    <th>Documents</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var investor in Model.Investors)
                {
                    <tr>
                        <td>@investor.Id</td>
                        <td>@investor.FullName</td>
                        <td>@(investor.Phone ?? "-")</td>
                        <td>@(investor.Email ?? "-")</td>
                        <td>
                            @{
                                var badgeClass = investor.StatusName?.ToUpper() switch
                                {
                                    "ACTIVE" => "badge-active",
                                    "INACTIVE" => "badge-inactive",
                                    "SUSPENDED" => "badge-suspended",
                                    "PENDING APPROVAL" => "badge-pending",
                                    _ => "bg-secondary"
                                };
                            }
                            <span class="badge @badgeClass">@investor.StatusName</span>
                        </td>
                        <td>@investor.DocumentCount</td>
                        <td>
                            <div class="btn-group btn-group-sm">
                                <a asp-page="Details" asp-route-id="@investor.Id" class="btn btn-outline-info" title="View">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a asp-page="Edit" asp-route-id="@investor.Id" class="btn btn-outline-primary" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a asp-page="Delete" asp-route-id="@investor.Id" class="btn btn-outline-danger" title="Delete">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#investorsTable').DataTable({
                pageLength: 20,
                order: [[0, 'desc']],
                language: {
                    search: "Search:",
                    lengthMenu: "Show _MENU_ entries",
                    info: "Showing _START_ to _END_ of _TOTAL_ investors",
                    paginate: {
                        first: "First",
                        last: "Last",
                        next: "Next",
                        previous: "Previous"
                    }
                }
            });
        });
    </script>
}
