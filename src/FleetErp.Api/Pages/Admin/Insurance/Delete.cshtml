@page "{id:int}"
@model FleetErp.Api.Pages.Admin.Insurance.DeleteModel
@{
    ViewData["Title"] = $"Delete Insurance Policy - #{Model.Record.Id}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">
        <i class="fas fa-trash-alt me-2 text-danger"></i>Delete Insurance Policy
    </h1>
    <a asp-page="Index" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-2"></i>Back to List
    </a>
</div>

<div class="alert alert-danger" role="alert">
    <i class="fas fa-exclamation-triangle me-2"></i>
    <strong>Warning:</strong> You are about to delete this insurance policy. This action cannot be undone.
</div>

<div class="card">
    <div class="card-header">
        <h5 class="mb-0"><i class="fas fa-shield-alt me-2"></i>Policy Details</h5>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label text-muted">Policy Number</label>
                <div class="fw-bold fs-5"><code>@Model.Record.PolicyNumber</code></div>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label text-muted">Status</label>
                <div>
                    @{
                        var statusBadge = Model.Record.StatusName?.ToUpper() switch
                        {
                            "ACTIVE" => "badge-active",
                            "PENDING" => "bg-warning text-dark",
                            "EXPIRED" => "bg-danger",
                            "CANCELLED" => "badge-inactive",
                            _ => "bg-secondary"
                        };
                    }
                    <span class="badge @statusBadge">@Model.Record.StatusName</span>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label text-muted">Vehicle</label>
                <div class="fw-bold">@Model.Record.VehiclePlateNumber - @Model.Record.VehicleDescription</div>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label text-muted">Insurance Company</label>
                <div class="fw-bold">@Model.Record.InsuranceCompanyName</div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label text-muted">Insurance Type</label>
                <div>@Model.Record.InsuranceTypeName</div>
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label text-muted">Coverage Period</label>
                <div>@Model.Record.StartDate.ToString("MMM dd, yyyy") - @Model.Record.EndDate.ToString("MMM dd, yyyy")</div>
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label text-muted">Premium</label>
                <div class="fw-bold text-primary">@Model.Record.Premium.ToString("C")</div>
            </div>
        </div>
    </div>
</div>

<div class="mt-4">
    <form method="post">
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">
                <i class="fas fa-trash-alt me-2"></i>Confirm Delete
            </button>
            <a asp-page="Index" class="btn btn-secondary">
                <i class="fas fa-times me-2"></i>Cancel
            </a>
        </div>
    </form>
</div>
