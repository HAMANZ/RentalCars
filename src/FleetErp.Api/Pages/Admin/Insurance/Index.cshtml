@page
@model FleetErp.Api.Pages.Admin.Insurance.IndexModel
@{
    ViewData["Title"] = "Insurance Records";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">
        <i class="fas fa-shield-alt me-2"></i>Insurance Records
    </h1>
    <div>
        <a asp-page="Companies/Index" class="btn btn-outline-secondary me-2">
            <i class="fas fa-building me-2"></i>Manage Companies
        </a>
        <a asp-page="Create" class="btn btn-primary">
            <i class="fas fa-plus me-2"></i>New Policy
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="card-body">
        <table id="insuranceTable" class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Vehicle</th>
                    <th>Company</th>
                    <th>Type</th>
                    <th>Policy #</th>
                    <th>Period</th>
                    <th>Premium</th>
                    <th>Status</th>
                    <th>Expiry</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var record in Model.Records)
                {
                    <tr>
                        <td><code>#@record.Id</code></td>
                        <td>
                            <strong>@record.VehiclePlateNumber</strong><br />
                            <small class="text-muted">@record.VehicleDescription</small>
                        </td>
                        <td>@record.InsuranceCompanyName</td>
                        <td>@record.InsuranceTypeName</td>
                        <td><code>@record.PolicyNumber</code></td>
                        <td>
                            @record.StartDate.ToString("MMM dd, yyyy")<br />
                            <small class="text-muted">to @record.EndDate.ToString("MMM dd, yyyy")</small>
                        </td>
                        <td>@record.Premium.ToString("C")</td>
                        <td>
                            @{
                                var statusBadge = record.StatusName?.ToUpper() switch
                                {
                                    "ACTIVE" => "badge-active",
                                    "PENDING" => "bg-warning text-dark",
                                    "EXPIRED" => "bg-danger",
                                    "CANCELLED" => "badge-inactive",
                                    _ => "bg-secondary"
                                };
                            }
                            <span class="badge @statusBadge">@record.StatusName</span>
                        </td>
                        <td>
                            @{
                                var daysClass = record.DaysUntilExpiry switch
                                {
                                    < 0 => "text-danger fw-bold",
                                    < 30 => "text-warning fw-bold",
                                    _ => "text-muted"
                                };
                                var daysText = record.DaysUntilExpiry switch
                                {
                                    < 0 => $"Expired {Math.Abs(record.DaysUntilExpiry)} days ago",
                                    0 => "Expires today",
                                    1 => "Expires tomorrow",
                                    _ => $"{record.DaysUntilExpiry} days"
                                };
                            }
                            <span class="@daysClass">@daysText</span>
                        </td>
                        <td>
                            <div class="btn-group btn-group-sm">
                                <a asp-page="Details" asp-route-id="@record.Id" class="btn btn-outline-info" title="View">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a asp-page="Edit" asp-route-id="@record.Id" class="btn btn-outline-primary" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a asp-page="Delete" asp-route-id="@record.Id" class="btn btn-outline-danger" title="Delete">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#insuranceTable').DataTable({
                pageLength: 20,
                order: [[8, 'asc']],
                language: {
                    search: "Search:",
                    lengthMenu: "Show _MENU_ entries",
                    info: "Showing _START_ to _END_ of _TOTAL_ policies",
                    paginate: {
                        first: "First",
                        last: "Last",
                        next: "Next",
                        previous: "Previous"
                    }
                }
            });
        });
    </script>
}
