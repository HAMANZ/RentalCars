@page
@model FleetErp.Api.Pages.Admin.Insurance.Companies.IndexModel
@{
    ViewData["Title"] = "Insurance Companies";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">
        <i class="fas fa-building me-2"></i>Insurance Companies
    </h1>
    <div>
        <a asp-page="Create" class="btn btn-primary">
            <i class="fas fa-plus me-2"></i>Add Company
        </a>
        <a asp-page="../Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i>Back to Insurance
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="card-body">
        <table id="companiesTable" class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Phone</th>
                    <th>Email</th>
                    <th>Contact Person</th>
                    <th>Status</th>
                    <th style="width: 150px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var company in Model.Companies)
                {
                    <tr>
                        <td class="fw-bold">@company.Name</td>
                        <td>@(company.Phone ?? "-")</td>
                        <td>
                            @if (!string.IsNullOrEmpty(company.Email))
                            {
                                <a href="mailto:@company.Email">@company.Email</a>
                            }
                            else
                            {
                                <text>-</text>
                            }
                        </td>
                        <td>@(company.ContactPerson ?? "-")</td>
                        <td>
                            @if (company.IsActive)
                            {
                                <span class="badge badge-active">Active</span>
                            }
                            else
                            {
                                <span class="badge badge-inactive">Inactive</span>
                            }
                        </td>
                        <td>
                            <a asp-page="Edit" asp-route-id="@company.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a asp-page="Delete" asp-route-id="@company.Id" class="btn btn-sm btn-outline-danger" title="Delete">
                                <i class="fas fa-trash-alt"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#companiesTable').DataTable({
                order: [[0, 'asc']],
                pageLength: 25
            });
        });
    </script>
}
