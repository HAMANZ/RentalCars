@page "{id:int}"
@model FleetErp.Api.Pages.Admin.Insurance.Companies.DeleteModel
@{
    ViewData["Title"] = $"Delete Insurance Company - {Model.Company.Name}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">
        <i class="fas fa-trash-alt me-2 text-danger"></i>Delete Insurance Company
    </h1>
    <a asp-page="Index" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-2"></i>Back to List
    </a>
</div>

<div class="alert alert-danger" role="alert">
    <i class="fas fa-exclamation-triangle me-2"></i>
    <strong>Warning:</strong> You are about to delete this insurance company. This action cannot be undone.
    Any insurance policies associated with this company may be affected.
</div>

<div class="card">
    <div class="card-header">
        <h5 class="mb-0"><i class="fas fa-building me-2"></i>Company Details</h5>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label text-muted">Company Name</label>
                <div class="fw-bold fs-5">@Model.Company.Name</div>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label text-muted">Status</label>
                <div>
                    @if (Model.Company.IsActive)
                    {
                        <span class="badge badge-active">Active</span>
                    }
                    else
                    {
                        <span class="badge badge-inactive">Inactive</span>
                    }
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label text-muted">Phone</label>
                <div>@(Model.Company.Phone ?? "-")</div>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label text-muted">Email</label>
                <div>@(Model.Company.Email ?? "-")</div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label text-muted">Contact Person</label>
                <div>@(Model.Company.ContactPerson ?? "-")</div>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label text-muted">Address</label>
                <div>@(Model.Company.Address ?? "-")</div>
            </div>
        </div>
    </div>
</div>

<div class="mt-4">
    <form method="post">
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">
                <i class="fas fa-trash-alt me-2"></i>Confirm Delete
            </button>
            <a asp-page="Index" class="btn btn-secondary">
                <i class="fas fa-times me-2"></i>Cancel
            </a>
        </div>
    </form>
</div>
