@page "{id:int}"
@model FleetErp.Api.Pages.Admin.Insurance.DetailsModel
@{
    ViewData["Title"] = $"Insurance Details - #{Model.Record.Id}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">
        <i class="fas fa-shield-alt me-2"></i>Insurance: <code>@Model.Record.PolicyNumber</code>
    </h1>
    <div>
        @if (Model.Record.StatusName?.ToUpper() == "ACTIVE" || Model.Record.StatusName?.ToUpper() == "EXPIRED")
        {
            <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#renewModal">
                <i class="fas fa-sync me-2"></i>Renew
            </button>
        }
        @if (Model.Record.StatusName?.ToUpper() != "CANCELLED" && Model.Record.StatusName?.ToUpper() != "EXPIRED")
        {
            <form method="post" asp-page-handler="Cancel" class="d-inline">
                <button type="submit" class="btn btn-warning" onclick="return confirm('Are you sure you want to cancel this insurance policy?');">
                    <i class="fas fa-ban me-2"></i>Cancel
                </button>
            </form>
        }
        <a asp-page="Edit" asp-route-id="@Model.Record.Id" class="btn btn-primary">
            <i class="fas fa-edit me-2"></i>Edit
        </a>
        <a asp-page="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i>Back to List
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <div class="col-lg-8">
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between">
                <h5 class="mb-0"><i class="fas fa-info-circle me-2"></i>Policy Information</h5>
                <div>
                    @{
                        var statusBadge = Model.Record.StatusName?.ToUpper() switch
                        {
                            "ACTIVE" => "badge-active",
                            "PENDING" => "bg-warning text-dark",
                            "EXPIRED" => "bg-danger",
                            "CANCELLED" => "badge-inactive",
                            _ => "bg-secondary"
                        };
                    }
                    <span class="badge @statusBadge fs-6">@Model.Record.StatusName</span>
                </div>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label text-muted">Vehicle</label>
                        <div>
                            <strong class="fs-5">@Model.Record.VehiclePlateNumber</strong><br />
                            <span class="text-muted">@Model.Record.VehicleDescription</span>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label text-muted">Insurance Company</label>
                        <div class="fw-bold fs-5">@Model.Record.InsuranceCompanyName</div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label text-muted">Insurance Type</label>
                        <div class="fw-bold">@Model.Record.InsuranceTypeName</div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label text-muted">Policy Number</label>
                        <div class="fw-bold"><code>@Model.Record.PolicyNumber</code></div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label text-muted">Premium</label>
                        <div class="fw-bold fs-4 text-primary">@Model.Record.Premium.ToString("C")</div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label text-muted">Start Date</label>
                        <div class="fw-bold">@Model.Record.StartDate.ToString("MMM dd, yyyy")</div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label text-muted">End Date</label>
                        <div class="fw-bold">@Model.Record.EndDate.ToString("MMM dd, yyyy")</div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label text-muted">Days Until Expiry</label>
                        @{
                            var daysUntilExpiry = (Model.Record.EndDate.Date - DateTime.UtcNow.Date).Days;
                            var daysClass = daysUntilExpiry switch
                            {
                                < 0 => "text-danger",
                                < 30 => "text-warning",
                                _ => "text-success"
                            };
                        }
                        <div class="fw-bold @daysClass">
                            @if (daysUntilExpiry < 0)
                            {
                                <text>Expired @Math.Abs(daysUntilExpiry) days ago</text>
                            }
                            else if (daysUntilExpiry == 0)
                            {
                                <text>Expires today</text>
                            }
                            else
                            {
                                <text>@daysUntilExpiry days</text>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0"><i class="fas fa-dollar-sign me-2"></i>Coverage Details</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label text-muted">Coverage Amount</label>
                        <div class="fw-bold">@(Model.Record.CoverageAmount?.ToString("C") ?? "Not specified")</div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label text-muted">Deductible</label>
                        <div class="fw-bold">@(Model.Record.Deductible?.ToString("C") ?? "Not specified")</div>
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Record.CoverageDetails))
                {
                    <div class="row">
                        <div class="col-12">
                            <label class="form-label text-muted">Coverage Details</label>
                            <div class="border rounded p-3 bg-light">@Model.Record.CoverageDetails</div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Record.Notes))
        {
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-sticky-note me-2"></i>Notes</h5>
                </div>
                <div class="card-body">
                    <div class="border rounded p-3 bg-light">@Model.Record.Notes</div>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-4">
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0"><i class="fas fa-paperclip me-2"></i>Documents</h5>
            </div>
            <div class="card-body">
                @if (Model.Record.DocumentCount == 0)
                {
                    <p class="text-muted mb-0">No documents attached.</p>
                }
                else
                {
                    <p>@Model.Record.DocumentCount document(s) attached.</p>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="fas fa-clock me-2"></i>Audit Info</h5>
            </div>
            <div class="card-body">
                <div class="mb-2">
                    <label class="form-label text-muted mb-0">Created</label>
                    <div class="small">@Model.Record.CreatedAt.ToString("MMM dd, yyyy HH:mm")</div>
                </div>
                @if (Model.Record.UpdatedAt.HasValue)
                {
                    <div class="mb-2">
                        <label class="form-label text-muted mb-0">Last Updated</label>
                        <div class="small">@Model.Record.UpdatedAt.Value.ToString("MMM dd, yyyy HH:mm")</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Renew Insurance Modal -->
<div class="modal fade" id="renewModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Renew">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-sync me-2"></i>Renew Insurance Policy</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label asp-for="RenewInput.NewStartDate" class="form-label">New Start Date <span class="text-danger">*</span></label>
                        <input asp-for="RenewInput.NewStartDate" class="form-control" type="date" />
                        <span asp-validation-for="RenewInput.NewStartDate" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="RenewInput.NewEndDate" class="form-label">New End Date <span class="text-danger">*</span></label>
                        <input asp-for="RenewInput.NewEndDate" class="form-control" type="date" />
                        <span asp-validation-for="RenewInput.NewEndDate" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="RenewInput.NewPremium" class="form-label">New Premium <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="RenewInput.NewPremium" class="form-control" type="number" step="0.01" min="0" />
                        </div>
                        <span asp-validation-for="RenewInput.NewPremium" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="RenewInput.NewCoverageAmount" class="form-label">New Coverage Amount</label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="RenewInput.NewCoverageAmount" class="form-control" type="number" step="0.01" min="0" />
                        </div>
                        <span asp-validation-for="RenewInput.NewCoverageAmount" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="RenewInput.Notes" class="form-label">Renewal Notes</label>
                        <textarea asp-for="RenewInput.Notes" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="RenewInput.Notes" class="text-danger"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Renew Policy</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
