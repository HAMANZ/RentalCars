@page "{id:int}"
@model FleetErp.Api.Pages.Admin.Vehicles.EditModel
@{
    ViewData["Title"] = $"Edit Vehicle - {Model.PlateNumber}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">
        <i class="fas fa-edit me-2"></i>Edit Vehicle: <code>@Model.PlateNumber</code>
    </h1>
    <a asp-page="Index" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-2"></i>Back to List
    </a>
</div>

<div class="card">
    <div class="card-body">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <h5 class="mb-3">Basic Information</h5>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="Input.PlateNumber" class="form-label">Plate Number <span class="text-danger">*</span></label>
                    <input asp-for="Input.PlateNumber" class="form-control text-uppercase" />
                    <span asp-validation-for="Input.PlateNumber" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Input.Make" class="form-label">Make <span class="text-danger">*</span></label>
                    <input asp-for="Input.Make" class="form-control" />
                    <span asp-validation-for="Input.Make" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Input.Model" class="form-label">Model <span class="text-danger">*</span></label>
                    <input asp-for="Input.Model" class="form-control" />
                    <span asp-validation-for="Input.Model" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-3 mb-3">
                    <label asp-for="Input.Year" class="form-label">Year <span class="text-danger">*</span></label>
                    <input asp-for="Input.Year" class="form-control" type="number" min="1900" max="2100" />
                    <span asp-validation-for="Input.Year" class="text-danger"></span>
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="Input.Color" class="form-label">Color</label>
                    <input asp-for="Input.Color" class="form-control" />
                    <span asp-validation-for="Input.Color" class="text-danger"></span>
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="Input.VehicleTypeId" class="form-label">Vehicle Type <span class="text-danger">*</span></label>
                    <select asp-for="Input.VehicleTypeId" asp-items="Model.VehicleTypeOptions" class="form-select">
                        <option value="">-- Select Type --</option>
                    </select>
                    <span asp-validation-for="Input.VehicleTypeId" class="text-danger"></span>
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="Input.StatusId" class="form-label">Status <span class="text-danger">*</span></label>
                    <select asp-for="Input.StatusId" asp-items="Model.StatusOptions" class="form-select">
                        <option value="">-- Select Status --</option>
                    </select>
                    <span asp-validation-for="Input.StatusId" class="text-danger"></span>
                </div>
            </div>

            <hr />
            <h5 class="mb-3">Technical Details</h5>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="Input.Vin" class="form-label">VIN</label>
                    <input asp-for="Input.Vin" class="form-control text-uppercase" />
                    <span asp-validation-for="Input.Vin" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Input.EngineNumber" class="form-label">Engine Number</label>
                    <input asp-for="Input.EngineNumber" class="form-control" />
                    <span asp-validation-for="Input.EngineNumber" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Input.ChassisNumber" class="form-label">Chassis Number</label>
                    <input asp-for="Input.ChassisNumber" class="form-control" />
                    <span asp-validation-for="Input.ChassisNumber" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="Input.FuelTypeId" class="form-label">Fuel Type <span class="text-danger">*</span></label>
                    <select asp-for="Input.FuelTypeId" asp-items="Model.FuelTypeOptions" class="form-select">
                        <option value="">-- Select Fuel --</option>
                    </select>
                    <span asp-validation-for="Input.FuelTypeId" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Input.TransmissionTypeId" class="form-label">Transmission <span class="text-danger">*</span></label>
                    <select asp-for="Input.TransmissionTypeId" asp-items="Model.TransmissionTypeOptions" class="form-select">
                        <option value="">-- Select Transmission --</option>
                    </select>
                    <span asp-validation-for="Input.TransmissionTypeId" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Input.Odometer" class="form-label">Odometer (km)</label>
                    <input asp-for="Input.Odometer" class="form-control" type="number" min="0" />
                    <span asp-validation-for="Input.Odometer" class="text-danger"></span>
                </div>
            </div>

            <hr />
            <h5 class="mb-3">Ownership & Pricing</h5>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="Input.InvestorId" class="form-label">Owner (Investor) <span class="text-danger">*</span></label>
                    <select asp-for="Input.InvestorId" asp-items="Model.InvestorOptions" class="form-select">
                        <option value="">-- Select Owner --</option>
                    </select>
                    <span asp-validation-for="Input.InvestorId" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Input.DailyRate" class="form-label">Daily Rate <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="Input.DailyRate" class="form-control" type="number" step="0.01" min="0" />
                    </div>
                    <span asp-validation-for="Input.DailyRate" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Input.PurchasePrice" class="form-label">Purchase Price</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="Input.PurchasePrice" class="form-control" type="number" step="0.01" min="0" />
                    </div>
                    <span asp-validation-for="Input.PurchasePrice" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="Input.PurchaseDate" class="form-label">Purchase Date</label>
                    <input asp-for="Input.PurchaseDate" class="form-control" type="date" />
                    <span asp-validation-for="Input.PurchaseDate" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-12 mb-3">
                    <label asp-for="Input.Notes" class="form-label">Notes</label>
                    <textarea asp-for="Input.Notes" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Input.Notes" class="text-danger"></span>
                </div>
            </div>

            <hr />

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save me-2"></i>Save Changes
                </button>
                <a asp-page="Details" asp-route-id="@Model.VehicleId" class="btn btn-outline-info">
                    <i class="fas fa-eye me-2"></i>View Details
                </a>
                <a asp-page="Index" class="btn btn-secondary">
                    <i class="fas fa-times me-2"></i>Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
