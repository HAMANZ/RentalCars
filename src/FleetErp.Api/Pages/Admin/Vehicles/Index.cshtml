@page
@model FleetErp.Api.Pages.Admin.Vehicles.IndexModel
@{
    ViewData["Title"] = "Vehicles";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">
        <i class="fas fa-car me-2"></i>Vehicles
    </h1>
    <a asp-page="Create" class="btn btn-primary">
        <i class="fas fa-plus me-2"></i>Add Vehicle
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="card-body">
        <table id="vehiclesTable" class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Plate Number</th>
                    <th>Make / Model</th>
                    <th>Year</th>
                    <th>Type</th>
                    <th>Daily Rate</th>
                    <th>Owner</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var vehicle in Model.Vehicles)
                {
                    <tr>
                        <td>@vehicle.Id</td>
                        <td><code>@vehicle.PlateNumber</code></td>
                        <td>@vehicle.Make @vehicle.Model</td>
                        <td>@vehicle.Year</td>
                        <td>@vehicle.VehicleTypeName</td>
                        <td>@vehicle.DailyRate.ToString("C")</td>
                        <td>@vehicle.InvestorName</td>
                        <td>
                            @{
                                var badgeClass = vehicle.StatusName?.ToUpper() switch
                                {
                                    "AVAILABLE" => "badge-active",
                                    "RENTED" => "bg-primary",
                                    "IN MAINTENANCE" => "bg-warning text-dark",
                                    "RESERVED" => "bg-info",
                                    "SOLD" => "badge-inactive",
                                    "INACTIVE" => "badge-inactive",
                                    _ => "bg-secondary"
                                };
                            }
                            <span class="badge @badgeClass">@vehicle.StatusName</span>
                        </td>
                        <td>
                            <div class="btn-group btn-group-sm">
                                <a asp-page="Details" asp-route-id="@vehicle.Id" class="btn btn-outline-info" title="View">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a asp-page="Edit" asp-route-id="@vehicle.Id" class="btn btn-outline-primary" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a asp-page="Delete" asp-route-id="@vehicle.Id" class="btn btn-outline-danger" title="Delete">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#vehiclesTable').DataTable({
                pageLength: 20,
                order: [[0, 'desc']],
                language: {
                    search: "Search:",
                    lengthMenu: "Show _MENU_ entries",
                    info: "Showing _START_ to _END_ of _TOTAL_ vehicles",
                    paginate: {
                        first: "First",
                        last: "Last",
                        next: "Next",
                        previous: "Previous"
                    }
                }
            });
        });
    </script>
}
