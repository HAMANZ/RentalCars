@page "{id:int}"
@model FleetErp.Api.Pages.Admin.Vehicles.DeleteModel
@{
    ViewData["Title"] = $"Delete Vehicle - {Model.Vehicle.PlateNumber}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">
        <i class="fas fa-trash me-2 text-danger"></i>Delete Vehicle
    </h1>
    <a asp-page="Index" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-2"></i>Back to List
    </a>
</div>

<div class="card border-danger">
    <div class="card-header bg-danger text-white">
        <h5 class="mb-0"><i class="fas fa-exclamation-triangle me-2"></i>Confirm Deletion</h5>
    </div>
    <div class="card-body">
        <p class="lead">Are you sure you want to delete this vehicle?</p>

        <div class="row mb-4">
            <div class="col-md-6">
                <dl class="row">
                    <dt class="col-sm-4">Plate Number</dt>
                    <dd class="col-sm-8"><code class="fs-5">@Model.Vehicle.PlateNumber</code></dd>

                    <dt class="col-sm-4">Make / Model</dt>
                    <dd class="col-sm-8">@Model.Vehicle.Make @Model.Vehicle.Model</dd>

                    <dt class="col-sm-4">Year</dt>
                    <dd class="col-sm-8">@Model.Vehicle.Year</dd>

                    <dt class="col-sm-4">Owner</dt>
                    <dd class="col-sm-8">@Model.Vehicle.InvestorName</dd>

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">
                        @{
                            var badgeClass = Model.Vehicle.StatusName?.ToUpper() switch
                            {
                                "AVAILABLE" => "badge-active",
                                "RENTED" => "bg-primary",
                                "IN MAINTENANCE" => "bg-warning text-dark",
                                "RESERVED" => "bg-info",
                                "SOLD" => "badge-inactive",
                                "INACTIVE" => "badge-inactive",
                                _ => "bg-secondary"
                            };
                        }
                        <span class="badge @badgeClass">@Model.Vehicle.StatusName</span>
                    </dd>

                    <dt class="col-sm-4">Daily Rate</dt>
                    <dd class="col-sm-8">@Model.Vehicle.DailyRate.ToString("C")</dd>
                </dl>
            </div>
        </div>

        <div class="alert alert-warning">
            <i class="fas fa-info-circle me-2"></i>
            This action will soft-delete the vehicle. The record will be marked as deleted but can be recovered if needed.
        </div>

        <form method="post">
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">
                    <i class="fas fa-trash me-2"></i>Delete Vehicle
                </button>
                <a asp-page="Index" class="btn btn-secondary">
                    <i class="fas fa-times me-2"></i>Cancel
                </a>
            </div>
        </form>
    </div>
</div>
