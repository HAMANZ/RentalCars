@page
@model FleetErp.Api.Pages.Admin.Maintenance.IndexModel
@{
    ViewData["Title"] = "Maintenance Records";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">
        <i class="fas fa-tools me-2"></i>Maintenance Records
    </h1>
    <a asp-page="Create" class="btn btn-primary">
        <i class="fas fa-plus me-2"></i>New Maintenance
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="card-body">
        <table id="maintenanceTable" class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Vehicle</th>
                    <th>Type</th>
                    <th>Status</th>
                    <th>Cost</th>
                    <th>Scheduled</th>
                    <th>Completed</th>
                    <th>Service Provider</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var record in Model.Records)
                {
                    <tr>
                        <td><code>#@record.Id</code></td>
                        <td>
                            <strong>@record.VehiclePlateNumber</strong><br />
                            <small class="text-muted">@record.VehicleDescription</small>
                        </td>
                        <td>@record.MaintenanceTypeName</td>
                        <td>
                            @{
                                var statusBadge = record.StatusName?.ToUpper() switch
                                {
                                    "SCHEDULED" => "bg-info",
                                    "IN_PROGRESS" => "bg-primary",
                                    "COMPLETED" => "badge-active",
                                    "CANCELLED" => "badge-inactive",
                                    _ => "bg-secondary"
                                };
                            }
                            <span class="badge @statusBadge">@record.StatusName</span>
                        </td>
                        <td>@record.Cost.ToString("C")</td>
                        <td>@record.ScheduledDate.ToString("MMM dd, yyyy")</td>
                        <td>@(record.CompletedDate?.ToString("MMM dd, yyyy") ?? "-")</td>
                        <td>@(record.ServiceProvider ?? "-")</td>
                        <td>
                            <div class="btn-group btn-group-sm">
                                <a asp-page="Details" asp-route-id="@record.Id" class="btn btn-outline-info" title="View">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a asp-page="Edit" asp-route-id="@record.Id" class="btn btn-outline-primary" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a asp-page="Delete" asp-route-id="@record.Id" class="btn btn-outline-danger" title="Delete">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#maintenanceTable').DataTable({
                pageLength: 20,
                order: [[0, 'desc']],
                language: {
                    search: "Search:",
                    lengthMenu: "Show _MENU_ entries",
                    info: "Showing _START_ to _END_ of _TOTAL_ records",
                    paginate: {
                        first: "First",
                        last: "Last",
                        next: "Next",
                        previous: "Previous"
                    }
                }
            });
        });
    </script>
}
