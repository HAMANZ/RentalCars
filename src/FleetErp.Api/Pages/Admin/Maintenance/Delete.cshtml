@page "{id:int}"
@model FleetErp.Api.Pages.Admin.Maintenance.DeleteModel
@{
    ViewData["Title"] = $"Delete Maintenance Record - #{Model.Record.Id}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">
        <i class="fas fa-trash me-2 text-danger"></i>Delete Maintenance Record
    </h1>
    <a asp-page="Index" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-2"></i>Back to List
    </a>
</div>

<div class="card border-danger">
    <div class="card-header bg-danger text-white">
        <h5 class="mb-0"><i class="fas fa-exclamation-triangle me-2"></i>Confirm Deletion</h5>
    </div>
    <div class="card-body">
        <p class="lead">Are you sure you want to delete this maintenance record?</p>

        <div class="row mb-4">
            <div class="col-md-6">
                <dl class="row">
                    <dt class="col-sm-4">Record #</dt>
                    <dd class="col-sm-8"><code class="fs-5">#@Model.Record.Id</code></dd>

                    <dt class="col-sm-4">Vehicle</dt>
                    <dd class="col-sm-8">
                        <strong>@Model.Record.VehiclePlateNumber</strong><br />
                        <small class="text-muted">@Model.Record.VehicleDescription</small>
                    </dd>

                    <dt class="col-sm-4">Type</dt>
                    <dd class="col-sm-8">@Model.Record.MaintenanceTypeName</dd>

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">
                        @{
                            var statusBadge = Model.Record.StatusName?.ToUpper() switch
                            {
                                "SCHEDULED" => "bg-info",
                                "IN_PROGRESS" => "bg-primary",
                                "COMPLETED" => "badge-active",
                                "CANCELLED" => "badge-inactive",
                                _ => "bg-secondary"
                            };
                        }
                        <span class="badge @statusBadge">@Model.Record.StatusName</span>
                    </dd>

                    <dt class="col-sm-4">Scheduled</dt>
                    <dd class="col-sm-8">@Model.Record.ScheduledDate.ToString("MMM dd, yyyy")</dd>

                    <dt class="col-sm-4">Cost</dt>
                    <dd class="col-sm-8">@Model.Record.Cost.ToString("C")</dd>

                    <dt class="col-sm-4">Expense Posted</dt>
                    <dd class="col-sm-8">
                        @if (Model.Record.IsExpensePosted)
                        {
                            <span class="badge bg-success">Yes</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">No</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>

        @if (Model.Record.IsExpensePosted)
        {
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-triangle me-2"></i>
                <strong>Warning:</strong> This maintenance record has posted expenses. It cannot be deleted.
            </div>
        }
        else
        {
            <div class="alert alert-warning">
                <i class="fas fa-info-circle me-2"></i>
                This action will soft-delete the maintenance record. The record will be marked as deleted but can be recovered if needed.
            </div>

            <form method="post">
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash me-2"></i>Delete Record
                    </button>
                    <a asp-page="Index" class="btn btn-secondary">
                        <i class="fas fa-times me-2"></i>Cancel
                    </a>
                </div>
            </form>
        }
    </div>
</div>
