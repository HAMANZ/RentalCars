@page "{id:int}"
@model FleetErp.Api.Pages.Admin.Maintenance.DetailsModel
@{
    ViewData["Title"] = $"Maintenance Details - #{Model.Record.Id}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">
        <i class="fas fa-tools me-2"></i>Maintenance: <code>#@Model.Record.Id</code>
    </h1>
    <div>
        @if (Model.Record.StatusName?.ToUpper() == "SCHEDULED")
        {
            <form method="post" asp-page-handler="Start" class="d-inline">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-play me-2"></i>Start
                </button>
            </form>
        }
        @if (Model.Record.StatusName?.ToUpper() == "IN_PROGRESS" || Model.Record.StatusName?.ToUpper() == "SCHEDULED")
        {
            <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#completeModal">
                <i class="fas fa-check-circle me-2"></i>Complete
            </button>
            <form method="post" asp-page-handler="Cancel" class="d-inline">
                <button type="submit" class="btn btn-warning" onclick="return confirm('Are you sure you want to cancel this maintenance?');">
                    <i class="fas fa-ban me-2"></i>Cancel
                </button>
            </form>
        }
        <a asp-page="Edit" asp-route-id="@Model.Record.Id" class="btn btn-primary">
            <i class="fas fa-edit me-2"></i>Edit
        </a>
        <a asp-page="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i>Back to List
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <div class="col-lg-8">
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between">
                <h5 class="mb-0"><i class="fas fa-info-circle me-2"></i>Maintenance Information</h5>
                <div>
                    @{
                        var statusBadge = Model.Record.StatusName?.ToUpper() switch
                        {
                            "SCHEDULED" => "bg-info",
                            "IN_PROGRESS" => "bg-primary",
                            "COMPLETED" => "badge-active",
                            "CANCELLED" => "badge-inactive",
                            _ => "bg-secondary"
                        };
                    }
                    <span class="badge @statusBadge fs-6">@Model.Record.StatusName</span>
                    @if (Model.Record.IsExpensePosted)
                    {
                        <span class="badge bg-success fs-6 ms-1">Expense Posted</span>
                    }
                </div>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label text-muted">Vehicle</label>
                        <div>
                            <strong class="fs-5">@Model.Record.VehiclePlateNumber</strong><br />
                            <span class="text-muted">@Model.Record.VehicleDescription</span>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label text-muted">Maintenance Type</label>
                        <div class="fw-bold fs-5">@Model.Record.MaintenanceTypeName</div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label text-muted">Scheduled Date</label>
                        <div class="fw-bold">@Model.Record.ScheduledDate.ToString("MMM dd, yyyy")</div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label text-muted">Completed Date</label>
                        <div class="fw-bold">@(Model.Record.CompletedDate?.ToString("MMM dd, yyyy") ?? "Not completed")</div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label text-muted">Odometer at Service</label>
                        <div class="fw-bold">@(Model.Record.OdometerAtService?.ToString("N0") ?? "N/A") km</div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label text-muted">Service Provider</label>
                        <div class="fw-bold">@(Model.Record.ServiceProvider ?? "Not specified")</div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label text-muted">Cost</label>
                        <div class="fw-bold fs-4 text-primary">@Model.Record.Cost.ToString("C")</div>
                    </div>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Record.Description))
        {
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-file-alt me-2"></i>Description</h5>
                </div>
                <div class="card-body">
                    <div class="border rounded p-3 bg-light">@Model.Record.Description</div>
                </div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Record.Notes))
        {
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-sticky-note me-2"></i>Notes</h5>
                </div>
                <div class="card-body">
                    <div class="border rounded p-3 bg-light">@Model.Record.Notes</div>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-4">
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0"><i class="fas fa-paperclip me-2"></i>Documents</h5>
            </div>
            <div class="card-body">
                @if (Model.Record.DocumentCount == 0)
                {
                    <p class="text-muted mb-0">No documents attached.</p>
                }
                else
                {
                    <p>@Model.Record.DocumentCount document(s) attached.</p>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="fas fa-clock me-2"></i>Audit Info</h5>
            </div>
            <div class="card-body">
                <div class="mb-2">
                    <label class="form-label text-muted mb-0">Created</label>
                    <div class="small">@Model.Record.CreatedAt.ToString("MMM dd, yyyy HH:mm")</div>
                </div>
                @if (Model.Record.UpdatedAt.HasValue)
                {
                    <div class="mb-2">
                        <label class="form-label text-muted mb-0">Last Updated</label>
                        <div class="small">@Model.Record.UpdatedAt.Value.ToString("MMM dd, yyyy HH:mm")</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Complete Maintenance Modal -->
<div class="modal fade" id="completeModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Complete">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-check-circle me-2"></i>Complete Maintenance</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label asp-for="CompleteInput.CompletedDate" class="form-label">Completed Date <span class="text-danger">*</span></label>
                        <input asp-for="CompleteInput.CompletedDate" class="form-control" type="date" />
                        <span asp-validation-for="CompleteInput.CompletedDate" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="CompleteInput.FinalCost" class="form-label">Final Cost <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="CompleteInput.FinalCost" class="form-control" type="number" step="0.01" min="0" />
                        </div>
                        <span asp-validation-for="CompleteInput.FinalCost" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="CompleteInput.OdometerAtService" class="form-label">Odometer</label>
                        <div class="input-group">
                            <input asp-for="CompleteInput.OdometerAtService" class="form-control" type="number" min="0" />
                            <span class="input-group-text">km</span>
                        </div>
                        <span asp-validation-for="CompleteInput.OdometerAtService" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="CompleteInput.Notes" class="form-label">Completion Notes</label>
                        <textarea asp-for="CompleteInput.Notes" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="CompleteInput.Notes" class="text-danger"></span>
                    </div>
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>
                        Completing the maintenance will post the expense to the accounting system if the final cost is greater than zero.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Complete Maintenance</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
