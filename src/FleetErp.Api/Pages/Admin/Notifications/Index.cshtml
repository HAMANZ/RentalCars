@page
@model FleetErp.Api.Pages.Admin.Notifications.IndexModel
@{
    ViewData["Title"] = "Notifications";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">
        <i class="fas fa-bell me-2"></i>Notifications
        @if (Model.UnreadCount > 0)
        {
            <span class="badge bg-danger ms-2">@Model.UnreadCount unread</span>
        }
    </h1>
    @if (Model.UnreadCount > 0)
    {
        <form method="post" asp-page-handler="MarkAllAsRead">
            <button type="submit" class="btn btn-outline-primary">
                <i class="fas fa-check-double me-2"></i>Mark All as Read
            </button>
        </form>
    }
</div>

<div class="card">
    <div class="card-body">
        @if (Model.Notifications.Count == 0)
        {
            <div class="text-center py-5">
                <i class="fas fa-bell-slash fa-3x text-muted mb-3"></i>
                <p class="text-muted">No notifications</p>
            </div>
        }
        else
        {
            <div class="list-group list-group-flush">
                @foreach (var notification in Model.Notifications)
                {
                    var isUnread = notification.ReadAt == null;
                    var bgClass = isUnread ? "bg-light" : "";

                    <div class="list-group-item @bgClass">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="flex-grow-1">
                                <div class="d-flex align-items-center mb-1">
                                    @if (isUnread)
                                    {
                                        <span class="badge bg-primary me-2">New</span>
                                    }
                                    <h6 class="mb-0 @(isUnread ? "fw-bold" : "")">@notification.Title</h6>
                                </div>
                                @if (!string.IsNullOrEmpty(notification.Message))
                                {
                                    <p class="text-muted mb-1">@notification.Message</p>
                                }
                                <small class="text-muted">
                                    <i class="fas fa-clock me-1"></i>@notification.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                                    @if (notification.DueAt.HasValue)
                                    {
                                        <span class="ms-3">
                                            <i class="fas fa-calendar-alt me-1"></i>Due: @notification.DueAt.Value.ToString("MMM dd, yyyy")
                                        </span>
                                    }
                                </small>
                            </div>
                            <div class="d-flex gap-2">
                                @if (isUnread)
                                {
                                    <form method="post" asp-page-handler="MarkAsRead">
                                        <input type="hidden" name="id" value="@notification.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-success" title="Mark as Read">
                                            <i class="fas fa-check"></i>
                                        </button>
                                    </form>
                                }
                                @if (notification.DismissedAt == null)
                                {
                                    <form method="post" asp-page-handler="Dismiss">
                                        <input type="hidden" name="id" value="@notification.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-secondary" title="Dismiss">
                                            <i class="fas fa-times"></i>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Dismissed</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
