<div class="container mb-3">
    <div class="mt-5">
        <div class="row g-4">

            <!-- Vision -->
            <div class="col-md-6">

                <div class="vmx-card h-100">
                    <div class="vmx-header">
                        <div class="mb-3">
                            <h4 class="heading-title">@ViewBag.Vision.Title</h4>
                            <div class="title-line-mission-vision"></div>
                        </div>
                        <i class="bi bi-lightbulb vmx-icon"></i>
                    </div>



                    <p class="vmx-text">
                        @Html.Raw(ViewBag.Vision.Description)
                    </p>

                    <div class="vmx-bottom-line"></div>

                    <!-- Bottom-Right Decorative Image -->
                    @*<img src="~/Images/Islamic-Icon.png"
                        alt=""
                        loading="lazy"
                        class="vmx-bottom-img">*@
                </div>
            </div>

            <!-- Mission -->
            <div class="col-md-6">
                <div class="vmx-card h-100">

                    <div class="vmx-header">
                        <div class="mb-3">
                            <h4 class="heading-title">@ViewBag.Mission.Title</h4>
                            <div class="title-line-mission-vision"></div>
                        </div>
                        <i class="bi bi-bullseye vmx-icon"></i>
                    </div>

                    <p class="vmx-text">
                        @Html.Raw(ViewBag.Mission.Description)
                    </p>

                    <div class="vmx-bottom-line"></div>

                    <!-- Bottom-Right Decorative Image -->
                    @*<img src="~/Images/Islamic-Icon.png"
                        alt=""
                        loading="lazy"
                        class="vmx-bottom-img">*@
                </div>
            </div>

        </div>
    </div>



    <!--About Us-->
    <div class="mt-5">
        <!-- About Us Section -->
        <section class="about-section py-5 position-relative">
            <!-- Decorative Corner Images -->
            <img src="~/Images/top-corner-left.png" alt="" loading="lazy" class="corner-img corner-top-left">
            <img src="~/Images/bottom-corner-right.png" alt="" loading="lazy" class="corner-img corner-bottom-right">

            <div class="container">
                <div class="row align-items-center">
                    <!-- Image -->
                    <div class="col-lg-6 mb-5 mb-lg-0">
                        <div class="image-wrapper">
                            <div class="shape shape-1"></div>
                            <div class="shape shape-2"></div>
                            <img src="~/Images/@(string.IsNullOrEmpty(ViewBag.AboutUs?.Image)
                                ? "missing-image.jpg"
                                : ViewBag.AboutUs.Image)"
                                 alt="About Us"
                                 loading="lazy"
                                 class="about-image"
                                 onerror="this.onerror=null;this.src='/Images/missing-image.jpg';"
                             />
                        </div>
                    </div>

                    <!-- Text -->
                    <div class="col-lg-6">
                        <h3 class="heading-title">@ViewBag.AboutUs.Title</h3>
                        <div class="title-line mb-4"></div>
                        <div class="about-text-wrapper">
                            <p class="about-text">
                                @ViewBag.AboutUs.Description
                            </p>
                        </div>
                        <a href="/Home/AboutUs" class="about-btn mt-4">@ViewBag.MoreLabel.Data</a>
                    </div>
                </div>
            </div>
        </section>
    </div>


    <!--Classes-->
    <div class="services-section mt-5 mb-3">

        <div class="mb-3">
            <h3 class="heading-title">@ViewBag.ClassLabel.Data</h3>
            <div class="title-line"></div>
        </div>

        <div class="row justify-content-center g-4">

            <!-- Card 1 -->
            <div class="col-md-4">
                <div class="service-card">
                    <div class="service-image">
                        <img src="~/Images/4.jpeg" alt="Quran Recitation">
                    </div>
                    <h5 class="shimmer">Quran Recitation</h5>
                    <p>Learn proper recitation with Tajweed rules in a simple and effective method.</p>
                    <div class="btn-wrapper">
                        <a href="#" class="service-btn">@ViewBag.RegisterLabel.Data</a>
                    </div>

                </div>
            </div>

            <!-- Card 2 -->
            <div class="col-md-4">
                <div class="service-card">
                    <div class="service-image">
                        <img src="~/Images/4.jpeg" alt="Quran Recitation">
                    </div>
                    <h5 class="shimmer">Quran Memorization</h5>
                    <p>Step-by-step Hifz classes designed for all ages with structured plans.</p>
                    <div class="btn-wrapper">
                        <a href="#" class="service-btn">@ViewBag.RegisterLabel.Data</a>
                    </div>
                </div>
            </div>

            <!-- Card 3 -->
            <div class="col-md-4">
                <div class="service-card">
                    <div class="service-image">
                        <img src="~/Images/4.jpeg" alt="Quran Recitation">
                    </div>
                    <h5 class="shimmer">Tafsir Lessons</h5>
                    <p>Understand the meaning of the Quran with simple and authentic tafsir lessons.</p>
                    <div class="btn-wrapper">
                        <a href="#" class="service-btn">@ViewBag.RegisterLabel.Data</a>
                    </div>

                </div>
            </div>

        </div>
    </div>

    <!-- Events Section -->
    <div class="events-section mt-5">
        <div class="mb-3 events-header">
            <h4 class="heading-title">Events</h4>
            <div class="title-line"></div>
        </div>

        <div class="row">
            <!-- Event Card 1 -->
            <div class="col-md-4 mb-4">
                <div class="event-card">
                    <div class="event-image">
                        <img src="~/Images/4.jpeg" alt="Event 1">
                        <!-- Move the badge inside the image container -->
                        <div class="event-date-badge">
                            <span class="day">20</span>
                            <span class="month">Dec</span>
                        </div>
                    </div>
                    <div class="event-content">
                        <h5 class="shimmer">Annual Tech Conference</h5>
                        <p>Join us for the latest trends in technology, networking, and workshops with industry leaders.</p>
                    </div>
                </div>
            </div>


            <!-- Event Card 2 -->
            <div class="col-md-4 mb-4">
                <div class="event-card">
                    <div class="event-image">
                        <img src="~/Images/3.jpeg" alt="Event 2">
                    </div>
                    <div class="event-date-badge">
                        <span class="day">15</span>
                        <span class="month">Jan</span>
                    </div>
