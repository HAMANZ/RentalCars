@{
    Layout = "_HomeLayout";
    ViewData["Title"] = "Home";
}
<!-- Owl Carousel CSS -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.carousel.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.theme.default.min.css">

<!-- jQuery (required) -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

<!-- Owl Carousel JS -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/owl.carousel.min.js"></script>

<style>

    @@media (max-width: 991.98px) {
        body {
            padding-top: 0px;
        }
    }


        .carousel-img {
            height: 500px;
            object-fit: cover;
        }

        /* Caption Styling */
        .custom-caption {
            background: rgba(29, 33, 76, 0.7); /* primary color with transparency */
            padding: 15px 20px;
            border-radius: 8px;
        }

            .custom-caption h5 {
                color: var(--secondary-color);
                font-size: 2rem;
                font-weight: 700;
            }

            .custom-caption p {
                color: #ffffff;
                font-size: 1.1rem;
            }

        /* Indicators */
        .carousel-indicators button {
            background-color: var(--secondary-color);
        }

        .carousel-indicators .active {
            background-color: var(--primary-color);
        }

        /* Arrows */
        .custom-arrow {
            filter: invert(90%);
        }

        /* Heading */
        .heading-title {
            color: var(--primary-color);
            font-weight: 700;
            font-size: 28px;
        }

        /* Underline */
        .title-line {
            width: 60px;
            height: 5px;
            background: var(--secondary-color);
            border-radius: 5px;
            transition: width 0.4s ease;
        }


        /* Service Cards */

        .services-section .service-card {
            border-radius: 0.35rem;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
            padding-bottom: 25px;
            transition: all 0.3s ease;
            text-align: left; /* Keep left aligned */
            border: 1px solid #ededed;
        }

            .services-section .service-card:hover {
                transform: translateY(-7px);
                box-shadow: 0 8px 25px rgba(0,0,0,0.12);
            }

        /* Card Image */
        .service-image {
            border-radius: 0.35rem;
            padding: 10px;
        }

            .service-image img {
                width: 100%;
                height: 220px;
                object-fit: cover;
                border-radius: inherit;
            }

        /* Title */
        .services-section .service-card h5 {
            font-weight: bold;
            margin: 20px 20px 10px;
            font-size: 20px;
        }

        /* Description */
        .services-section .service-card p {
            color: var(--primary-color);
            font-size: 15px;
            padding: 0 20px;
        }

        /* Button */
        .services-section .service-btn {
            background: var(--gradient-bg);
            color: var(--primary-color);
            padding: 10px 25px;
            border-radius: 0.35rem;
            font-weight: 600;
            text-decoration: none;
            display: inline-block;
            margin: 10px 20px 0;
            transition: 0.3s ease;
        }

            .services-section .service-btn:hover {
                background-color: var(--accent-color);
                transform: translateY(-3px);
            }

        .services-section .btn-wrapper {
            text-align: center;
            margin-top: 10px;
        }

        /* Card */
        .vmx-card {
            position: relative;
            padding: 30px;
            border-radius: 0.35rem;
            box-shadow: 0 6px 18px rgba(0,0,0,0.08);
            background: var(--bg-color);
            overflow: hidden;
            display: flex;
            flex-direction: column;
            height: 100%;
            background: var(--gradient-bg);
            transition: all 0.3s ease;
            /* Islamic pattern background */
            /*background-image: url('/Images/Beige and Red Christmas Party Invitation.png');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;*/
            /* opacity: 0.5;*/
        }

            /* Subtle overlay for readability */
            .vmx-card::before {
                content: "";
                position: absolute;
                inset: 0;
                background: transparent;
                z-index: 0;
            }

            .vmx-card > * {
                position: relative;
                z-index: 1;
            }

            .vmx-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 12px 25px rgba(0,0,0,0.12);
            }

        /* Header (title + icon) */
        .vmx-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .vmx-title {
            font-size: 24px;
            font-weight: bold;
            color: var(--primary-color);
            margin: 0;
        }

        /* Icons */
        .vmx-icon {
            font-size: 42px;
            background: linear-gradient(45deg, var(--secondary-color), var(--primary-color));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        /* Text */
        .vmx-text {
            margin-top: 5px;
            color: var(--primary-color);
            /*line-height: 1.6;*/
            flex-grow: 1;
        }

        /* Bottom line */
        .vmx-bottom-line {
            margin-top: 5px;
            height: 3px;
            width: 100%;
            background: linear-gradient(to right, var(--primary-color), var(--accent-color));
            border-radius: 10px;
        }

        /* Underline */
        .title-line-mission-vision {
            width: 60px;
            height: 5px;
            background: linear-gradient(to right, var(--primary-color), var(--accent-color));
            border-radius: 5px;
            transition: width 0.4s ease;
        }

        /* Bottom-right decorative image inside card */
        /*.vmx-bottom-img {
        position: absolute;
        bottom: 0px;
        right: 0px;
        width: 80px;  Adjust size
         Soft & subtle
        pointer-events: none;  Avoid click blocking
        z-index: 0;  Behind text
    }
    */

    /* =========================
      ABOUT SECTION
       ========================= */
    .about-section {
        padding-top: 70px;
        padding-bottom: 70px;
        border-radius: 0.35rem;
        position: relative;
        overflow: hidden;
        z-index: 1;
    }

    /* DECORATIVE CORNER IMAGES */
    .corner-img {
        position: absolute;
        width: 150px;
        height: 150px;
        opacity: 0.9;
        pointer-events: none;
        z-index: 0; /* background layer */
    }

    .corner-top-left {
        top: 0;
        left: 0;
    }

    .corner-bottom-right {
        bottom: 0;
        right: 0;
    }

    /* IMAGE AREA */
    .image-wrapper {
        position: relative;
        max-width: 500px;
        margin: auto;
        z-index: 2; /* above decorations */
    }

    .shape {
        position: absolute;
        width: 260px;
        height: 260px;
        opacity: 0.35;
        filter: blur(30px);
        z-index: 1; /* behind image, above background */
    }

    .shape-1 {
        background: var(--primary-color);
        top: -30px;
        left: -50px;
        border-radius: 60% 40% 55% 45%;
    }

    .shape-2 {
        background: var(--secondary-color);
        bottom: -30px;
        right: -40px;
        border-radius: 50% 60% 45% 55%;
    }

    .about-image {
        position: relative;
        width: 100%;
        border-radius: 20px;
        border: 4px solid var(--secondary-color);
        box-shadow: 0 15px 40px rgba(0,0,0,0.15);
        transition: 0.4s ease;
        z-index: 2; /* content layer */
    }

        .about-image:hover {
            transform: scale(1.03);
        }

    /* LONG TEXT DESIGN */
    [dir="ltr"] .about-text-wrapper {
        max-width: 560px;
        padding: 12px 14px;
        /*background: rgba(255, 255, 255, 0.55);*/
        border-left: 2px solid var(--secondary-color);
        border-radius: 0.25rem;
        /*box-shadow: 0 8px 22px rgba(0,0,0,0.05);*/
        position: relative;
        z-index: 2; /* content layer */
    } 
    
    [dir="rtl"] .about-text-wrapper {
        max-width: 560px;
        padding: 12px 14px;
        /*background: rgba(255, 255, 255, 0.55);*/
        border-right: 2px solid var(--secondary-color);
        border-radius: 0.25rem;
        /*box-shadow: 0 8px 22px rgba(0,0,0,0.05);*/
        position: relative;
        z-index: 2; /* content layer */
    }

    .about-text {
        margin: 0;
        font-size: 18px;
        font-weight: 500;
        line-height: 1.8;
        color: var(--primary-color);
        text-align: justify;
        position: relative;
        z-index: 2;
    }


    /* RESPONSIVE */
    @@media (max-width: 768px) {
        .about-text-wrapper {
            padding: 18px;
            max-width: 100%;
        }

        .about-text {
            font-size: 16px;
            line-height: 1.75;
        }
        /*.about-text::first-letter { font-size: 36px; }*/
    }
        /* Button */
        .about-btn {
            display: inline-block;
            background: var(--gradient-bg);
            color: var(--primary-color);
            padding: 12px 28px;
            font-weight: 600;
            border-radius: 0.35rem;
            text-decoration: none;
            transition: 0.3s ease;
            box-shadow: 0 4px 20px rgba(0,0,0,0.15);
        }

            .about-btn:hover {
                /* background: var(--accent-color);*/
                transform: translateY(-3px);
            }


        .quran-verse {
            position: relative;
            background: #f5f5f5; /* light background */
            border: 3px solid #e0d9c3; /* main border */
            padding: 30px 40px;
            max-width: 600px;
            margin: auto;
            text-align: center;
            border-radius: 25px 25px 25px 25px; /* base rounding */
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

            .quran-verse::before,
            .quran-verse::after {
                content: '';
                position: absolute;
                width: 30px;
                height: 30px;
                border: 3px solid #e0d9c3;
                background: #f5f5f5;
            }

            .quran-verse::before {
                top: -3px;
                left: -3px;
                border-right: none;
                border-bottom: none;
                border-radius: 25px 0 0 0;
            }

            .quran-verse::after {
                bottom: -3px;
                right: -3px;
                border-left: none;
                border-top: none;
                border-radius: 0 0 25px 0;
            }

        .arabic {
            font-size: 1.6rem;
            font-weight: bold;
            margin-bottom: 15px;
        }

        .translation {
            font-size: 1rem;
            color: #333;
        }

        /* Partners Section */
        .partners-section {
            padding: 40px 0;
        }

        .partners-header .title-line {
            width: 60px;
            height: 5px;
            background: var(--secondary-color);
            border-radius: 5px;
            transition: width 0.4s ease;
        }

        /* .partners-header .title-line {
        width: 60px;
        height: 3px;
        background: var(--accent-color, #e7ce76);
        margin: 8px auto 20px;
    }*/

        /* Carousel items */
        .partner-item {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 6px;
        }

        /* Logo wrapper */
        .partner-logo {
            border-radius: 0.35rem;
            overflow: hidden;
            background-color: #fff;
            box-shadow: 0 4px 10px rgba(0,0,0,0.06);
            display: flex;
            justify-content: center;
            align-items: center;
        }

            /* Image inside */
            .partner-logo img {
                width: 150px;
                height: 150px;
                display: block;
                border-radius: inherit;
            }

        /* Remove default dots background spacing */
        .owl-theme .owl-dots {
            margin-top: 15px;
        }

        /* Events */
        /* Event Card */
        .event-card {
            position: relative;
            background: #fff;
            border-radius: 0.35rem;
            overflow: hidden;
            box-shadow: 0 8px 22px rgba(0, 0, 0, 0.1);
            transition: transform 0.25s ease, box-shadow 0.25s ease;
            cursor: pointer;
            border: 1px solid #ededed;
        }

            .event-card:hover {
                transform: translateY(-6px);
                box-shadow: 0 14px 30px rgba(0, 0, 0, 0.18);
            }

        /* Event Image */
        .event-image {
            padding: 10px;
            border-radius: 0.35rem;
        }

            .event-image img {
                width: 100%;
                height: 230px;
                object-fit: cover;
                display: block;
                border-radius: inherit;
            }



        /* Date Badge */
        .event-date-badge {
            position: absolute;
            top: 10px;
            right: 10px;
            background: var(--gradient-bg);
            padding: 10px 14px;
            border-radius: 0.35rem;
            text-align: center;
            box-shadow: 0 3px 10px rgba(0, 0, 0, 0.15);
        }

            .event-date-badge .day {
                display: block;
                font-size: 22px;
                font-weight: 700;
                color: var(--primary-color);
                line-height: 1;
            }

            .event-date-badge .month {
                display: block;
                font-size: 14px;
                font-weight: 600;
                color: var(--primary-color);
                text-transform: uppercase;
                margin-top: 2px;
            }

        /* Content */
        .event-content {
            padding: 20px;
        }

            .event-content h5 {
                font-size: 20px;
                font-weight: bold;
                margin-bottom: 8px;
            }

            .event-content p {
                margin: 0;
                font-size: 14px;
                color: var(--primary-color);
                line-height: 1.5;
            }

        /* Responsive */
        @@media (max-width: 768px) {
            .event-image img {
                height: 180px;
            }
        }


        .shimmer {
            font-weight: 700;
            font-size: 24px;
            color: var(--primary-color); /* base color */
            position: relative;
            display: inline-block;
            background: linear-gradient( 90deg, #ebcf6d 0%, var(--primary-color) 50%, #d3b964 100% );
            background-size: 200% 100%;
            background-clip: text;
            -webkit-background-clip: text;
            color: transparent;
            animation: shimmer 5s linear infinite;
        }

        @@keyframes shimmer {
            0% {
                background-position: 200% center;
            }

            100% {
                background-position: -200% center;
            }
        }

        .video-banner {
            position: relative;
            width: 100%;
            height: 70vh; /* Adjust height */
            overflow: hidden;
        }

            .video-banner video {
                position: absolute;
                top: 50%;
                left: 50%;
                min-width: 100%;
                min-height: 100%;
                transform: translate(-50%, -50%);
                object-fit: cover; /* Makes the video fill the area */
                z-index: 1;
            }

        .banner-content {
            position: relative;
            z-index: 2;
            color: white;
            text-align: center;
            top: 75%;
            transform: translateY(-50%);
            width: 100%;
        }

        .banner-content h1{
            font-family: "Hafs", serif;
        }
</style>

<section class="video-banner">
    <video autoplay muted loop playsinline>
        <source src="~/Images/EsnadAdv1.mp4" type="video/mp4">
    </video>

    <div class="banner-content">
        <h1>@ViewBag.QuranArabic.Data </h1>
        <p dir="ltr">
            @Html.Raw(ViewBag.QuranEnglish.Data)
        </p>
    </div>
</section>


