@{
    Layout = "_HomeLayout";
    ViewData["Title"] = "FAQ";
}
<style>


/* Header */
.faq-header h3 {
    font-weight: 700;
    color: var(--primary-color);
}


.faq-pill {
    display: inline-block;
    background: var(--gradient-bg);
    color: #fff;
    padding: 6px 22px;
    border-radius: 30px;
    font-size: 0.85rem;
    margin-bottom: 10px;
}

/* Card */
.faq-wrapper {
    max-width: 850px;
    margin: auto;
}

    .faq-card {
        background: #fff;
        border-radius: 20px;
        margin-bottom: 22px;
        box-shadow: 0 20px 50px rgba(10,15,55,0.1);
        overflow: hidden;
        transition: transform 0.3s ease;
        border: 1px solid #ededed;
    }

.faq-card:hover {
    transform: translateY(-5px);
}

/* Toggle */
.faq-toggle {
    width: 100%;
    background: transparent;
    border: none;
    padding: 26px 30px;
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--primary-color);
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
}

.faq-toggle:focus {
    outline: none;
}

/* Chevron animation */
.faq-icon {
    font-size: 1.6rem;
    color: var(--secondary-color);
    transition: transform 0.35s ease;

}
    .bi-chevron-down::before {
        font-weight: bold !important;
    }

    .faq-toggle:not(.collapsed) .faq-icon {
        transform: rotate(180deg);
    }

/* Answer animation */
    .faq-content {
        padding: 15px;
        color: var(--primary-color);
        font-weight: 500;
        line-height: 1.85;
        animation: fadeSlide 0.45s ease;
        background: var(--gradient-bg);
    }

/* Fade + Slide */
@@keyframes fadeSlide {
    from {
        opacity: 0;
        transform: translateY(-6px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

</style>
<section class="mt-5 mb-3">
    <div class="container">

        <!-- Header -->
        <div class="faq-header text-center mb-4">
            <span class="faq-pill">FAQ</span>
            <h3>Frequently Asked Questions</h3>
            <p class="text-muted">Clear answers with a smooth experience</p>
        </div>

        <div class="faq-wrapper">

            <div class="faq-card">
                <button class="faq-toggle" data-bs-toggle="collapse" data-bs-target="#faq1">
                    <span>What is RentalCar Quran Institute?</span>
                    <i class="bi bi-chevron-down faq-icon"></i>
                </button>
                <div id="faq1" class="collapse show faq-content">
                    RentalCar Quran Institute offers structured Quran learning programs
                    for all ages with certified teachers.
                </div>
            </div>

            <div class="faq-card">
                <button class="faq-toggle collapsed" data-bs-toggle="collapse" data-bs-target="#faq2">
                    <span>Who can enroll in the courses?</span>
                    <i class="bi bi-chevron-down faq-icon"></i>
                </button>
                <div id="faq2" class="collapse faq-content">
                    Courses are open for children, teenagers, and adults at all levels.
                </div>
            </div>

            <div class="faq-card">
                <button class="faq-toggle collapsed" data-bs-toggle="collapse" data-bs-target="#faq3">
                    <span>Are the classes online?</span>
                    <i class="bi bi-chevron-down faq-icon"></i>
                </button>
                <div id="faq3" class="collapse faq-content">
                    Yes, all classes are conducted online with flexible scheduling.
                </div>
            </div>

        </div>
    </div>
</section>
