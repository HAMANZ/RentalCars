@{
    Layout = "";
    ViewData["Title"] = "404 - Page Not Found";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>404 - Page Not Found</title>

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="~/Images/website-icon.jpeg" />

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Custom CSS -->
    <link href="~/CustomCss/site.css" rel="stylesheet" />

    <style>
        body {
            background-color: #ffffff;
            font-family: 'Arial', sans-serif;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .container {
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100vh;
        }

        .row {
            width: 100%;
            max-width: 800px;
            align-items: center;
            text-align: center;
        }

        .iconImage {
            max-width: 80%;
            max-height: 270px;
        }

        .error-text {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
        }

            .error-text h5 {
                color: #b3b2b2;
            }

        .home-btn {
            margin-top: 20px;
            padding: 10px 20px;
            font-size: 16px;
            text-decoration: none;
            color: var(--secondary-color);
            background-color: var(--primary-color);
            border-radius: 0.35rem;
            transition: 0.3s;
            display: inline-block;
            font-weight: bold;
        }

            .home-btn:hover {
                background-color: #1d214ed9;
            }

        p {
            color: #ab0a0a;
            font-weight: bold;
            margin-top: 10px;
        }

        h5 {
            font-weight: bold;
            padding: 5px;
        }

        @@media(max-width: 768px) {
            .iconImage {
                max-width: 80%;
                max-height: 150px;
            }
        }
    </style>
</head>
<body>

    <div class="container">
        <div class="row d-flex align-items-center">
            <!-- Left Side - Image -->
            <div class="col-md-6 d-flex align-items-center justify-content-center">
                <img src="~/Images/website-icon.jpeg" class="iconImage img-fluid" alt="RentalCar Quran Institute">
            </div>

            <!-- Right Side - Text and Button -->
            <div class="col-md-6 error-text">
                <h5>
                    <span lang="en">Page Not Found</span> | <span lang="ar">الصفحة غير موجودة</span>
                </h5>
                <p>
                    <span lang="en">The page you are looking for does not exist.</span><br>
                    <span lang="ar">.نأسف، الرابط غير موجود</span>
                </p>
                <a href="/Home/Index" class="home-btn">
                    <span lang="en">GO TO HOME</span> | <span lang="ar">الذهاب للصفحة الرئيسية</span>
                </a>
            </div>
        </div>
    </div>

</body>
</html>


