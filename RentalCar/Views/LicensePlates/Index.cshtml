@using RentalCar.DomainLayer.Models
@model List<LicensePlate>
@{
    Layout = "_AdminLTELayout";
    ViewData["Title"] = "License Plates";
    var isRtl = (bool?)ViewData["IsRtl"] ?? false;
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
    <style>
        #plateTable th, #plateTable td { text-align: center !important; vertical-align: middle; }
        .badge { font-weight: 500; padding: 6px 10px; font-size: 0.85rem; }
    </style>
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0"><i class="fas fa-id-card mr-2"></i>License Plates</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb @(isRtl ? "float-sm-left" : "float-sm-right")">
                    <li class="breadcrumb-item"><a href="/Admin/Index">Home</a></li>
                    <li class="breadcrumb-item active">License Plates</li>
                </ol>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="card-title mt-1"><i class="fas fa-list mr-1"></i> All License Plates</h3>
                <a class="btn btn-success btn-sm" href="/LicensePlates/Create" title="Add License Plate">
                    <i class="fas fa-plus-circle mr-1"></i> Add Plate
                </a>
            </div>
            <div class="card-body">
                <table id="plateTable" class="table table-striped table-bordered nowrap" style="width:100%">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Plate Number</th>
                            <th>Type</th>
                            <th>Region</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var count = 1; }
                        @foreach (var plate in Model)
                        {
                            <tr>
                                <td>@count</td>
                                <td>@(string.IsNullOrEmpty(plate.PlateNumber) ? "-" : plate.PlateNumber)</td>
                                <td>@(plate.PlateType?.Name ?? "-")</td>
                                <td>@(plate.PlateRegion?.Name ?? "-")</td>
                                <td>
                                    @if (plate.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td>
                                    <a class="btn btn-sm btn-warning" href="/LicensePlates/Edit/@plate.Id" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form method="post" asp-action="Delete" asp-controller="LicensePlates" class="d-inline"
                                          onsubmit="return confirm('Are you sure you want to delete this plate?');">
                                        <input type="hidden" name="id" value="@plate.Id" />
                                        <button type="submit" class="btn btn-sm btn-danger" title="Delete">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                            count++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#plateTable').DataTable({
                responsive: true,
                pageLength: 10,
                lengthMenu: [5, 10, 25, 50],
                language: { emptyTable: "No license plates found" },
                columnDefs: [{ orderable: false, targets: [5] }]
            });
        });
    </script>
}
