@using RentalCar.DomainLayer.Models
@model List<Car>
@{
    Layout = "_AdminLTELayout";
    ViewData["Title"] = "Cars";
    var isRtl = (bool?)ViewData["IsRtl"] ?? false;
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
    <style>
        #carTable th, #carTable td {
            text-align: center !important;
            vertical-align: middle;
        }

        #carTable td img {
            display: block;
            margin-left: auto;
            margin-right: auto;
            width: 60px;
            height: 45px;
            object-fit: cover;
            border-radius: 6px;
        }

        .badge {
            font-weight: 500;
            padding: 6px 10px;
            font-size: 0.85rem;
        }
    </style>
}

<!-- Content Header -->
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0"><i class="fas fa-car mr-2"></i>Cars</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb @(isRtl ? "float-sm-left" : "float-sm-right")">
                    <li class="breadcrumb-item"><a href="/Admin/Index">Home</a></li>
                    <li class="breadcrumb-item active">Cars</li>
                </ol>
            </div>
        </div>
    </div>
</section>

<!-- Main content -->
<section class="content">
    <div class="container-fluid">

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }

        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="card-title mt-1"><i class="fas fa-list mr-1"></i> All Cars</h3>
                <a class="btn btn-success btn-sm" href="/Cars/Create" title="Add Car">
                    <i class="fas fa-plus-circle mr-1"></i> Add Car
                </a>
            </div>
            <div class="card-body">

                <table id="carTable" class="table table-striped table-bordered nowrap" style="width:100%">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Image</th>
                            <th>Brand</th>
                            <th>Model</th>
                            <th>Year</th>
                            <th>Plate</th>
                            <th>Color</th>
                            <th>Current KM</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var count = 1;
                        }
                        @foreach (var car in Model)
                        {
                            <tr>
                                <td>@count</td>
                                <td>
                                    <img src="@(string.IsNullOrEmpty(car.Image) ? "/Images/missing-image.jpg" : $"/Images/Cars/{car.Image}")"
                                         alt="Car Image"
                                         onerror="this.onerror=null;this.src='/Images/missing-image.jpg';" />
                                </td>
                                <td>@(car.Brand?.Name ?? "-")</td>
                                <td>@(string.IsNullOrEmpty(car.Model) ? "-" : car.Model)</td>
                                <td>@car.Year</td>
                                <td>@(car.LicensePlate?.PlateNumber ?? "-")</td>
                                <td>@(string.IsNullOrEmpty(car.Color) ? "-" : car.Color)</td>
                                <td>@car.CurrentKM.ToString("N0")</td>
                                <td>
                                    <span class="badge bg-info">@(car.CarStatus?.Name ?? "-")</span>
                                </td>
                                <td>
                                    <a class="btn btn-sm btn-primary" href="/Cars/Details/@car.Id" title="View Details">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a class="btn btn-sm btn-warning" href="/Cars/Edit/@car.Id" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form method="post" asp-action="Delete" asp-controller="Cars" class="d-inline"
                                          onsubmit="return confirm('Are you sure you want to delete this car?');">
                                        <input type="hidden" name="id" value="@car.Id" />
                                        <button type="submit" class="btn btn-sm btn-danger" title="Delete">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                            count++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#carTable').DataTable({
                responsive: true,
                pageLength: 10,
                lengthMenu: [5, 10, 25, 50],
                language: { emptyTable: "No cars found" },
                columnDefs: [
                    { orderable: false, targets: [1, 9] } // Image & Action
                ]
            });
        });
    </script>
}
