@using RentalCar.DomainLayer.DTO
@model CarDTO
@{
    Layout = "_AdminLTELayout";
    ViewData["Title"] = "Edit Car";
    var isRtl = (bool?)ViewData["IsRtl"] ?? false;
    var currentImage = string.IsNullOrEmpty(Model.Image) ? "/Images/missing-image.jpg" : $"/Images/Cars/{Model.Image}";
}

<!-- Content Header -->
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0"><i class="fas fa-car mr-2"></i>Edit Car</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb @(isRtl ? "float-sm-left" : "float-sm-right")">
                    <li class="breadcrumb-item"><a href="/Admin/Index">Home</a></li>
                    <li class="breadcrumb-item"><a href="/Cars">Cars</a></li>
                    <li class="breadcrumb-item active">Edit Car</li>
                </ol>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        <div class="card card-primary card-outline">
            <div class="card-header">
                <h3 class="card-title mt-1"><i class="fas fa-edit mr-1"></i> Car Details</h3>
                <div class="card-tools">
                    <a href="/Cars/Details/@Model.Id" class="btn btn-sm btn-info"><i class="fas fa-eye mr-1"></i> View Details</a>
                </div>
            </div>
            <div class="card-body">
                <form asp-action="Edit" asp-controller="Cars" method="post" enctype="multipart/form-data">
                    <partial name="_CarForm" model="Model" />

                    <!-- Image upload -->
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Change Car Image</label>
                            <input type="file" name="ImageFile" class="form-control" accept="image/*"
                                   onchange="previewImage(this)" />
                            <small class="text-muted">Leave empty to keep the current image.</small>
                        </div>
                        <div class="col-md-4 mb-3">
                            <img id="imgPreview" src="@currentImage" alt="Preview"
                                 onerror="this.onerror=null;this.src='/Images/missing-image.jpg';"
                                 style="width:120px;height:90px;object-fit:cover;border-radius:6px;border:1px solid #e3e6ea;" />
                        </div>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary"><i class="fas fa-save mr-1"></i> Update Car</button>
                        <a href="/Cars" class="btn btn-secondary ml-2">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        function previewImage(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = e => document.getElementById('imgPreview').src = e.target.result;
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}
