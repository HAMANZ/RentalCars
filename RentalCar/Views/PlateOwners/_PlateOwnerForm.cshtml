@using RentalCar.DomainLayer.DTO
@model PlateOwnerDTO

<input type="hidden" name="Id" value="@Model.Id" />

<div class="row">
    <div class="col-md-6 mb-3">
        <label class="form-label">Full Name</label>
        <input type="text" name="FullName" class="form-control" value="@Model.FullName" required />
    </div>
    <div class="col-md-6 mb-3">
        <label class="form-label">National ID</label>
        <input type="text" name="NationalId" class="form-control" value="@Model.NationalId" />
    </div>
    <div class="col-md-6 mb-3">
        <label class="form-label">Phone</label>
        <input type="text" name="Phone" class="form-control" value="@Model.Phone" />
    </div>
    <div class="col-md-6 mb-3">
        <label class="form-label">Email</label>
        <input type="email" name="Email" class="form-control" value="@Model.Email" />
    </div>
    <div class="col-md-12 mb-3">
        <label class="form-label">Address</label>
        <textarea name="Address" class="form-control" rows="2">@Model.Address</textarea>
    </div>
</div>
