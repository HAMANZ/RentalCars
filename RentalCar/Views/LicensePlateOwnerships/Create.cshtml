@using RentalCar.DomainLayer.DTO
@model LicensePlateOwnershipDTO
@{
    Layout = "_AdminLTELayout";
    ViewData["Title"] = "Add Ownership";
    var isRtl = (bool?)ViewData["IsRtl"] ?? false;
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0"><i class="fas fa-user-tag mr-2"></i>Add Ownership</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb @(isRtl ? "float-sm-left" : "float-sm-right")">
                    <li class="breadcrumb-item"><a href="/Admin/Index">Home</a></li>
                    <li class="breadcrumb-item"><a href="/LicensePlateOwnerships">Plate Ownerships</a></li>
                    <li class="breadcrumb-item active">Add</li>
                </ol>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        <div class="card card-primary card-outline">
            <div class="card-header">
                <h3 class="card-title mt-1"><i class="fas fa-plus mr-1"></i> Ownership Details</h3>
            </div>
            <div class="card-body">
                <form asp-action="Create" asp-controller="LicensePlateOwnerships" method="post">
                    <partial name="_OwnershipForm" model="Model" />

                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary"><i class="fas fa-save mr-1"></i> Save</button>
                        <a href="/LicensePlateOwnerships" class="btn btn-secondary ml-2">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>
