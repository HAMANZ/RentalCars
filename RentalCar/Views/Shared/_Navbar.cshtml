@using Microsoft.AspNetCore.Http
@{
    var isRtl = (bool?)ViewData["IsRtl"] ?? false;
    var lang = (string)ViewData["Lang"] ?? "en";
    string userName = Context.Session.GetString("RentalCarUserName");
    if (string.IsNullOrEmpty(userName)) userName = isRtl ? "المدير" : "Admin";
    // localization helper
    Func<string, string, string> L = (en, ar) => isRtl ? ar : en;
}
<nav class="main-header navbar navbar-expand navbar-white navbar-light">
    <!-- Left navbar links -->
    <ul class="navbar-nav">
        <li class="nav-item">
            <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
        </li>
        <li class="nav-item d-none d-sm-inline-block">
            <a href="/Admin/Index" class="nav-link">@L("Home", "الرئيسية")</a>
        </li>
    </ul>

    <!-- Right navbar links -->
    <ul class="navbar-nav ml-auto">
        <!-- Language switcher -->
        <li class="nav-item dropdown">
            <a class="nav-link" data-toggle="dropdown" href="#">
                <i class="fas fa-globe"></i>
                <span class="d-none d-md-inline">@(lang == "ar" ? "العربية" : "English")</span>
            </a>
            <div class="dropdown-menu dropdown-menu-@(isRtl ? "left" : "right")">
                <a class="dropdown-item" href="#" onclick="setLang('en'); return false;">English</a>
                <a class="dropdown-item" href="#" onclick="setLang('ar'); return false;">العربية</a>
            </div>
        </li>

        <!-- Notifications -->
        <li class="nav-item">
            <a class="nav-link" href="#" title="@L("Notifications", "الإشعارات")">
                <i class="far fa-bell"></i>
                <span class="badge badge-warning navbar-badge">0</span>
            </a>
        </li>

        <!-- User -->
        <li class="nav-item dropdown">
            <a class="nav-link" data-toggle="dropdown" href="#">
                <i class="far fa-user"></i>
                <span class="d-none d-md-inline ml-1">@userName</span>
            </a>
            <div class="dropdown-menu dropdown-menu-@(isRtl ? "left" : "right")">
                <a href="/Admin/Users" class="dropdown-item">
                    <i class="fas fa-users mr-2"></i> @L("Users", "المستخدمون")
                </a>
                <div class="dropdown-divider"></div>
                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                    <button type="submit" class="dropdown-item text-danger">
                        <i class="fas fa-sign-out-alt mr-2"></i> @L("Logout", "تسجيل الخروج")
                    </button>
                </form>
            </div>
        </li>
    </ul>
</nav>
