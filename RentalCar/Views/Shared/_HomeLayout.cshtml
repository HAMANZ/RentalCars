<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | RentalCar Quran Institute</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="~/Images/website-icon.jpeg" />
    <!-- Font Family -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Custom CSS -->
    <link href="~/CustomCss/site.css" rel="stylesheet" />

    <style>
        html, body {
            height: 100%;
            margin: 0;
            font-family: 'Poppins', sans-serif !important;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

            body[dir="rtl"] {
                font-family: "Tajawal", serif !important;
                -webkit-font-smoothing: antialiased;
                -moz-osx-font-smoothing: grayscale;
            }

        .wrapper {
            min-height: 100%;
            display: flex;
            flex-direction: column;
        }

        main {
            flex: 1;
        }

        .scroll-top-btn {
            position: fixed;
            bottom: 25px;
            right: 5px;
            background: var(--gradient-bg);
            color: var(--primary-color);
            border: none;
            padding: 12px 16px;
            border-radius: 50%;
            font-size: 20px;
            cursor: pointer;
            display: none;
            box-shadow: 0 4px 8px rgba(0,0,0,0.2);
            transition: background-color .3s, opacity .3s;
            z-index: 999;
        }

            .scroll-top-btn:hover {
                background-color: var(--secondary-color);
            }

        .scroll-top-btn i:before{
            font-weight: bold !important;
        }

        .whatsapp-btn {
            position: fixed;
            bottom: 85px;
            right: 5px;
            background-color: #25D366; /* WhatsApp green */
            color: white;
            border: none;
            padding: 12px 16px;
            border-radius: 50%;
            font-size: 20px;
            cursor: pointer;
            display: none;
            box-shadow: 0 4px 8px rgba(0,0,0,0.2);
            transition: background-color .3s, opacity .3s;
            z-index: 999;
        }

            /* WhatsApp button ABOVE with green color */
            .whatsapp-btn:hover {
                background-color: #20b857;
            }


    /* -------------------------
       Minimized Icon
       ------------------------- */

    .discount-widget {
        position: fixed;
        bottom: 25px;
        left: 7px;
        z-index: 1000;
    }

    .discount-icon {
        width: 52px;
        height: 52px;
        background: var(--gradient-bg);
        border-radius: 50%;
        display: none;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        box-shadow: 0 8px 20px rgba(0,0,0,0.25);
    }

    .discount-icon i {
        font-size: 22px;
        color: var(--primary-color);
    }

    /* -------------------------
       Halo Glow Animation
       ------------------------- */
        @@keyframes haloGlow {
            0% {
                box-shadow: 0 0 0 0 rgba(202, 176, 83, 0.45), /* secondary-color */
                0 8px 20px rgba(0,0,0,0.25);
            }

            60% {
                box-shadow: 0 0 0 14px rgba(178, 149, 69, 0), /* accent-color fading */
                0 8px 20px rgba(0,0,0,0.25);
            }

            100% {
                box-shadow: 0 0 0 0 rgba(178, 149, 69, 0), 0 8px 20px rgba(0,0,0,0.25);
            }
        }


    /* Apply only when minimized */
            .discount-icon.animate {
                animation: haloGlow 4.5s ease-out infinite;
            }


    /* Pause on hover */
    .discount-icon:hover {
        animation-play-state: paused;
    }

    /* -------------------------
       Popup
       ------------------------- */
        .discount-popup {
            position: relative;
            width: 230px;
            background: var(--gradient-bg);
            color: var(--primary-color);
            border-radius: 14px;
            padding: 14px 16px 16px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.25);
            animation: slideInLeft 0.5s ease;
        }

    /* Slide animation */
    @@keyframes slideInLeft {
        from {
            transform: translateX(-120%);
            opacity: 0;
        }
        to {
            transform: translateX(0);
            opacity: 1;
        }
    }

    /* Close button */
    .discount-close {
        position: absolute;
        top: 6px;
        right: 8px;
        background: transparent;
        border: none;
        font-size: 20px;
        cursor: pointer;
        color: var(--primary-color);
    }

    /* Badge */
    .discount-badge {
        display: inline-block;
        background: rgba(255,255,255,0.25);
        font-size: 11px;
        padding: 4px 8px;
        border-radius: 20px;
        margin-bottom: 6px;
        font-weight: 600;
    }

    /* Text */
    .discount-popup h6 {
        margin: 6px 0 0px;
        font-weight: 700;
    }

    .discount-popup p {
        margin: 0 0 10px;
        font-size: 13px;
        opacity: 0.9;
    }

    /* Button */
    .discount-btn {
        display: block;
        text-align: center;
        padding: 8px 8px;
        font-size: 14px;
        background: var(--primary-color);
        color: #fff;
        border-radius: 0.35rem;
        font-weight: 600;
        text-decoration: none;
        transition: background 0.3s ease;
    }

    .discount-btn:hover {
        background: #000;
        color: #fff;
    }

    /* Mobile */
    @@media (max-width: 576px) {
        .discount-popup {
            width: 200px;
        }

    }

       /* =========================
           Glassmorphism Loader
        ========================= */
        .glass-loader {
            position: fixed;
            inset: 0;
            background: rgba(255, 255, 255, 0.65);
            backdrop-filter: blur(10px);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 99999;
        }

        .glass-spinner {
            width: 70px;
            height: 70px;
            border-radius: 50%;
            border: 3px solid rgba(0,0,0,0.1);
            border-top-color: #cab053; /* your gold color */
            animation: glassSpin 1s ease-in-out infinite;
        }

        @@keyframes glassSpin {
            to {
                transform: rotate(360deg);
            }
        }

    </style>
</head>
<body>

    <!-- Page Loader -->
    <div id="pageLoader" class="glass-loader">
        <div class="glass-spinner"></div>
    </div>

    <div class="wrapper">

        <!-- Header -->
        @await Component.InvokeAsync("HeaderLayout")

        <main>
            <!-- Main content -->
            <div>
                @RenderBody()
            </div>
        </main>

        <!-- Discount Widget -->
        <div class="discount-widget" id="discountWidget">

            <!-- Minimized Icon -->
            <div class="discount-icon" id="discountIcon">
                <i class="bi bi-gift-fill"></i>
            </div>

            <!-- Full Popup -->
            <div class="discount-popup" id="discountPopup">
                <button class="discount-close" id="discountClose" aria-label="Close">
                    <i class="bi bi-x"></i>
                </button>

                <span class="discount-badge">Limited Offer</span>
                <h6>Get <strong>10% OFF</strong></h6>
                <p>On all Quran programs</p>

                <a href="/Register" class="discount-btn">
                    Register Now
                </a>
            </div>

        </div>



        <!--Whatsapp Scroll Link-->
        <a href="https://wa.me/11234567890"
           target="_blank"
           aria-label="Chat on WhatsApp"
           class="whatsapp-btn"
           id="whatsapp">
            <i class="bi bi-whatsapp"></i>
        </a>

        <!--Scroll To Top-->
        <button id="scrollTopBtn" class="scroll-top-btn">
            <i class="bi bi-arrow-up"></i>
        </button>


        <!-- Footer -->
        @await Component.InvokeAsync("FooterLayout")
    </div>

    <!-- Bootstrap JS (Popper included) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        const scrollTopBtn = document.getElementById("scrollTopBtn");
        const whatsappBtn = document.getElementById("whatsapp");

        // Show/hide scroll to top button
        window.addEventListener("scroll", () => {
            if (window.scrollY > 200) {
                scrollTopBtn.style.display = "block";
            } else {
                scrollTopBtn.style.display = "none";
            }

            // Show/hide WhatsApp button (same logic)
            if (window.scrollY > 300) {
                whatsappBtn.style.display = "block";
            } else {
                whatsappBtn.style.display = "none";
            }
        });

        // Scroll to top
        scrollTopBtn.addEventListener("click", () => {
            window.scrollTo({
                top: 0,
                behavior: "smooth"
            });
        });

        const discountPopup = document.getElementById("discountPopup");
        const discountIcon = document.getElementById("discountIcon");
        const discountClose = document.getElementById("discountClose");

        // Close popup → show icon with animation only on large screens
        discountClose.addEventListener("click", () => {
            discountPopup.style.display = "none";

            // Check if screen width is greater than 576px (Bootstrap sm breakpoint)
            if (window.innerWidth > 992) {
                discountIcon.style.display = "flex";
                discountIcon.classList.add("animate");
            } else {
                // On small screens, hide icon completely
                discountIcon.style.display = "none";
                discountIcon.classList.remove("animate");
            }
        });

        // Click icon → reopen popup
        discountIcon.addEventListener("click", () => {
            discountPopup.style.display = "block";
            discountIcon.style.display = "none";
            discountIcon.classList.remove("animate");
        });

        // Optional: handle screen resize to reset icon visibility
        window.addEventListener("resize", () => {
            if (window.innerWidth <= 992) {
                discountIcon.style.display = "none";
            }
        });

        window.addEventListener("load", function () {
            const loader = document.getElementById("pageLoader");
            if (loader) {
                loader.style.opacity = "0";
                setTimeout(() => loader.style.display = "none", 300);
            }
        });

        //document.querySelectorAll("a").forEach(link => {
        //    link.addEventListener("click", function (e) {
        //        if (this.getAttribute("href") && !this.getAttribute("href").startsWith("#")) {
        //            const loader = document.getElementById("pageLoader");
        //            if (loader) loader.style.display = "flex";
        //        }
        //    });
        //});
    </script>

</body>
</html>
