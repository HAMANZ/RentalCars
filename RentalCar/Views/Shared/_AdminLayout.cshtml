@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | CMS</title>
    <!--Font Awesome-->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="~/Images/website-icon.jpeg" />
    <link href="~/AdminCss/Colors.css" rel="stylesheet" />
    <link href="~/AdminCss/Fonts.css" rel="stylesheet" />
    <link href="~/AdminCss/Site.css" rel="stylesheet" />
    <link href="~/CustomCss/site.css" rel="stylesheet" />
    <style>
        html, body {
            height: 100%;
            font-family: "CenturyGothic", serif !important;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .sidebar {
            min-height: 100vh;
            background-color: #f8f9fa;
            padding-left: 0px !important;
        }


        .nav-item {
            padding-right: 15px !important;
        }

        .nav-link {
            padding: 10px !important;
            border-radius: 0px 20px 20px 0px !important;
        }

        .fas {
            margin-right: .5rem !important;
        } 
        
        .bi-megaphone-fill {
            margin-right: .5rem !important;
        } 
        
        .bi{
            margin-right: .5rem !important;
        }

        .far {
            margin-right: .5rem !important;
        }

        .bi-qr-code {
            margin-right: .5rem !important;
        }

        .fa-solid {
            margin-right: .5rem !important;
        }

        .alignment {
            padding-left: 0px;
        }


        .nav-link {
            padding: 10px !important;
            color: var(--main-color) !important;
            border-radius: 0px 20px 20px 0px !important;
        }

            .nav-link:hover {
                color: #101d649c !important;
            }

            .nav-link.active {
                background-color: var(--main-color);
                color: #fff !important;
                border-radius: 0.25rem;
                border: none;
            }

        header {
            background: var(--main-color);
            color: white;
        }

        footer {
            background: var(--main-color);
            color: white;
        }

        .modal-title {
            color: #c30e0e;
            font-weight: bold;
        }

        .logout {
            background-color: #d30a0a;
            border-radius: 5px;
            color: white !important;
            text-align: center !important;
            padding: 10px;
        }

            .logout:hover {
                background-color: #d30a0ae0;
                color: white !important;
            }

        .link-border-bottom {
            border-bottom: 1px solid #ccc;
        }

        .link-border-top {
            border-top: 1px solid #ccc;
        }

        .user-style {
            border: 2px solid white;
            padding: 4px 10px;
            border-radius: 15px;
        }

        /* Container to align center or customize as needed */
        .toggle-switch {
            position: relative;
            display: inline-block;
            width: 50px;
            height: 24px;
        }

            .toggle-switch input {
                display: none;
            }

        .slider {
            position: relative;
            background-color: #ccc;
            border-radius: 24px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 6px;
            gap: 5px;
        }

        @@media (max-width: 768px) {
            #sidebarContainer {
                position: absolute;
                z-index: 1000;
                left: 0;
                top: 56px;
                transform: translateX(-100%);
                transition: transform 0.3s ease;
                height: calc(100% - 56px);
            }

            .sidebar {
                height: auto !important;
                min-height: auto !important;
            }

            #sidebarContainer.active {
                transform: translateX(0);
            }
        }

        #notificationPanel {
            width: 90vw;
            max-width: 400px;
            max-height: 60vh;
            overflow-y: auto;
            border: 1px solid #ddd;
            right: 0px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
            -webkit-overflow-scrolling: touch;
            top: 50px;
            display: none;
            transition: all 0.3s ease-in-out;
        }

        /* On small screens */
        @@media (max-width: 576px) {
            #notificationPanel {
                width: 270px !important;
                max-width: 100vw !important;
                right: -60px !important;
                top: 45px;
                box-shadow: none;
                border-left: none;
                border-right: none;
                border-top: 1px solid #ddd;
                border-bottom: 1px solid #ddd;
                z-index: 1050;
            }
        }

        .notification {
            color: white;
            text-decoration: none;
            position: relative;
            display: inline-block;
            border-radius: 2px;
            background: none;
            border: none;
        }

            .notification .badge {
                position: absolute;
                top: -6px;
                right: -5px;
                border-radius: 50%;
                background: red;
                color: white;
                font-size: 12px;
                padding: 3px 6px;
                line-height: 1;
                min-width: 18px;
                height: 18px;
                text-align: center;
                display: flex;
                align-items: center;
                justify-content: center;
            }


        .not-header {
            border-bottom: 1px solid #ccc;
            padding-bottom: 10px;
            font-size: 18px;
        }

        .custom-line {
            position: relative;
            display: inline-block;
            padding-bottom: 8px;
        }

            .custom-line::after {
                content: '';
                position: absolute;
                bottom: 0;
                left: 25%;
                width: 50%;
                height: 1px;
                background-color: #ccc;
            }

        .notification-time {
            color: #c30000 !important;
            font-size: 0.75rem;
        }


        .line-container {
            position: relative;
            text-align: center;
            width: 100%;
            max-width: 100%;
            margin-top: 10px;
        }

        .full-screen-container {
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .horizontal-line {
            width: 100%;
            height: 1px;
            background-color: #c1c1c1;
            position: absolute;
            top: 50%;
            left: 0;
        }

        .center-button {
            position: relative;
            display: inline-block;
            background-color: #fff;
            border: 1px solid #101d64;
            padding: 0px 15px;
            font-size: 14px;
            border-radius: 5px;
            z-index: 1;
            cursor: pointer;
        }

        .modal {
            z-index: 1101 !important;
        }

        /* Smooth rotation transition */
        .toggle-icon {
            transition: transform 0.3s ease;
        }

        /* Rotate icon when collapse is shown */
        .collapsing + .toggle-icon,
        .collapse.show + .toggle-icon {
            transform: rotate(180deg);
        }

        .btn-drop-down {
            border: none;
        }

            .btn-drop-down:focus {
                outline: none;
                box-shadow: none;
                border: none;
            }

            .btn-drop-down.show {
                border: none;
            }

        .lang-icon {
            width: 30px;
            height: 25px;
            border-radius: 50%;
            vertical-align: middle;
        }

        .vertical-icon {
            position: fixed;
            bottom: 0%;
            right: 0;
            transform: translateY(-50%);
            z-index: 9999;
            background-color: var(--main-color);
            padding: 10px;
            border-radius: 10px 0 0 10px;
            box-shadow: 0 0 10px rgba(0,0,0,0.15);
        }

            .vertical-icon .icon-link {
                color: white;
                font-size: 24px;
                text-decoration: none;
                display: block;
            }

                .vertical-icon .icon-link:hover {
                    color: #fff;
                    opacity: 0.8;
                }

        .nav-item.parent-active > a.nav-link {
            font-weight: 700;
            color: #0d6efd;
        }

        .nav-link.active {
            font-weight: 700;
            color: #0d6efd;
        }

        /* Style for parent nav-item containing submenu */
        .nav-item.parent-active > a.nav-link {
            font-weight: 700;
            color: #0d6efd;
        }

        /* Style for child nav-item with active link */
        .nav-item.child-active > a.nav-link {
            font-weight: 600 !important;
            color: #101d64 !important;
            background-color: #101d640f !important;
            border-left: 3px solid #101d64;
        }

            .nav-item.child-active > a.nav-link:hover {
                color: #101d649c !important;
            }

        /* Slow down collapse transitions */
        .collapse {
            transition: height 0.4s ease;
        }

        .collapsing {
            transition: height 0.4s ease;
        }

        footer a {
            color: #0d6efd;
            font-weight: 500;
            transition: color 0.3s ease;
        }

            footer a:hover {
                color: #0a58ca;
                text-decoration: underline;
            }
    </style>
</head>
<body>

    <!-- Header -->
    <header class="p-3">
        <div class="container-fluid d-flex justify-content-between align-items-center alignment">

            <!-- Left Section: CMS Title + Welcome -->
            <div class="d-flex align-items-center pe-4 gap-4">
                <button class="btn text-white d-md-none " id="sidebarToggle" style="border: 1px solid; padding: 2px 7px;">
                    <i class="fas fa-bars"></i> <span class="text-white-50" style="font-size:12px;">Menu</span>
                </button>
                <h4 class="mb-0 fw-bold" style="letter-spacing: 1px; font-family: Cinzel, serif;">RentalCar Quran Institute</h4>
            </div>

            <!-- Right: Notification Bell + Theme Toggle -->
            <div class="d-flex align-items-center" style="gap: 20px;">

                <div class="d-none d-md-block">
                    <a href="/Admin/Profile" style="text-decoration:none;">
                        <span class="text-white-50 user-style" style="font-size: 0.95rem;">
                            👋 Welcome, <strong class="text-white">Admin</strong>
                        </span>
                    </a>
                </div>

                <!-- Notification Bell -->
                <div class="position-relative" style="color:black; z-index: 1100;">
                    <button id="notificationToggle" class="notification">
                        <i class="fa-solid fa-bell" style="font-size: 20px;"></i>
                        <span class="badge">
                            4
                        </span>
                    </button>

                    <!-- Notifications Panel -->
                    <div id="notificationPanel"
                         class="position-absolute bg-white shadow rounded p-3">

                        <!-- Header -->
                        <div class="d-flex justify-content-between align-items-center mb-3 not-header">
                            <h6 class="fw-bold mb-0">Notifications</h6>

                            <!-- Close icon -->
                            <button type="button"
                                    id="closeNotification"
                                    class="btn btn-sm border-0"
                                    aria-label="Close">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>

                        <div class="mb-3">
                            <!-- Notification items -->
                            <div class="d-flex align-items-start gap-2 mt-1 custom-line">
                                <div class="w-100">
                                    <p class="mb-0">Machine Learning Full Course 2025</p>
                                    <small class="text-muted notification-time">5 hours ago</small>
                                </div>
                            </div>

                            <div class="d-flex align-items-start gap-2 mt-2 custom-line">
                                <div>
                                    <p class="mb-1">🚨 New AI Tool Alert: Google Stitch AI</p>
                                    <small class="text-muted notification-time">17 hours ago</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </header>



    <!-- Main Content Area -->
    <div class="container-fluid flex-grow-1 d-flex">

        <!-- Vertical Side Icon -->
        <div class="vertical-icon">
            <a href="/Admin/Contact" class="icon-link" title="Contact Us">
                <i class="bi bi-chat-dots-fill"></i>
            </a>
        </div>

        <div class="row flex-grow-1 w-100">
            <!-- Sidebar -->
            <nav id="sidebarContainer" class="col-md-3 col-lg-2 sidebar d-flex flex-column ps-0 pe-3 pt-3 pb-3">
                <!-- Top nav links -->
                <div class="flex-grow-1">
                    <ul class="nav flex-column">

                        <!-- ================= Main Links ================= -->
                        <li class="nav-item mt-2 mb-1 text-muted small ps-2">
                            MAIN LINKS
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Admin" && (string.IsNullOrEmpty(currentAction) || currentAction == "Index") ? "active" : "")"
                               href="/Admin/Index">
                                <i class="fas fa-tachometer-alt"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Admin" && currentAction == "About" ? "active" : "")"
                               href="/Admin/About">
                                <i class="fas fa-info-circle"></i> About
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Admin" && currentAction == "Report" ? "active" : "")"
                               href="/Admin/Report">
                                <i class="fa-solid fa-file-lines"></i> Report
                            </a>
                        </li>

                        <!-- ================= Management ================= -->
                        <li class="nav-item mt-3 mb-1 text-muted small ps-2">MANAGEMENT</li>

                        <!-- Statistics Submenu -->
                        <li class="nav-item">
                            <a class="nav-link d-flex justify-content-between align-items-center"
                               data-bs-toggle="collapse" href="#statisticsSubmenu" role="button"
                               aria-expanded="false" aria-controls="statisticsSubmenu">
                                <span><i class="fas fa-chart-bar"></i> Statistics</span>
                                <i class="fas fa-chevron-down toggle-icon"></i>
                            </a>
                            <div class="collapse ps-4" id="statisticsSubmenu">
                                <ul class="nav flex-column">
                                    <li class="nav-item">
                                        <a class="nav-link @(currentAction == "GeneralStats" ? "active" : "")" href="/Admin/GeneralStats">
                                            <i class="fas fa-chart-line"></i> General Stats
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link @(currentAction == "DetailedStats" ? "active" : "")" href="/Admin/DetailedStats">
                                            <i class="fas fa-chart-pie"></i> Detailed Stats
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </li>

                        <!-- Settings Submenu -->
                        <li class="nav-item">
                            <a class="nav-link d-flex justify-content-between align-items-center"
                               data-bs-toggle="collapse" href="#settingsSubmenu" role="button"
                               aria-expanded="false" aria-controls="settingsSubmenu">
                                <span><i class="fas fa-cog"></i> Settings</span>
                                <i class="fas fa-chevron-down toggle-icon"></i>
                            </a>
                            <div class="collapse ps-4" id="settingsSubmenu">
                                <ul class="nav flex-column">
                                    <li class="nav-item">
                                        <a class="nav-link @(currentAction == "Users" ? "active" : "")" href="/Admin/Users">
                                            <i class="fas fa-users"></i> Users
                                            @*<i class="fas fa-user-shield"></i> Users*@
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link @(currentAction == "ClientReviews" ? "active" : "")" href="/Admin/ClientReviews">
                                            <i class="fas fa-comments"></i> Client Reviews
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </li>

                        <!-- ================= Website ================= -->
                        <li class="nav-item mt-3 mb-1 text-muted small ps-2">WEBSITE</li>

                        <!-- Website Info Submenu -->
                        <li class="nav-item">
                            <a class="nav-link d-flex justify-content-between align-items-center"
                               data-bs-toggle="collapse" href="#websiteInfoSubmenu" role="button"
                               aria-expanded="false" aria-controls="websiteInfoSubmenu">
                                <span><i class="fas fa-globe-americas"></i> Website Info</span>
                                <i class="fas fa-chevron-down toggle-icon"></i>
                            </a>
                            <div class="collapse ps-4" id="websiteInfoSubmenu">
                                <ul class="nav flex-column">
                                    <li class="nav-item">
                                        <a class="nav-link @(currentAction == "Menu" ? "active" : "")" href="/Admin/Menu">
                                            <i class="fas fa-bars"></i> Menu
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link @(currentAction == "Announcements" ? "active" : "")" href="/Admin/Announcements">
                                            <i class="bi bi-megaphone-fill"></i> Announcements
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link @(currentAction == "About" ? "active" : "")" href="/Admin/About">
                                            <i class="bi bi-people-fill"></i>
                                            About Us
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link @(currentAction == "websiteLabels" ? "active" : "")" href="/Admin/websiteLabels">
                                            <i class="bi bi-tags-fill"></i>
                                            Website Labels
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link @(currentAction == "Events" ? "active" : "")" href="/Admin/Events">
                                            <i class="fas fa-calendar-alt"></i> Events
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link @(currentAction == "QuranServices" ? "active" : "")" href="/Admin/QuranServices">
                                            <i class="fas fa-book-reader"></i> Quran Services
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </li>

                        <!-- ================= Contact ================= -->
                        <li class="nav-item mt-3 mb-1 text-muted small ps-2 text-uppercase">General Settings</li>

                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Admin" && (string.IsNullOrEmpty(currentAction) || currentAction == "Contact") ? "active" : "")"
                               href="/Admin/Contact">
                                <i class="bi bi-wechat"></i> Contact
                            </a>
                        </li>

                    </ul>
                </div>


                <!-- Logout button at bottom -->
                <div>
                    <ul class="nav flex-column">
                        <!--<li class="nav-item link-border-top link-border-bottom mb-3" style="padding-top: 3px; padding-bottom: 3px; }">-->
                            <!-- Language Switcher -->


                            <!--<div class="dropdown d-flex justify-content-center">
                                <button class="btn btn-drop-down dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">

                                    <span class="lang-text">
                                        <img class="lang-icon" src="https://flagcdn.com/w40/gb.png" alt="English Flag" /> English
                                    </span>

                                </button>
                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item" href="/Admin/ChangeLanguage?lang=en" style="text-align: start; margin-bottom: 10px;">
                                            <img class="lang-icon" src="https://flagcdn.com/w40/gb.png" alt="English Flag" /> English
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="/Admin/ChangeLanguage?lang=ar" style="text-align:start;">
                                            <img class="lang-icon" src="https://flagcdn.com/w40/sa.png" alt="Arabic Flag" /> العربية
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </li>-->

                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Admin" && currentAction == "Logout" ? "active" : "") logout"
                               href="#" data-bs-toggle="modal" data-bs-target="#logoutModal">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                                     fill="currentColor" class="bi bi-box-arrow-right" viewBox="0 0 16 16">
                                    <path fill-rule="evenodd"
                                          d="M10 12.5a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-9a.5.5 0 0 1
                                             .5-.5h8a.5.5 0 0 1 .5.5v2a.5.5 0 0 0
                                             1 0v-2A1.5 1.5 0 0 0 9.5 2h-8A1.5 1.5 0 0 0
                                             0 3.5v9A1.5 1.5 0 0 0 1.5 14h8a1.5 1.5 0 0 0
                                             1.5-1.5v-2a.5.5 0 0 0-1 0z" />
                                    <path fill-rule="evenodd"
                                          d="M15.854 8.354a.5.5 0 0 0 0-.708l-3-3a.5.5
                                             0 0 0-.708.708L14.293 7.5H5.5a.5.5 0 0 0
                                             0 1h8.793l-2.147 2.146a.5.5
                                             0 0 0 .708.708z" />
                                </svg>
                                Logout
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>


            <!-- Modal -->
            <div class="modal fade" id="logoutModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h1 class="modal-title fs-5" id="staticBackdropLabel">Confirm Logout</h1>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            Are you sure you want to log out?
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <a asp-controller="Admin" asp-action="Logout" class="btn btn-danger">Logout</a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Main Content -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Footer -->
    <footer class="p-3 mt-auto">
        <div class="container">
            <div class="row align-items-center">

                <!-- Empty column (left spacer) -->
                <div class="col-md-4 d-none d-md-block"></div>

                <!-- Center text -->
                <div class="col-12 col-md-4 text-center">
                    &copy; @DateTime.Now.Year ~ RentalCar Quran Institute. All rights Reserved.
                </div>

                <!-- Right link -->
                <div class="col-12 col-md-4 text-center text-md-end mt-2 mt-md-0">
                    <a href="#"
                       class="text-decoration-none fw-semibold"
                       data-bs-toggle="modal"
                       data-bs-target="#contactModal"
                       style="color: var(--secondary-color); "
                       >
                        Contact RentalCar Team
                    </a>
                </div>

            </div>
        </div>
    </footer>



    <!--Contact modal-->
    <div class="modal fade" id="contactModal" tabindex="-1" aria-labelledby="contactModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="contactModalLabel">Contact RentalCar Team</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-start">
                    <p><strong>Email:</strong> <a href="mailto:support@RentalCar.com">support@RentalCar.com</a></p>
                    <p><strong>Phone:</strong> <a href="tel:+9611234567">+961 1 234 567</a></p>
                    <p><strong>Website:</strong> <a href="https://www.RentalCar.com" target="_blank">www.RentalCar.com</a></p>
                </div>
            </div>
        </div>
    </div>


    @await RenderSectionAsync("Scripts", required: false)


    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const activeLink = document.querySelector('.nav-link.active');

            if (activeLink) {
                const submenu = activeLink.closest('.collapse');
                if (submenu) {
                    // Animate opening using Bootstrap's Collapse API
                    const bsCollapse = new bootstrap.Collapse(submenu, {
                        toggle: false // Prevent auto-toggle so we can control it
                    });
                    bsCollapse.show(); // Triggers the transition

                    // Expand the toggle button
                    const parentToggle = document.querySelector('[href="#' + submenu.id + '"]');
                    if (parentToggle) {
                        parentToggle.setAttribute('aria-expanded', 'true');
                    }

                    // Add class to parent nav-item
                    const parentNavItem = submenu.closest('.nav-item');
                    if (parentNavItem) {
                        parentNavItem.classList.add('parent-active');
                    }

                    // Add class to child nav-item
                    const childNavItem = activeLink.closest('.nav-item');
                    if (childNavItem) {
                        childNavItem.classList.add('child-active');
                    }
                }
            }

            // ✅ Collapse the current submenu when any child link is clicked
            document.querySelectorAll('.sidebar .collapse').forEach(function (submenu) {
                submenu.querySelectorAll('a.nav-link').forEach(function (link) {
                    link.addEventListener('click', function () {
                        const instance = bootstrap.Collapse.getOrCreateInstance(submenu);
                        instance.hide();
                    });
                });
            });


            // ✅ Optional icon rotation (statistics example)
            // Select all nav links that toggle a collapse
            const toggleLinks = document.querySelectorAll('.nav-link[data-bs-toggle="collapse"]');

            toggleLinks.forEach(link => {
                const collapseId = link.getAttribute('href').substring(1); // remove the # from href
                const collapseElement = document.getElementById(collapseId);
                const icon = link.querySelector('.toggle-icon');

                if (collapseElement && icon) {
                    collapseElement.addEventListener("show.bs.collapse", function () {
                        icon.style.transform = "rotate(180deg)";
                        icon.style.transition = "transform 0.3s ease";
                    });

                    collapseElement.addEventListener("hide.bs.collapse", function () {
                        icon.style.transform = "rotate(0deg)";
                        icon.style.transition = "transform 0.3s ease";
                    });
                }
            });
        });

        // ✅ Sidebar toggle
        const sidebarToggle = document.getElementById('sidebarToggle');
        const sidebar = document.getElementById('sidebarContainer');

        if (sidebarToggle && sidebar) {
            sidebarToggle.addEventListener('click', (e) => {
                e.stopPropagation();
                sidebar.classList.toggle('active');
            });

            document.addEventListener('click', (e) => {
                if (!sidebar.contains(e.target) && !sidebarToggle.contains(e.target)) {
                    sidebar.classList.remove('active');
                }
            });
        }

        // ✅ Notification toggle
        const toggleBtn = document.getElementById('notificationToggle');
        const panel = document.getElementById('notificationPanel');
        const closeBtn = document.getElementById('closeNotification');

        if (toggleBtn && panel) {
            toggleBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                panel.style.display =
                    panel.style.display === 'none' || panel.style.display === ''
                        ? 'block'
                        : 'none';
            });

            // Close when clicking outside
            document.addEventListener('click', function (e) {
                if (!toggleBtn.contains(e.target) && !panel.contains(e.target)) {
                    panel.style.display = 'none';
                }
            });
        }

        // Close on icon click
        if (closeBtn) {
            closeBtn.addEventListener('click', () => {
                panel.style.display = 'none';
            });
        }
    </script>

</body>
</html>
