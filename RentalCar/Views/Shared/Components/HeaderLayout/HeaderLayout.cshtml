            font-size: 16px !important;
        }

    }*/

    .website-image-top-header {
        width: 70px; /* fixed width */
        height: 70px; /* fixed height */
        border-radius: 50%; /* circle */
        margin-inline-start: 0; /* space before the image, if needed */
        margin-inline-end: 10px; /* space after the image (right in LTR, left in RTL) */
        object-fit: cover; /* ensures image fills the box */
    }

</style>

<body dir="@ViewBag.Direction">

    @{
        var announcements = ViewBag.Announcements as List<RentalCar.DomainLayer.DTO.AnnouncementDTO>;
    }

    @if (announcements != null && announcements.Count > 0)
    {
        <div class="top-banner">
            <div class="announcement-carousel owl-carousel">
                @foreach (var announcement in announcements)
                {
                <div class="carousel-item">
                    <span class="alert-icon">
                        <i class="@announcement.Icon banner-icon"></i>
                    </span>
                    @Html.Raw(announcement.Content)
                </div>
                }
            </div>
        </div>
    }



    @*<div class="top-banner">
            { وَلَقَدْ يَسَّرْنَا الْقُرآنَ لِلذِّكْرِ فَهَلْ مِن مُدَّكِرٍ }
        </div>*@

    <header>
        <nav class="navbar navbar-expand-lg">
            <div class="container-fluid">

                <!-- Logo + title -->
                <a class="navbar-brand" href="/">
                    <img src="~/Images/website-icon.jpeg"
                         alt="RentalCar"
                         class="d-inline-block align-text-top website-image-top-header">
                    @ViewBag.WebsiteTitle.Data
                </a>

                <!-- Mobile Donate + Toggler -->
                <div class="mobile-actions ms-auto">
                    @*<a class="btn btn-warning d-lg-none" href="/Donate">Donate</a>*@
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                            data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false"
                            aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                </div>

                <!-- Collapsible Content -->
                <div class="collapse navbar-collapse" id="navbarNav">

                    <!-- Left main links -->
                    @{
                        List<Menu> menuList = ViewBag.Menu as List<Menu>;
                        List<ProductsMenu> productsList = ViewBag.ProductsMenu as List<ProductsMenu>;
                        string currentUrl = ViewBag.CurrentUrl;
                        string alignItem = ViewBag.AlignItem ?? "left";
                    }

                    <ul class="navbar-nav d-lg-flex ms-5 menu-items">

                        @if (menuList != null && menuList.Any())
                        {
                            foreach (var item in menuList)
                            {
                                string activeClass = (currentUrl == item.Action) ? "active" : "";

                                /* -------------------------
                                   MENU ITEM WITH SUB-MENU
                                   ------------------------- */
                                if (item.is_subTest == "True")
                                {
                                    <li class="nav-item dropdown me-2">
                                        <a class="nav-link dropdown-toggle @activeClass responsiveMenu linkDark"
                                           href="@item.Action"
                                           data-bs-toggle="dropdown">
                                            @item.Title
                                        </a>

                                        <ul class="dropdown-menu fade-down m-0">
                                            @if (productsList != null && productsList.Any())
                                            {
                                                foreach (var p in productsList)
                                                {
                                                    <li>
                                                        <a href="@p.Action"
                                                           class="dropdown-item responsiveMenu linkDark"
                                                           style="text-align:@alignItem"
                                                           target="@(p.Id == 316 ? "_blank" : null)">
                                                            @Html.Raw(p.Title)
                                                        </a>
                                                    </li>
                                                }
                                            }
                                        </ul>
                                    </li>
                                }

                                /* -------------------------
                                   NORMAL MENU ITEM
                                   ------------------------- */
                                else
                                {
                                    <li class="nav-item me-2">
                                        <a href="@item.Action"
                                           class="nav-link @activeClass responsiveMenu linkDark">
                                            @item.Title
                                        </a>
                                    </li>
                                }
                            }
                        }
                    </ul>

                    <!-- Right side items (language + donate desktop) -->
                    <ul class="navbar-nav ms-auto align-items-center mt-2 mt-lg-0 right-side small-screen-nav">
                        <!-- Language dropdown -->
                        <li class="nav-item dropdown" style="font-weight:bold;font-size:18px;">
                            <a class="nav-link dropdown-toggle main-language" id="languageDropdown"
                               role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-globe" style="color:var(--secondary-color);"></i> @(ViewBag.CurrentLanguage.Name ?? "English")
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end font-weight-bold" aria-labelledby="languageDropdown">
                                @foreach (var lang in ViewBag.languages)
                                {
                                    var isActive = ViewBag.CurrentLanguage.LanguageCode.ToString().ToLower() == lang.LanguageCode.ToLower();
                                    <li>
                                        <a class="dropdown-item language-link @(isActive ? "active-language" : "")"
                                           onclick="setLanguage('@lang.LanguageCode')">
                                            @lang.Name
                                        </a>
                                    </li>
                                }
                            </ul>
                        </li>

                        <!-- Donate button desktop -->
                        @*<li class="nav-item d-none d-lg-block ms-2">
                                <a href="#" class="block">
                                    <span></span>
                                    <span></span>
                                    <span></span>
                                    <span></span>
                                    Donate
                                </a>
                            </li>*@
                        <li class="nav-item d-lg-block ms-2">
                            <a href="#" class="block">
                                <span></span>
                                <span></span>
                                <span></span>
                                <span></span>
                                @ViewBag.DonateLabel.Data
                            </a>
                        </li>
                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <script>
        function setLanguage(lang) {
            fetch('/Home/SetLanguage', {
                method: 'POST',
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: `culture=${lang}&returnUrl=${encodeURIComponent(window.location.pathname)}`
            }).then(() => location.reload());
        }

        document.addEventListener("DOMContentLoaded", function () {
            const dropdown = document.querySelector("#languageDropdown");

            function handleDesktop() {
                if (window.innerWidth >= 992) {
                    dropdown.removeAttribute("data-bs-toggle");
                    dropdown.addEventListener("click", stopClick);
                } else {
                    dropdown.setAttribute("data-bs-toggle", "dropdown");
                    dropdown.removeEventListener("click", stopClick);
                }
            }

            function stopClick(e) {
                e.preventDefault();
            }

            handleDesktop();
            window.addEventListener("resize", handleDesktop);
        });

        $(document).ready(function () {
             var isRtl = '@ViewBag.Direction'.toLowerCase() === 'rtl';

            $('.announcement-carousel').owlCarousel({
                items: 1,
                loop: true,
                margin: 0,

                autoplay: true,
                autoplayTimeout: 5000,
                smartSpeed: 600,

                autoplayHoverPause: true,
                dots: false,
                nav: false,

                animateIn: 'fadeIn',
                animateOut: false,

                rtl: isRtl   // dynamically set rtl
            });
        });




    </script>
</body>
