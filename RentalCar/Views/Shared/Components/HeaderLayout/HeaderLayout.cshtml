<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.theme.default.min.css">

<!-- Animate.css for fadeIn -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">

<!-- jQuery -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

<!-- Owl Carousel JS -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/owl.carousel.min.js"></script>


<style>

    .top-banner {
        width: 100%;
        height: 50px;
        background-image: url('/Images/Islamic-Background-Top-Banner.png');
        background-size: cover;
        background-position: center;
        display: flex;
        align-items: center;
        overflow: hidden;
        position: fixed;
        top: 0;
        left: 0;
        z-index: 10000;
        color: white;
        font-size: 18px;
        font-weight: 600;
    }

    .carousel-item {
        display: flex;
        align-items: center;
        justify-content: center;
        white-space: nowrap;
    }

    [dir="ltr"] .alert-icon {
        margin-right: 6px;
        display: inline-flex;
        align-items: center;
    }
    
    [dir="rtl"] .alert-icon {
        margin-left: 6px;
        display: inline-flex;
        align-items: center;
    }

        .alert-icon i {
            color: var(--secondary-color);
            font-size: 18px;
        }

    .announcement-carousel .owl-item {
        will-change: opacity, transform;
        transition: opacity 0.6s ease-out, transform 0.6s ease-out;
        transform: translateY(8px);
        opacity: 0;
    }

        .announcement-carousel .owl-item.active {
            transform: translateY(0);
            opacity: 1;
        }

    .announcement-carousel u {
        text-decoration: underline; 
        text-underline-offset: 4px; 
        text-decoration-thickness: 2px; 
        text-decoration-color: var(--secondary-color);
    }

    /* Keyframes for fade in/out */
    /* @@keyframes fadeOnly {
        0% { opacity: 0; }
        10% { opacity: 1; }
        40% { opacity: 1; }
        50% { opacity: 0; }
        100% { opacity: 0; }
    }*/


    /* @@keyframes softGlow {
        0% {
            opacity: 0.7;
            filter: drop-shadow(0 0 2px rgba(255,255,255,0.4));
        }

        50% {
            opacity: 1;
            filter: drop-shadow(0 0 6px rgba(255,255,255,0.9));
        }

        100% {
            opacity: 0.7;
            filter: drop-shadow(0 0 2px rgba(255,255,255,0.4));
        }
    }*/



    body {
        padding-top: 120px; /* space for banner + navbar */
    }

    /* Keep your existing navbar CSS below */
    .navbar {
        background-color: var(--bg-color);
        position: fixed;
        top: 50px; /* push navbar below banner */
        left: 0;
        width: 100%;
        z-index: 9999;
        box-shadow: 0 4px 8px 0 rgba(0, 0, 0, 0.2), 0 6px 20px 0 rgba(0, 0, 0, 0.19);
        padding-top: 0px;
        padding-bottom: 0px;
    }


    /* Logo + brand */
    .navbar-brand {
        color: var(--primary-color);
        font-weight: bold;
        display: flex;
        align-items: center;
        flex-shrink: 0;
    }

        .navbar-brand:hover {
            color: var(--primary-color);
        }

    [dir="ltr"] .navbar-brand {
        font-family: "Cinzel", serif;
    }

/*    [dir="rtl"] .navbar-brand {
        font-family: "Hafs", serif;
    }*/

    /* Navbar links */
    .navbar-nav.d-lg-flex .nav-link {
        color: var(--primary-color);
        position: relative;
        transition: color 0.3s;
        font-size: 18px;
        font-weight: 500;
    }

        .navbar-nav.d-lg-flex .nav-link::after {
            content: "";
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 0;
            height: 5px;
            background-color: transparent;
            border-radius: 3px;
            transition: width 0.3s ease, background-color 0.3s ease;
        }

        .navbar-nav.d-lg-flex .nav-link.active {
            color: var(--secondary-color);
        }

            .navbar-nav.d-lg-flex .nav-link.active::after {
                width: 50%;
                background-color: var(--secondary-color);
            }

        .navbar-nav.d-lg-flex .nav-link:not(.active):hover::after {
            width: 50%;
            background-color: var(--primary-color);
        }

    /* Toggler */
    .navbar-toggler {
        border-color: var(--primary-color);
    }

    /* Dropdown menu */
    .dropdown-toggle {
        font-weight: bold;
    }

    .dropdown-menu {
        background-color: #fff;
        border-radius: 10px;
        padding: 8px;
        border: 1px solid #ddd;
        min-width: 160px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
    }

    .dropdown-item {
        padding: 8px 12px;
        border-radius: 6px;
        font-weight: bold;
        color: var(--primary-color);
        transition: all 0.25s ease;
    }

    .dropdown-menu li {
        margin-bottom: 5px;
    }

    .dropdown-item:hover {
        color: var(--secondary-color);
    }

    .active-language {
        font-weight: 700 !important;
        color: var(--primary-color);
        background-color: #efefef;
        border-radius: 5px;
        padding: 8px 12px;
        transition: all 0.3s ease;
    }

        .active-language:hover {
            color: var(--secondary-color);
            background-color: #efefef;
        }

    /* Donate buttons */
    .btn-warning {
        background-image: linear-gradient(135deg, var(--accent-color) 50%, #e7ce76 80%);
        color: var(--primary-color);
        font-weight: 600;
        transition: all 0.3s ease;
        border: none;
    }

        .btn-warning:hover {
            background-color: var(--accent-color);
            color: var(--primary-color);
        }

    .nav-item a.block {
        position: relative;
        padding: 12px 30px;
        color: #1d214ec4;
        /*background-image: linear-gradient(135deg, var(--accent-color) 50%, #e7ce76 80%);*/
        background: linear-gradient( 135deg, var(--secondary-color) 0%, var(--accent-color) 40%, #e7c875 70%, #b9933b 100% );
        text-decoration: none;
        font-weight: 700;
        overflow: hidden;
        display: inline-block;
        border-radius: 0.35rem;
    }

    .nav-item a span {
        position: absolute;
        display: block;
        color: var(--secondary-color)
    }

        .nav-item a span:nth-child(1) {
            top: 0;
            left: 0;
            width: 100%;
            height: 2px;
            background: linear-gradient(to right, var(--primary-color), var(--primary-color));
            animation: animate1 2s linear infinite;
            border-radius: 0.35rem;
        }

    @@keyframes animate1 {
        0% {
            transform: translateX(-100%);
        }

        100% {
            transform: translateX(100%);
        }
    }

    .nav-item a span:nth-child(2) {
        top: 0;
        right: 0;
        width: 2px;
        height: 100%;
        background: linear-gradient(to bottom, var(--primary-color), var(--primary-color));
        animation: animate2 2s linear infinite;
        animation-delay: 1s;
        border-radius: 0.35rem;
    }

    @@keyframes animate2 {
        0% {
            transform: translateY(-100%);
        }

        100% {
            transform: translateY(100%);
        }
    }

    .nav-item a span:nth-child(3) {
        bottom: 0;
        left: 0;
        width: 100%;
        height: 2px;
        background: linear-gradient(to left, var(--primary-color), var(--primary-color));
        animation: animate3 2s linear infinite;
        border-radius: 0.35rem;
    }

    @@keyframes animate3 {
        0% {
            transform: translateX(100%);
        }

        100% {
            transform: translateX(-100%);
        }
    }

    .nav-item a span:nth-child(4) {
        top: 0;
        left: 0;
        width: 2px;
        height: 100%;
        background: linear-gradient(to top, var(--primary-color), var(--primary-color));
        animation: animate4 2s linear infinite;
        animation-delay: 1s;
        border-radius: 0.35rem;
    }

    @@keyframes animate4 {
        0% {
            transform: translateY(100%);
        }

        100% {
            transform: translateY(-100%);
        }
    }


    /* Responsive adjustments */
    @@media (max-width: 991.98px) {
        /*body {
            padding-top: 0px;
        }*/

        .top-banner {
            font-size: 16px !important;
        }

        .navbar .container-fluid {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .navbar-brand {
            font-size: 18px;
        }

        .mobile-actions {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        [dir="rtl"] .mobile-actions{
            margin-right: auto !important;
            margin-left: unset !important;
        }

        .navbar-nav.d-lg-flex .nav-link::after {
            content: none !important;
        }

        .navbar-nav {
            justify-content: center !important;
            text-align: center;
        }

        .menu-items .nav-link:hover {
            color: var(--secondary-color);
        }


        .small-screen-nav {
            margin-left: 3rem !important;
            position: relative;
        }

        .right-side::before {
            content: "";
            position: absolute;
            top: 0;
            left: -3rem; /* cancel the margin */
            width: calc(100% + 3rem); /* full width */
            height: 1px;
            background-color: #ccc;
        }
    }

    @@media (min-width: 992px) {
        .navbar-nav .dropdown:hover .dropdown-menu {
            display: block;
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }
    }

    /* .language-link:after {
        background-color: var(--bg-color) !important;
    }*/

    .main-language {
        color: var(--primary-color);
        font-weight: 500;
    }

        .main-language:hover {
            color: var(--primary-color);
        }

    .language-link:focus-visible {
        background-color: var(--primary-color) !important;
    }

    [dir="rtl"] .language-link {
        text-align: right;
    }

    /*Arabic*/
    [dir="rtl"] .right-side {
        margin-right: auto !important;
        margin-left: unset !important;
    }

    /*@@media (min-width: 992px) and (max-width: 1210px) {*/
