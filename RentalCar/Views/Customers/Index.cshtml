@using RentalCar.DomainLayer.Models
@model List<Customer>
@{
    Layout = "_AdminLTELayout";
    ViewData["Title"] = "Customers";
    var isRtl = (bool?)ViewData["IsRtl"] ?? false;
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
    <style>#cuTable th, #cuTable td { text-align:center !important; vertical-align:middle; }</style>
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6"><h1 class="m-0"><i class="fas fa-users mr-2"></i>Customers</h1></div>
            <div class="col-sm-6">
                <ol class="breadcrumb @(isRtl ? "float-sm-left" : "float-sm-right")">
                    <li class="breadcrumb-item"><a href="/Admin/Index">Home</a></li>
                    <li class="breadcrumb-item active">Customers</li>
                </ol>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        @if (ViewBag.ErrorMessage != null) { <div class="alert alert-danger">@ViewBag.ErrorMessage</div> }
        @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
        @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="card-title mt-1"><i class="fas fa-list mr-1"></i> All Customers</h3>
                <a class="btn btn-success btn-sm" href="/Customers/Create"><i class="fas fa-plus-circle mr-1"></i> Add Customer</a>
            </div>
            <div class="card-body">
                <table id="cuTable" class="table table-striped table-bordered nowrap" style="width:100%">
                    <thead><tr><th>#</th><th>Name</th><th>Phone</th><th>Email</th><th>Nationality</th><th>License Expiry</th><th>Action</th></tr></thead>
                    <tbody>
                        @{ var count = 1; }
                        @foreach (var c in Model)
                        {
                            <tr>
                                <td>@count</td>
                                <td>@(!string.IsNullOrEmpty(c.FullName) ? c.FullName : (string.IsNullOrEmpty(c.Email) ? "-" : c.Email))</td>
                                <td>@(string.IsNullOrEmpty(c.Phone) ? "-" : c.Phone)</td>
                                <td>@(string.IsNullOrEmpty(c.Email) ? "-" : c.Email)</td>
                                <td>@(c.Nationality?.Name ?? "-")</td>
                                <td>@(c.LicenseExpiryDate == default(DateTime) ? "-" : c.LicenseExpiryDate.ToString("yyyy-MM-dd"))</td>
                                <td>
                                    <a class="btn btn-sm btn-warning" href="/Customers/Edit/@c.Id"><i class="fas fa-edit"></i></a>
                                    <form method="post" asp-action="Delete" asp-controller="Customers" class="d-inline"
                                          onsubmit="return confirm('Delete this customer?');">
                                        <input type="hidden" name="id" value="@c.Id" />
                                        <button type="submit" class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                            count++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script>
        $(function () {
            $('#cuTable').DataTable({ responsive: true, pageLength: 10, lengthMenu: [5,10,25,50],
                language: { emptyTable: "No customers found" }, columnDefs: [{ orderable:false, targets:[6] }] });
        });
    </script>
}
