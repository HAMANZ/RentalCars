@using RentalCar.DomainLayer.DTO
@model List<RepairTypeDTO>
@{
    Layout = "_AdminLTELayout";
    ViewData["Title"] = "Repair Types";
    var isRtl = (bool?)ViewData["IsRtl"] ?? false;
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
    <style>#rtTable th, #rtTable td { text-align:center !important; vertical-align:middle; }</style>
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6"><h1 class="m-0"><i class="fas fa-tools mr-2"></i>Repair Types</h1></div>
            <div class="col-sm-6">
                <ol class="breadcrumb @(isRtl ? "float-sm-left" : "float-sm-right")">
                    <li class="breadcrumb-item"><a href="/Admin/Index">Home</a></li>
                    <li class="breadcrumb-item active">Repair Types</li>
                </ol>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        @if (ViewBag.ErrorMessage != null) { <div class="alert alert-danger">@ViewBag.ErrorMessage</div> }
        @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
        @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="card-title mt-1"><i class="fas fa-list mr-1"></i> All Repair Types</h3>
                <div>
                    <a class="btn btn-info btn-sm" href="/RepairTypes/Import"><i class="fas fa-file-excel mr-1"></i> Import from Excel</a>
                    <a class="btn btn-success btn-sm" href="/RepairTypes/Create"><i class="fas fa-plus-circle mr-1"></i> Add</a>
                </div>
            </div>
            <div class="card-body">
                <table id="rtTable" class="table table-striped table-bordered nowrap" style="width:100%">
                    <thead><tr><th>#</th><th>Name</th><th>Name (Arabic)</th><th>Code</th><th>Category</th><th>Active</th><th>Action</th></tr></thead>
                    <tbody>
                        @{ var count = 1; }
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@count</td>
                                <td>@(string.IsNullOrEmpty(item.Name) ? "-" : item.Name)</td>
                                <td>@(string.IsNullOrEmpty(item.Name_ar) ? "-" : item.Name_ar)</td>
                                <td>@(string.IsNullOrEmpty(item.Code) ? "-" : item.Code)</td>
                                <td>@(string.IsNullOrEmpty(item.RepairCategoryName) ? "-" : item.RepairCategoryName)</td>
                                <td>@(item.IsActive ? "Yes" : "No")</td>
                                <td>
                                    <a class="btn btn-sm btn-warning" href="/RepairTypes/Edit/@item.Id"><i class="fas fa-edit"></i></a>
                                    <form method="post" asp-action="Delete" asp-controller="RepairTypes" class="d-inline"
                                          onsubmit="return confirm('Delete this repair type?');">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                            count++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script>
        $(function () {
            $('#rtTable').DataTable({ responsive: true, pageLength: 10, lengthMenu: [5,10,25,50],
                language: { emptyTable: "No repair types found" }, columnDefs: [{ orderable:false, targets:[6] }] });
        });
    </script>
}
