@using RentalCar.DomainLayer.CommonObjects;
@using RentalCar.DomainLayer.DTO;
@model DynamicResponse<AppSettingsDTO>

@{
    ViewData["Title"] = "Terms & Conditions";

    ViewBag.View = "Edit Terms & Conditions";
}


<hr />



<style>
    .form-actions {
        display: block;
        padding: 13px 14px 15px;
        border-top: 1px solid rgba(0,0,0,.1);
        background: rgb(255, 255, 255);
        margin-top: 25px;
        margin-left: -13px;
        margin-right: -13px;
        margin-bottom: -13px;
        text-align: right;
    }

    label {
        font-weight: 600
    }

    a {
        color: black
    }

    h2 {
        color: black;
        font-size: 20px;
        font-family: Arial, Helvetica, sans-serif;
    }

    .in {
        width: 100px;
        display: inline-flex;
        justify-content: flex-start;
        align-items: flex-start;
    }

    /*.id{
                    display:inline-block;
                }*/

</style>
<div>
    <div class="content">

        <div class="container-fluid">

            @Html.Partial("_PartialPageHeader")
            @using (Html.BeginForm("UpdateTermsConditions", "Admin", FormMethod.Post, new { @class = "id", enctype = "multipart/form-data" }))
    {

            <div id="content">
                <section id="widget-grid" class="">
                    <div class="row">
                        <article class="col-sm-12 col-md-12 col-lg-10">
                            <div class="widget-body">
                                <fieldset>
                                    <div class="row">

                                        <input class="form-control" placeholder="Id" name="Id" value="@Model.Data.Id" type="hidden">

                                            <div class="col-xs-9 col-lg-7">
                                                <div class="form-group">
                                                     <label class="col-md-5"> Terms & Conditions</label>
                                                    <textarea name="TermsConditions" style="display:none" id="txteditorvalue">@Model.Data.RefundPolicy</textarea>
                                                    <textarea style="height: 200px" name="Text"></textarea>
                                                </div>
                                            </div>
                                    </div>
                                </fieldset>
                                </div>
                                  <div class="form-actionss" align="center">
                                        <div class="row">
                                            <div class="col-md-12">
                                                <button class="btn btn-primary submit-form" type="submit" style="align-items:center">
                                                    <i class="fa fa-save"></i>
                                                    Update
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                        </article>
                    </div>
                </section>
            </div>

        }
    </div>
    </div>
    </div>


<script src="~/Scripts/cms/plugin/ckeditor/ckeditor.js"></script>
<script>

    var bodyEditor;



    function SetContents() {
        // Get the editor instance that we want to interact with.
        var editor = CKEDITOR.instances.Text;
        // Set editor contents (replace current contents).
        // http://docs.ckeditor.com/#!/api/CKEDITOR.editor-method-setData
        editor.setData($("#txteditorvalue").text());
    }

    function GetContents() {
        // Get the editor instance that you want to interact with.
        var editor = CKEDITOR.instances.Text;
        // Get editor contents
        // http://docs.ckeditor.com/#!/api/CKEDITOR.editor-method-getData
        $("#txteditorvalue").html(editor.getData());
    }

    $(function () {
        //alert($("#txteditorvalue").html());
        //$("#txtEditor").Editor();
        bodyEditor = CKEDITOR.replace('Text');
        SetContents();

        // Handle when the Source changes.
        bodyEditor.on('mode', function () {
            if (this.mode == 'source') {
                var editable = bodyEditor.editable();
                editable.attachListener(editable, 'input', function () {
                    GetContents()
                });
            }
        });

        // Handle when the HTML changes.
        bodyEditor.on('change', function () {
            GetContents()
        });

    });


    GetContents();

</script>