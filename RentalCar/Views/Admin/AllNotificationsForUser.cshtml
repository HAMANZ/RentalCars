@using RentalCar.DomainLayer.CommonObjects;
@using RentalCar.DomainLayer.DTO;
@model List<DefinedDTO>

@{
    Layout = "_AdminLTELayout";
    ViewData["Title"] = "User Notifications";
    var isRtl = (bool?)ViewData["IsRtl"] ?? false;
}

<!-- Content Header -->
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0"><i class="far fa-bell mr-2"></i>User Notifications</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb @(isRtl ? "float-sm-left" : "float-sm-right")">
                    <li class="breadcrumb-item"><a href="/Admin/Index">Home</a></li>
                    <li class="breadcrumb-item active">User Notifications</li>
                </ol>
            </div>
        </div>
    </div>
</section>

<!-- Main content -->
<section class="content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-body">

                <div class="row mb-3">
                    <div class="col-sm-4">
                        <label>Select User</label>
                        <select id="UserId" class="form-control form-control-sm">
                            @if (Model != null && Model.Count != 0)
                            {
                                foreach (DefinedDTO item in Model)
                                {
                                    <option value="@item.Code">@item.Name</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <div class="table-responsive">
                    <table id="example1" class="table table-bordered table-hover display">
                        <thead>
                            <tr>
                                <th style="width: 90px">Subject</th>
                                <th style="width: 120px">Body</th>
                                <th style="width: 90px">Date</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script type="text/javascript">
        $(function () {
            GetCustomers();
            $("#UserId").change(function () {
                $("#example1 tbody").html('');
                GetCustomers();
            });
        });

        function GetCustomers() {
            var UserId = $.trim($("#UserId").val());

            $.ajax({
                type: "POST",
                url: "/Admin/SearchNotificationsUser",
                data: { id: UserId },
                dataType: "json",
                success: function (customers) {
                    var table = $("#example1");
                    table.find("tr:not(:first)").remove();
                    $.each(customers, function (i, customer) {
                        var body = $("#example1 tbody");
                        var row = body[0].insertRow(-1);
                        $(row).append("<td />");
                        $(row).find("td").eq(0).html(customer.notificationSubject);
                        $(row).append("<td />");
                        $(row).find("td").eq(1).html(customer.notificationContent);
                        $(row).append("<td />");
                        $(row).find("td").eq(2).html(customer.date);
                    });
                }
            });
        }
    </script>
}
