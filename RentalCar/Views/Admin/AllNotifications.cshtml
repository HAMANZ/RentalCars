@using RentalCar.DomainLayer.CommonObjects;
@using RentalCar.DomainLayer.DTO;
@model DynamicResponse<List<NotificationsDTO>>

@{
    ViewData["Title"] = "AllNotifications";
    ViewBag.View = "Notification";
}






<div id="content">
    <h2>All Notifications</h2>
    <p>&nbsp;</p>
    <p>&nbsp;</p>

    <div class="container-fluid">
       
       @Html.Partial("_PartialPageHeader")
            <section id="widget-grid" class="">
                <div class="row">
                    <article class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
                        <div class="jarviswidget-editbox">
                        </div>
                        <div class="widget-body no-padding">
                            <table id="dt_basic" class="table table-striped table-bordered table-hover" width="100%">
                                <thead>
                                    <tr>
                                        <th>Id</th>
                                        <th>Notification Subject</th>
                                        <th>Notification Content</th>
                                        <th>Is Seen</th>
                                        <th>Created at</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Data)
                                    {
                                        <tr>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.Id)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.NotificationSubject)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.NotificationContent)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.Is_Seen)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.Date)
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </article>
                </div>
            </section>
      
    </div>
</div>
              