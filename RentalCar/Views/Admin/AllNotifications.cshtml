@using RentalCar.DomainLayer.CommonObjects;
@using RentalCar.DomainLayer.DTO;
@model DynamicResponse<List<NotificationsDTO>>

@{
    Layout = "_AdminLTELayout";
    ViewData["Title"] = "All Notifications";
    var isRtl = (bool?)ViewData["IsRtl"] ?? false;
}

<!-- Content Header -->
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0"><i class="far fa-bell mr-2"></i>All Notifications</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb @(isRtl ? "float-sm-left" : "float-sm-right")">
                    <li class="breadcrumb-item"><a href="/Admin/Index">Home</a></li>
                    <li class="breadcrumb-item active">All Notifications</li>
                </ol>
            </div>
        </div>
    </div>
</section>

<!-- Main content -->
<section class="content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title mt-1"><i class="fas fa-list mr-1"></i> Notifications</h3>
            </div>
            <div class="card-body table-responsive p-0">
                <table id="dt_basic" class="table table-striped table-bordered table-hover mb-0" width="100%">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Notification Subject</th>
                            <th>Notification Content</th>
                            <th>Is Seen</th>
                            <th>Created at</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Data)
                        {
                            <tr>
                                <td>@Html.DisplayFor(modelItem => item.Id)</td>
                                <td>@Html.DisplayFor(modelItem => item.NotificationSubject)</td>
                                <td>@Html.DisplayFor(modelItem => item.NotificationContent)</td>
                                <td>@Html.DisplayFor(modelItem => item.Is_Seen)</td>
                                <td>@Html.DisplayFor(modelItem => item.Date)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>
