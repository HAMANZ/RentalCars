@using RentalCar.DomainLayer.DTO
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Users";
}

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />

<style>
    .section-title {
        color: var(--secondary-color);
    }

    th, td {
        text-align: center !important;
        vertical-align: middle;
    }

        td img {
            display: block;
            margin-left: auto;
            margin-right: auto;
            width: 50px;
            height: 50px;
            object-fit: cover;
            border-radius: 50%;
        }

    .title-en {
        direction: ltr;
        font-weight: 500;
    }

    .title-ar {
        direction: rtl;
        font-weight: 500;
    }

    .alert-wrapper {
        position: fixed;
        top: 80px;
        right: 20px;
        z-index: 1055;
    }

    .modal-title {
        color: #c30e0e;
        font-weight: bold;
    }

    .badge {
        font-weight: 500;
        padding: 6px 10px;
        font-size: 0.85rem;
    }

    .required-wrapper{
        display:flex;
        justify-content: end;
    }

    .required-text {
        color: #c30e0e;
        /* font-style: italic; */
        font-weight: bold;
        text-align: right;
        display: flex;
        justify-content: end;
        margin-bottom: 10px;
        background: antiquewhite;
        width: fit-content;
        padding: 7px;
        border-radius: 15px;
    }
</style>

<div>
    <div class="d-flex justify-content-between align-items-center mb-5 mt-3">
        <h4 class="section-title">
            <i class="fas fa-users"></i> Users
        </h4>

        <a class="btn btn-success"
           href="/Admin/AddUser"
           target="_blank"
           title="Add User">
            <i class="bi bi-plus-circle"></i> Add User
        </a>
    </div>

    <!-- Alert wrapper -->
    <div id="alertWrapper" class="alert-wrapper"></div>

    <!-- Badge legend -->
    <div class="mb-3">
        <span class="badge bg-success">Today</span>
        <span class="badge bg-info">Last 7 Days</span>
        <span class="badge bg-warning">Last 30 Days</span>
        <span class="badge bg-danger">Older</span>
    </div>

    <!-- DataTable -->
    <table id="userTable"
           class="table table-striped table-bordered nowrap"
           style="width:100%">
        <thead>
            <tr>
                <th>#</th>
                <th>Profile</th>
                <th>Full Name En</th>
                <th>Full Name Ar</th>
                <th>Email</th>
                <th>Role</th>
                <th>Created At</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>
            @{
                var count = 1;
                var users = ViewBag.Users.Data as List<EUserDTO> ?? new();
                var rowCount = users.Count;
            }

            @for (int i = 0; i < rowCount; i++)
            {
                var daysOld = (DateTime.Now - users[i].Created_at).TotalDays;
                var badgeColor = daysOld <= 1 ? "bg-success"
                               : daysOld <= 7 ? "bg-info"
                               : daysOld <= 30 ? "bg-warning"
                               : "bg-danger";
                <tr>
                    <td>@count</td>

                    <td>
                        <img src="~/Images/@(string.IsNullOrEmpty(users[i].Profile) ? "missing-image.jpg" : users[i].Profile)"
                             alt="User Image"
                             onerror="this.onerror=null;this.src='/Images/missing-image.jpg';" />
                    </td>

                    <td class="title-en">@users[i].FirstName_en @users[i].LastName_en</td>
                    <td class="title-ar">@users[i].FirstName_ar @users[i].LastName_ar</td>
                    <td>@users[i].Email</td>
                    <td>@users[i].Role</td>

                    <td>
                        <span class="badge @badgeColor">
                            <i class="bi bi-calendar-event me-1"></i>
                            @users[i].Created_at.ToLongDateString()
                        </span>
                        <br />
                        <span class="badge @badgeColor">
                            <i class="bi bi-clock me-1"></i>
                            @users[i].Created_at.ToLongTimeString()
                        </span>
                    </td>

                    <td>
                        <button class="btn btn-sm btn-primary"
                                data-bs-toggle="modal"
                                data-bs-target="#edituserModal"
                                data-id-en="@users[i].Id"
                                data-firstName-en="@users[i].FirstName_en"
                                data-lastName-en="@users[i].LastName_en"
                                data-firstName-ar="@users[i].FirstName_ar"
                                data-lastName-ar="@users[i].LastName_ar"
                                data-created-at="@users[i].Created_at.ToString("yyyy-MM-ddTHH:mm:ss")"
                                data-email="@users[i].Email"
                                data-role="@users[i].Role"
                                data-profile-image="@users[i].Profile">
                            Edit
                        </button>
                        <button class="btn btn-sm btn-danger"
                                data-bs-toggle="modal"
                                data-bs-target="#deleteuserModal"
                                data-id-en="@users[i].Id"
                                data-firstName-en="@users[i].FirstName_en"
                                data-firstName-ar="@users[i].FirstName_ar">
                            Delete
                        </button>
                    </td>
                </tr>
                count++;
            }
        </tbody>
    </table>

    <!-- Edit Modal -->
    <div class="modal fade" id="edituserModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form id="edituserForm" enctype="multipart/form-data">
                    <div class="modal-header">
                        <h5 class="modal-title">Edit User</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body">
                        <input type="hidden" id="editIdEn" name="idEn" />
                        <input type="hidden" id="editCreatedAt" name="createdAt" />

                        <div class="required-wrapper">
                            <p class="required-text">* All fields are required</p>
                        </div>

                        <!-- Profile Image Preview -->
                        <div class="mb-3 text-center">
                            <img id="editProfilePreview"
                                 src="/images/missing-image.jpg"
                                 alt="Profile Image"
                                 class="img-thumbnail"
                                 style="width:120px;height:120px;object-fit:cover;">
                        </div>

                        <!-- Upload File -->
                        <div class="mb-3">
                            <label class="form-label">Change Profile Image</label>
                            <input type="file"
                                   id="editProfileImage"
                                   name="ProfileImage"
                                   class="form-control"
                                   accept="image/*" />
                        </div>

                        <!-- First Name (English) -->
                        <div class="mb-3">
                            <label class="form-label">First Name (English) <span class="text-danger">*</span></label>
                            <input type="text" id="editFirstNameEn" class="form-control" dir="ltr" required />
                        </div>

                        <!-- Last Name (English) -->
                        <div class="mb-3">
                            <label class="form-label">Last Name (English) <span class="text-danger">*</span></label>
                            <input type="text" id="editLastNameEn" class="form-control" dir="ltr" required />
                        </div>

                        <!-- First Name (Arabic) -->
                        <div class="mb-3">
                            <label class="form-label">First Name (Arabic) <span class="text-danger">*</span></label>
                            <input type="text" id="editFirstNameAr" class="form-control" dir="rtl" required />
                        </div>

                        <!-- Last Name (Arabic) -->
                        <div class="mb-3">
                            <label class="form-label">Last Name (Arabic) <span class="text-danger">*</span></label>
                            <input type="text" id="editLastNameAr" class="form-control" dir="rtl" required />
                        </div>

                        <!-- Email -->
                        <div class="mb-3">
                            <label class="form-label">Email <span class="text-danger">*</span></label>
                            <input type="email" id="editEmail" class="form-control" required />
                        </div>

                        <!-- Role -->
                        <div class="mb-3">
                            <label class="form-label">Role <span class="text-danger">*</span></label>
                            <select id="editRole" name="Role" class="form-select" required>
                                @foreach (var role in ViewBag.AllRoles)
                                {
                                    <option value="@role.Name">@role.Name</option>
                                }
                            </select>
                        </div>

                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>



    <!-- Delete Modal -->
    <div class="modal fade" id="deleteuserModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form id="deleteuserForm">
                    <div class="modal-header">
                        <h5 class="modal-title">Confirm Delete</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" id="deleteIdEn" name="idEn" />
                        <p>Are you sure you want to delete <strong id="deleteTitle"></strong>?</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger">Delete</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- JS -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

<script>
    $(document).ready(function () {
        $('#userTable').DataTable({
            responsive: true,
            pageLength: 10,
            lengthMenu: [5, 10, 25, 50],
            language: { emptyTable: "No users found" },
            columnDefs: [
                { orderable: false, targets: [1, 6] } // Profile & Action
            ]
        });
    });

    function showMessage(message, type = 'success') {
        const wrapper = document.getElementById('alertWrapper');
        const div = document.createElement('div');
        div.innerHTML = `
            <div class="alert alert-${type} alert-dismissible fade show" role="alert">
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        `;
        wrapper.append(div);
        setTimeout(() => {
            bootstrap.Alert.getOrCreateInstance(div.querySelector('.alert')).close();
        }, 3000);
    }

    function updateRow(data) {
        // Use DataTables API to find the row by user ID
        const table = $('#userTable').DataTable();
        let rowNode = table.row(function (idx, rowData, node) {
            return $(node).find(`button[data-id-en="${data.UserId}"]`).length > 0;
        });

        if (!rowNode.node()) {
            console.warn('User row not found for ID:', data.UserId);
            return;
        }

        const row = $(rowNode.node());

        // Update profile image
        const img = row.find('td:eq(1) img');
        img.attr('src', data.ProfileImage ? `/Images/${data.ProfileImage}` : '/Images/missing-image.jpg');

        // Update names
        row.find('td:eq(2)').text(`${data.FirstName_en} ${data.LastName_en}`); // Full Name En
        row.find('td:eq(3)').text(`${data.FirstName_ar} ${data.LastName_ar}`); // Full Name Ar

        // Update email
        row.find('td:eq(4)').text(data.Email);

        // Update role
        row.find('td:eq(5)').text(data.Role);

        // Keep created at unchanged or update if needed
        // row.find('td:eq(6)').html(...)

        // Update edit button data attributes
        const editBtn = row.find('button[data-bs-target="#edituserModal"]');
        editBtn.data('firstName-en', data.FirstName_en);
        editBtn.data('lastName-en', data.LastName_en);
        editBtn.data('firstName-ar', data.FirstName_ar);
        editBtn.data('lastName-ar', data.LastName_ar);
        editBtn.data('email', data.Email);
        editBtn.data('role', data.Role);
        editBtn.data('profile-image', data.ProfileImage || '');

        // Update delete button data attributes
        const deleteBtn = row.find('button[data-bs-target="#deleteuserModal"]');
        deleteBtn.data('firstName-en', data.FirstName_en);
        deleteBtn.data('firstName-ar', data.FirstName_ar);
    }


    function setPreviewImage(src) {
        $('#editProfilePreview')
            .attr('src', src)
            .off('error')
            .on('error', function () {
                $(this).attr('src', '/images/missing-image.jpg');
            });
    }

    $('#edituserModal').on('show.bs.modal', function (event) {
        const button = event.relatedTarget;

        const existingImage = button.dataset.profileImage || "";
        const currentRole = button.dataset.role || "";

        $('#editIdEn').val(button.dataset.idEn);
        $('#editFirstNameEn').val(button.dataset.firstNameEn);
        $('#editLastNameEn').val(button.dataset.lastNameEn);
        $('#editFirstNameAr').val(button.dataset.firstNameAr);
        $('#editLastNameAr').val(button.dataset.lastNameAr);
        $('#editEmail').val(button.dataset.email);
        $('#editCreatedAt').val(button.dataset.createdAt);

        // Set role (case-insensitive safe)
        $('#editRole option').each(function () {
            if ($(this).val().toLowerCase() === currentRole.toLowerCase()) {
                $(this).prop('selected', true);
            }
        });

        // Show existing image from server
        let imagePath = existingImage
            ? `/images/${existingImage}`
            : '/images/missing-image.jpg';

        setPreviewImage(imagePath);

        // Reset file input so change event fires correctly
        $('#editProfileImage').val('');
    });



    // LIVE PREVIEW when selecting a new file
    $('#editProfileImage').on('change', function () {
        const file = this.files[0];

        if (!file) {
            return;
        }

        // Validate it's an image
        if (!file.type.startsWith('image/')) {
            alert('Please select a valid image file.');
            $(this).val('');
            setPreviewImage('/images/missing-image.jpg');
            return;
        }

        const reader = new FileReader();
        reader.onload = function (e) {
            setPreviewImage(e.target.result);
        };
        reader.readAsDataURL(file);
    });

    $('#edituserForm').on('submit', function (e) {
        e.preventDefault();

        const formData = new FormData();

        formData.append('UserId', $('#editIdEn').val());
        formData.append('FirstName_en', $('#editFirstNameEn').val());
        formData.append('LastName_en', $('#editLastNameEn').val());
        formData.append('FirstName_ar', $('#editFirstNameAr').val());
        formData.append('LastName_ar', $('#editLastNameAr').val());
        formData.append('Email', $('#editEmail').val());
        formData.append('Role', $('#editRole').val());
        formData.append('Created_at', $('#editCreatedAt').val());

        const fileInput = document.getElementById('editProfileImage');
        if (fileInput.files.length > 0) {
            formData.append('ProfileImage', fileInput.files[0]);
        }

        fetch('/Admin/EditUser', {
            method: 'POST',
            body: formData 
        })
            .then(res => res.json())
            .then(result => {
                bootstrap.Modal.getInstance(edituserModal).hide();

                if (result.success) {
                    updateRow(result.updatedUser || {}); // better to use server response
                    showMessage(result.message, 'success');
                } else {
                    showMessage(result.message, 'danger');
                }
            })
            .catch(err => {
                console.error(err);
                showMessage('Update failed!', 'danger');
            });
    });


    $('#deleteuserModal').on('show.bs.modal', function (event) {
        const button = event.relatedTarget;
        $('#deleteIdEn').val(button.dataset.idEn);
        $('#deleteTitle').text(button.dataset.firstNameEn + ' | ' + button.dataset.firstNameAr);
    });

    $('#deleteuserForm').on('submit', function (e) {
        e.preventDefault();

        const userId = $('#deleteIdEn').val();
        const data = { UserId: userId };

        fetch('/Admin/Deleteuser', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
            },
            body: JSON.stringify(data)
        })
            .then(res => res.json())
            .then(result => {
                bootstrap.Modal.getInstance(document.getElementById('deleteuserModal')).hide();

                if (result.success) {
                    // Find the row safely
                    const btn = document.querySelector(`button[data-id-en="${userId}"]`);
                    if (btn) {
                        const row = btn.closest('tr');
                        if (row) row.remove();
                    } else {
                        console.warn('Row not found for deleted user ID:', userId);
                    }

                    showMessage(result.message, 'success');
                } else {
                    showMessage(result.message, 'danger');
                }
            })
            .catch(() => showMessage('Delete failed!', 'danger'));
    });

</script>
