@using RentalCar.DomainLayer.DTO
@{
    Layout = "_AdminLTELayout";
    ViewData["Title"] = "Users";
    var isRtl = (bool?)ViewData["IsRtl"] ?? false;
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
    <style>
        #userTable th, #userTable td {
            text-align: center !important;
            vertical-align: middle;
        }

        #userTable td img {
            display: block;
            margin-left: auto;
            margin-right: auto;
            width: 50px;
            height: 50px;
            object-fit: cover;
            border-radius: 50%;
        }

        .title-en { direction: ltr; font-weight: 500; }
        .title-ar { direction: rtl; font-weight: 500; }

        .alert-wrapper {
            position: fixed;
            top: 80px;
            right: 20px;
            z-index: 1055;
        }

        .modal-title { color: #c30e0e; font-weight: bold; }

        .badge {
            font-weight: 500;
            padding: 6px 10px;
            font-size: 0.85rem;
        }

        .required-text {
            color: #c30e0e;
            font-weight: bold;
            text-align: right;
            margin-bottom: 10px;
            background: antiquewhite;
            width: fit-content;
            padding: 7px;
            border-radius: 15px;
        }
    </style>
}

<!-- Content Header -->
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0"><i class="fas fa-users mr-2"></i>Users</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb @(isRtl ? "float-sm-left" : "float-sm-right")">
                    <li class="breadcrumb-item"><a href="/Admin/Index">Home</a></li>
                    <li class="breadcrumb-item active">Users</li>
                </ol>
            </div>
        </div>
    </div>
</section>

<!-- Main content -->
<section class="content">
    <div class="container-fluid">

        <!-- Alert wrapper -->
        <div id="alertWrapper" class="alert-wrapper"></div>

        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="card-title mt-1"><i class="fas fa-list mr-1"></i> All Users</h3>
                <a class="btn btn-success btn-sm" href="/Admin/AddUser" target="_blank" title="Add User">
                    <i class="fas fa-plus-circle mr-1"></i> Add User
                </a>
            </div>
            <div class="card-body">

                <!-- Badge legend -->
                <div class="mb-3">
                    <span class="badge bg-success">Today</span>
                    <span class="badge bg-info">Last 7 Days</span>
                    <span class="badge bg-warning">Last 30 Days</span>
                    <span class="badge bg-danger">Older</span>
                </div>

                <!-- DataTable -->
                <table id="userTable" class="table table-striped table-bordered nowrap" style="width:100%">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Profile</th>
                            <th>Full Name En</th>
                            <th>Full Name Ar</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Created At</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var count = 1;
                            var users = ViewBag.Users.Data as List<EUserDTO> ?? new();
                            var rowCount = users.Count;
                        }

                        @for (int i = 0; i < rowCount; i++)
                        {
                            var daysOld = (DateTime.Now - users[i].Created_at).TotalDays;
                            var badgeColor = daysOld <= 1 ? "bg-success"
                                           : daysOld <= 7 ? "bg-info"
                                           : daysOld <= 30 ? "bg-warning"
                                           : "bg-danger";
                            <tr>
                                <td>@count</td>

                                <td>
                                    <img src="@(string.IsNullOrEmpty(users[i].Profile) ? "/Images/missing-image.jpg" : $"/Images/Profiles/{users[i].Profile}")"
                                         alt="User Image"
                                         onerror="this.onerror=null;this.src='/Images/missing-image.jpg';" />
                                </td>

                                <td class="title-en">@users[i].FullName</td>
                                <td class="title-ar">@users[i].FullName_ar</td>
                                <td>@users[i].Email</td>
                                <td>@users[i].Role</td>

                                <td>
                                    <span class="badge @badgeColor">
                                        <i class="fas fa-calendar-day mr-1"></i>
                                        @users[i].Created_at.ToLongDateString()
                                    </span>
                                    <br />
                                    <span class="badge @badgeColor">
                                        <i class="fas fa-clock mr-1"></i>
                                        @users[i].Created_at.ToLongTimeString()
                                    </span>
                                </td>

                                <td>
                                    <button class="btn btn-sm btn-primary"
                                            data-toggle="modal"
                                            data-target="#edituserModal"
                                            data-id-en="@users[i].Id"
                                            data-full-name-en="@users[i].FullName"
                                            data-full-name-ar="@users[i].FullName_ar"
                                            data-created-at="@users[i].Created_at.ToString("yyyy-MM-ddTHH:mm:ss")"
                                            data-email="@users[i].Email"
                                            data-role="@users[i].Role"
                                            data-profile-image="@users[i].Profile">
                                        Edit
                                    </button>
                                    <button class="btn btn-sm btn-danger"
                                            data-toggle="modal"
                                            data-target="#deleteuserModal"
                                            data-id-en="@users[i].Id"
                                            data-full-name-en="@users[i].FullName"
                                            data-full-name-ar="@users[i].FullName_ar">
                                        Delete
                                    </button>
                                </td>
                            </tr>
                            count++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<!-- Edit Modal -->
<div class="modal fade" id="edituserModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="edituserForm" enctype="multipart/form-data">
                <div class="modal-header">
                    <h5 class="modal-title">Edit User</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" id="editIdEn" name="idEn" />
                    <input type="hidden" id="editCreatedAt" name="createdAt" />

                    <div class="d-flex justify-content-end">
                        <p class="required-text">* All fields are required</p>
                    </div>

                    <!-- Profile Image Preview -->
                    <div class="mb-3 text-center">
                        <img id="editProfilePreview"
                             src="/images/missing-image.jpg"
                             alt="Profile Image"
                             class="img-thumbnail"
                             style="width:120px;height:120px;object-fit:cover;">
                    </div>

                    <!-- Upload File -->
                    <div class="mb-3">
                        <label class="form-label">Change Profile Image</label>
                        <input type="file" id="editProfileImage" name="ProfileImage" class="form-control" accept="image/*" />
                    </div>

                    <!-- Full Name (English) -->
                    <div class="mb-3">
                        <label class="form-label">Full Name (English) <span class="text-danger">*</span></label>
                        <input type="text" id="editFullNameEn" class="form-control" dir="ltr" required />
                    </div>

                    <!-- Full Name (Arabic) -->
                    <div class="mb-3">
                        <label class="form-label">Full Name (Arabic) <span class="text-danger">*</span></label>
                        <input type="text" id="editFullNameAr" class="form-control" dir="rtl" required />
                    </div>

                    <!-- Email -->
                    <div class="mb-3">
                        <label class="form-label">Email <span class="text-danger">*</span></label>
                        <input type="email" id="editEmail" class="form-control" required />
                    </div>

                    <!-- Role -->
                    <div class="mb-3">
                        <label class="form-label">Role <span class="text-danger">*</span></label>
                        <select id="editRole" name="Role" class="form-control" required>
                            @foreach (var role in ViewBag.AllRoles)
                            {
                                <option value="@role.Name">@role.Name</option>
                            }
                        </select>
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteuserModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="deleteuserForm">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm Delete</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="deleteIdEn" name="idEn" />
                    <p>Are you sure you want to delete <strong id="deleteTitle"></strong>?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#userTable').DataTable({
                responsive: true,
                pageLength: 10,
                lengthMenu: [5, 10, 25, 50],
                language: { emptyTable: "No users found" },
                columnDefs: [
                    { orderable: false, targets: [1, 6] } // Profile & Action
                ]
            });
        });

        function showMessage(message, type = 'success') {
            const wrapper = document.getElementById('alertWrapper');
            const div = document.createElement('div');
            div.innerHTML = `
                <div class="alert alert-${type} alert-dismissible fade show" role="alert">
                    ${message}
                    <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                </div>
            `;
            wrapper.append(div);
            setTimeout(() => { $(div).find('.alert').alert('close'); }, 3000);
        }

        function updateRow(data) {
            const table = $('#userTable').DataTable();

            // JSON comes back camelCased from ASP.NET Core; fall back to PascalCase just in case.
            const userId     = data.userId       ?? data.UserId;
            const fullName   = data.fullName     ?? data.FullName ?? '';
            const fullNameAr = data.fullName_ar  ?? data.FullName_ar ?? '';
            const email      = data.email        ?? data.Email ?? '';
            const role       = data.role         ?? data.Role ?? '';
            const profileImg = data.profileImage ?? data.ProfileImage ?? '';

            if (!userId) {
                console.warn('updateRow: missing user id', data);
                return;
            }

            // Find the row across ALL pages (not just the visible DOM).
            let targetNode = null;
            table.rows().every(function () {
                const node = this.node();
                if (node && $(node).find(`button[data-id-en="${userId}"]`).length > 0) {
                    targetNode = node;
                    return false; // stop iterating
                }
            });

            if (!targetNode) {
                console.warn('User row not found for ID:', userId);
                return;
            }

            const rowIdx = table.row(targetNode).index();

            // Update the profile image on the node directly (keeps the markup).
            $(targetNode).find('td img')
                .attr('src', profileImg ? `/Images/Profiles/${profileImg}` : '/Images/missing-image.jpg');

            // Update text columns through the DataTables cell API so the change
            // survives sorting/searching/paging (columns: 2=NameEn 3=NameAr 4=Email 5=Role).
            table.cell(rowIdx, 2).data(fullName);
            table.cell(rowIdx, 3).data(fullNameAr);
            table.cell(rowIdx, 4).data(email);
            table.cell(rowIdx, 5).data(role);
            table.draw(false); // redraw, keep current page

            // Refresh the action buttons' data-* attributes for the next edit/delete.
            const editBtn = $(targetNode).find('button[data-target="#edituserModal"]');
            editBtn.attr('data-full-name-en', fullName);
            editBtn.attr('data-full-name-ar', fullNameAr);
            editBtn.attr('data-email', email);
            editBtn.attr('data-role', role);
            editBtn.attr('data-profile-image', profileImg);

            const deleteBtn = $(targetNode).find('button[data-target="#deleteuserModal"]');
            deleteBtn.attr('data-full-name-en', fullName);
            deleteBtn.attr('data-full-name-ar', fullNameAr);
        }

        function setPreviewImage(src) {
            $('#editProfilePreview')
                .attr('src', src)
                .off('error')
                .on('error', function () {
                    $(this).attr('src', '/images/missing-image.jpg');
                });
        }

        $('#edituserModal').on('show.bs.modal', function (event) {
            const button = event.relatedTarget;

            const existingImage = button.dataset.profileImage || "";
            const currentRole = (button.dataset.role || "").trim().toLowerCase();

            $('#editIdEn').val(button.dataset.idEn);
            $('#editFullNameEn').val(button.dataset.fullNameEn);
            $('#editFullNameAr').val(button.dataset.fullNameAr);
            $('#editEmail').val(button.dataset.email);
            $('#editCreatedAt').val(button.dataset.createdAt);

            // Reset selection first so a previous user's role never leaks over.
            let roleMatched = false;
            $('#editRole option').each(function () {
                const isMatch = $(this).val().trim().toLowerCase() === currentRole;
                $(this).prop('selected', isMatch);
                if (isMatch) roleMatched = true;
            });
            if (!roleMatched) {
                $('#editRole').prop('selectedIndex', 0);
            }

            let imagePath = existingImage
                ? `/images/Profiles/${existingImage}`
                : '/images/missing-image.jpg';

            setPreviewImage(imagePath);

            $('#editProfileImage').val('');
        });

        // LIVE PREVIEW when selecting a new file
        $('#editProfileImage').on('change', function () {
            const file = this.files[0];
            if (!file) return;

            if (!file.type.startsWith('image/')) {
                alert('Please select a valid image file.');
                $(this).val('');
                setPreviewImage('/images/missing-image.jpg');
                return;
            }

            const reader = new FileReader();
            reader.onload = function (e) { setPreviewImage(e.target.result); };
            reader.readAsDataURL(file);
        });

        $('#edituserForm').on('submit', function (e) {
            e.preventDefault();

            const formData = new FormData();
            formData.append('Id', $('#editIdEn').val());
            formData.append('FullName', $('#editFullNameEn').val());
            formData.append('FullName_ar', $('#editFullNameAr').val());
            formData.append('Email', $('#editEmail').val());
            formData.append('Role', $('#editRole').val());
            formData.append('Created_at', $('#editCreatedAt').val());

            const fileInput = document.getElementById('editProfileImage');
            if (fileInput.files.length > 0) {
                formData.append('ProfileImage', fileInput.files[0]);
            }

            fetch('/Admin/EditUser', { method: 'POST', body: formData })
                .then(res => res.json())
                .then(result => {
                    $('#edituserModal').modal('hide');
                    if (result.success) {
                        updateRow(result.updatedUser || {});
                        showMessage(result.message, 'success');
                    } else {
                        showMessage(result.message, 'danger');
                    }
                })
                .catch(err => {
                    console.error(err);
                    showMessage('Update failed!', 'danger');
                });
        });

        $('#deleteuserModal').on('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            $('#deleteIdEn').val(button.dataset.idEn);
            $('#deleteTitle').text(button.dataset.fullNameEn + ' | ' + button.dataset.fullNameAr);
        });

        $('#deleteuserForm').on('submit', function (e) {
            e.preventDefault();

            const userId = $('#deleteIdEn').val();
            const data = { UserId: userId };

            fetch('/Admin/Deleteuser', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                body: JSON.stringify(data)
            })
                .then(res => res.json())
                .then(result => {
                    $('#deleteuserModal').modal('hide');
                    if (result.success) {
                        const btn = document.querySelector(`button[data-id-en="${userId}"]`);
                        if (btn) {
                            const row = btn.closest('tr');
                            if (row) row.remove();
                        } else {
                            console.warn('Row not found for deleted user ID:', userId);
                        }
                        showMessage(result.message, 'success');
                    } else {
                        showMessage(result.message, 'danger');
                    }
                })
                .catch(() => showMessage('Delete failed!', 'danger'));
        });
    </script>
}
