@using RentalCar.DomainLayer.DTO
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Announcements";
}

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />

<style>
    .section-title {
        color: var(--secondary-color);
    }

    th, td {
        text-align: center !important;
    }

    .announcement-title {
        white-space: nowrap;
    }

    .title-en {
        direction: ltr;
        font-weight: 500;
    }

    .title-ar {
        direction: rtl;
        font-weight: 500;
    }

    .alert-wrapper {
        position: fixed;
        top: 80px;
        right: 20px;
        z-index: 1055;
    }

    .modal-title {
        color: #c30e0e;
        font-weight: bold;
    }
</style>

<div>
    <div class="d-flex justify-content-between align-items-center mb-5 mt-3">
        <h4 class="section-title">
            <i class="bi bi-megaphone-fill"></i> Announcements
        </h4>

        <button class="btn btn-success"
                data-bs-toggle="modal"
                data-bs-target="#addAnnouncementModal">
            <i class="bi bi-plus-circle"></i> Add Announcement
        </button>
    </div>


    <!-- Alert wrapper -->
    <div id="alertWrapper" style="position: fixed; top: 20px; right: 20px; z-index: 1055;"></div>

    <!-- DataTable -->
    <table id="AnnouncementTable"
           class="table table-striped table-bordered nowrap"
           style="width:100%">

        <thead>
            <tr>
                <th>#</th>
                <th>Title English</th>
                <th>Title Arabic</th>
                <th>Publish Date</th>
                <th>Icon</th>
                <th>Image</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>
            @{
                var count = 1;

                var announcementEn = ViewBag.AnnouncementEn as List<AnnouncementDTO> ?? new();
                var announcementAr = ViewBag.AnnouncementAr as List<AnnouncementDTO> ?? new();

                var rowCount = Math.Min(announcementEn.Count, announcementAr.Count);
            }

            @for (int i = 0; i < rowCount; i++)
            {
                <tr>
                    <td>@count</td>

                    <td class="title-en">
                        @announcementEn[i].Content
                    </td>

                    <td class="title-ar" dir="rtl">
                        @announcementAr[i].Content
                    </td>

                    <td>
                        @announcementEn[i].PublishDate.ToString("dd/MM/yyyy")
                    </td>

                    <td class="text-center">
                        @if (!string.IsNullOrEmpty(announcementEn[i].Icon))
                        {
                            <i class="@announcementEn[i].Icon"></i>
                        }
                    </td>

                    <td class="text-center">
                        @if (!string.IsNullOrEmpty(announcementEn[i].Image))
                        {
                            <img src="@announcementEn[i].Image"
                                 alt="Image"
                                 style="width:40px;height:auto;" />
                        }
                    </td>

                    <td>
                        <button class="btn btn-sm btn-primary"
                                data-bs-toggle="modal"
                                data-bs-target="#editAnnouncementModal"
                                data-id-en="@announcementEn[i].Id"
                                data-id-ar="@announcementAr[i].Id"
                                data-title-en="@announcementEn[i].Content"
                                data-title-ar="@announcementAr[i].Content"
                                data-icon="@announcementEn[i].Icon"
                                data-publish-date="@announcementEn[i].PublishDate.ToString("yyyy-MM-ddTHH:mm:ss")"
                                data-created-at="@announcementEn[i].Created_at.ToString("yyyy-MM-ddTHH:mm:ss")">
                            Edit
                        </button>


                        <button class="btn btn-sm btn-danger"
                                data-bs-toggle="modal"
                                data-bs-target="#deleteAnnouncementModal"
                                data-id-en="@announcementEn[i].Id"
                                data-id-ar="@announcementAr[i].Id"
                                data-title-en="@announcementEn[i].Content"
                                data-title-ar="@announcementAr[i].Content"
                                >
                            Delete
                        </button>
                    </td>
                </tr>

                count++;
            }
        </tbody>
    </table>

    <!--Add Modal-->
    <div class="modal fade" id="addAnnouncementModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <form id="addAnnouncementForm" enctype="multipart/form-data">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            <i class="bi bi-plus-circle"></i> Add Announcement
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body">

                        <!-- English Title -->
                        <div class="mb-3">
                            <label class="form-label">Title (English) *</label>
                            <textarea class="form-control"
                                      id="addTitleEn"
                                      rows="2"
                                      dir="ltr"
                                      required></textarea>
                        </div>

                        <!-- Arabic Title -->
                        <div class="mb-3">
                            <label class="form-label">Title (Arabic) *</label>
                            <textarea class="form-control"
                                      id="addTitleAr"
                                      rows="2"
                                      dir="rtl"
                                      required></textarea>
                        </div>

                        <!-- Icon -->
                        <div class="mb-3">
                            <label class="form-label">
                                Icon (Bootstrap icon class)
                            </label>
                            <input type="text"
                                   class="form-control"
                                   id="addIcon"
                                   placeholder="<i class='bi bi-megaphone-fill'></i>" />
                            <small class="text-muted">
                                Example: <code>bi bi-bell</code>, <code>bi bi-info-circle</code>
                            </small>
                        </div>

                        <!-- Image -->
                        <div class="mb-3">
                            <label class="form-label">Image (optional)</label>
                            <input type="file"
                                   class="form-control"
                                   id="addImage"
                                   accept="image/*" />
                        </div>

                    </div>

                    <div class="modal-footer">
                        <button type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-check-circle"></i> Save
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>


    <!-- Edit Modal -->
    <div class="modal fade" id="editAnnouncementModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form id="editAnnouncementForm">
                    <div class="modal-header">
                        <h5 class="modal-title">Edit Announcement</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" id="editIdEn" name="announcementEnId" />
                        <input type="hidden" id="editIdAr" name="announcementArId" />
                        <input type="hidden" id="editPublishDate" name="publishDate" />
                        <input type="hidden" id="editCreatedAt" name="createdAt" />

                        <div class="mb-3">
                            <label class="form-label">Title (English)</label>
                            <input type="text" id="editTitleEn" class="form-control" dir="ltr" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Title (Arabic)</label>
                            <input type="text" id="editTitleAr" class="form-control" dir="rtl" required />
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label">Icon</label>
                            <input type="text" id="editIcon" class="form-control" required />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Delete Modal -->
    <div class="modal fade" id="deleteAnnouncementModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form id="deleteAnnouncementForm">
                    <div class="modal-header">
                        <h5 class="modal-title">Confirm Delete</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" id="deleteIdEn" name="announcementEnId" />
                        <input type="hidden" id="deleteIdAr" name="announcementArId" />
                        <p>Are you sure you want to delete <strong id="deleteTitle"></strong>?</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger">Delete</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- JS -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

<script>
        $(document).ready(function () {
            $('#AnnouncementTable').DataTable({
                responsive: true,
                scrollX: true,
                autoWidth: false,
                pageLength: 10,

                language: {
                    emptyTable: "No announcements found"
                },

                columnDefs: [
                    { orderable: false, targets: [4, 5, 6] } // Icon, Image, Action
                ]
            });
        });

        // ----------------------
        // Alerts
        // ----------------------
        function showMessage(message, type = 'success') {
            const wrapper = document.getElementById('alertWrapper');

            // Ensure wrapper is always on top
            wrapper.style.position = 'fixed';
            wrapper.style.top = '20px';
            wrapper.style.right = '20px';
            wrapper.style.zIndex = '2000'; // higher than Bootstrap modal (1055)

            const div = document.createElement('div');
            div.innerHTML = `
                <div class="alert alert-${type} alert-dismissible fade show" role="alert">
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            `;

            wrapper.append(div);

            setTimeout(() => {
                bootstrap.Alert.getOrCreateInstance(div.querySelector('.alert')).close();
            }, 3000);
        }


        // ----------------------
        // Update Table Row
        // ----------------------
        function updateRow(data) {
            const button = document.querySelector(`button[data-id-en="${data.IdEn}"]`);
            if (!button) {
                console.warn("Button not found for IdEn =", data.IdEn);
                return;
            }

            const row = button.closest('tr');
            if (!row) {
                console.warn("Row not found for IdEn =", data.IdEn);
                return;
            }

            // Update the table cells
            row.querySelector('.title-en').innerText = data.TitleEn;
            row.querySelector('.title-ar').innerText = data.TitleAr;

            // Update edit button attributes
            const editBtn = row.querySelector('[data-bs-target="#editAnnouncementModal"]');
            editBtn.setAttribute('data-title-en', data.TitleEn);
            editBtn.setAttribute('data-title-ar', data.TitleAr);
            editBtn.setAttribute('data-icon', data.Icon);

            // Update delete button attributes
            const deleteBtn = row.querySelector('[data-bs-target="#deleteAnnouncementModal"]');
            deleteBtn.setAttribute('data-title-en', data.TitleEn);
            deleteBtn.setAttribute('data-title-ar', data.TitleAr);
        }


        // ----------------------
        // Handle Edit Modal
        // ----------------------

        // Helper: safe ISO date conversion
        function safeIsoDate(value) {
            if (!value) return null;
            const d = new Date(value);
            return isNaN(d.getTime()) ? null : d.toISOString();
        }

        // Open modal: populate fields
        $('#editAnnouncementModal').on('show.bs.modal', function (event) {
            const button = event.relatedTarget;

            $('#editIdEn').val(button.dataset.idEn);
            $('#editIdAr').val(button.dataset.idAr);
            $('#editTitleEn').val(button.dataset.titleEn);
            $('#editTitleAr').val(button.dataset.titleAr);
            $('#editIcon').val(button.dataset.icon);

            $('#editPublishDate').val(button.dataset.publishDate || null);
            $('#editCreatedAt').val(button.dataset.createdAt || null);
            $('#editLanguageId').val(button.dataset.languageId || 0); // add this hidden input if needed
        });

        // Submit form
        $('#editAnnouncementForm').on('submit', function (e) {
            e.preventDefault();

            const data = {
                IdEn: Number($('#editIdEn').val()),
                IdAr: Number($('#editIdAr').val()),
                TitleEn: $('#editTitleEn').val(),
                TitleAr: $('#editTitleAr').val(),
                Icon: $('#editIcon').val(),
                PublishDate: safeIsoDate($('#editPublishDate').val()),
                CreatedAt: safeIsoDate($('#editCreatedAt').val()),
                Image: null,
                LanguageId: Number($('#editLanguageId').val() || 0)
            };

            fetch('/Admin/EditAnnouncement', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            })
            .then(res => res.json()) // parse JSON no matter what
            .then(result => {
                const modal = bootstrap.Modal.getInstance(editAnnouncementModal);
                if (modal) modal.hide();

                if (result.success) {
                    updateRow(data);
                    showMessage(result.message, 'success');
                } else {
                    if (result.errors) {
                        showMessage(result.message + "<br>" + result.errors.join("<br>"), 'danger');
                    } else {
                        showMessage(result.message || 'Update failed!', 'danger');
                    }
                }
            })
            .catch(err => {
                console.error(err);
                showMessage('Update failed due to network error!', 'danger');
            });

        });


        // ----------------------
        // Handle Delete Modal
        // ----------------------
        $('#deleteAnnouncementModal').on('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            $('#deleteIdEn').val(button.getAttribute('data-id-en'));
            $('#deleteIdAr').val(button.getAttribute('data-id-ar'));
            $('#deleteTitle').text(button.getAttribute('data-title-en') + ' | ' + button.getAttribute('data-title-ar'));
        });

        $('#deleteAnnouncementForm').on('submit', function (e) {
            e.preventDefault();
            const data = { IdEn: $('#deleteIdEn').val(), IdAr: $('#deleteIdAr').val() };
            fetch('/Admin/DeleteAnnouncement', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                body: JSON.stringify(data)
            })
                .then(res => {
                    if (!res.ok) throw new Error();
                    return res.json();
                })
                .then(result => {
                    const modal = bootstrap.Modal.getInstance(
                        document.getElementById('deleteAnnouncementModal')
                    );
                    if (modal) modal.hide();

                    if (result.success === true) {
                        const row = document
                            .querySelector(`button[data-id-en="${data.AnnouncementEnId}"]`)
                            ?.closest('tr');

                        if (row) row.remove();

                        showMessage(result.message, 'success');
                    } else {
                        showMessage(result.message, 'danger');
                    }
                })
                .catch(() => showMessage('Delete failed!', 'danger'));
        });


    // ----------------------
    // Add Announcement
    // ----------------------
    $('#addAnnouncementForm').on('submit', async function (e) {
        e.preventDefault();

        const titleEn = $('#addTitleEn').val().trim();
        const titleAr = $('#addTitleAr').val().trim();
        const icon = $('#addIcon').val().trim();
        const imageInput = $('#addImage')[0];
        const imageFile = imageInput.files[0];

        //  Required field validation
        if (!titleEn || !titleAr) {
            showMessage('English and Arabic titles are required.', 'danger');
            return;
        }

        //  Optional: Validate image type
        if (imageFile && !imageFile.type.startsWith('image/')) {
            showMessage('Please select a valid image file.', 'danger');
            return;
        }

        try {
            const formData = new FormData();
            formData.append('TitleEn', titleEn);
            formData.append('TitleAr', titleAr);
            formData.append('Icon', icon || '');
            if (imageFile) formData.append('Image', imageFile);

            const response = await fetch('/Admin/AddAnnouncement', {
                method: 'POST',
                body: formData
            });

            const result = await response.json();

            // Close modal
            bootstrap.Modal.getInstance(
                document.getElementById('addAnnouncementModal')
            ).hide();

            if (result.success) {
                showMessage(result.message, 'success');
                // Optionally: reload or add row dynamically
                location.reload();
            } else {
                showMessage(result.message || 'Failed to add announcement.', 'danger');
            }
        } catch (error) {
            console.error(error);
            showMessage('An unexpected error occurred while adding the announcement.', 'danger');
        }
    });

</script>
