@{
    Layout = "_AdminLTELayout";
    ViewData["Title"] = "Add User";
    var isRtl = (bool?)ViewData["IsRtl"] ?? false;
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <style>
        img#profilePreview {
            display: block;
            margin-top: 10px;
            width: 100px;
            height: 100px;
            object-fit: cover;
            border-radius: 50%;
        }

        .form-label span { color: #c30e0e; }

        .required-text {
            color: #c30e0e;
            text-align: right;
            margin-bottom: 10px;
            background: antiquewhite;
            width: fit-content;
            padding: 5px 15px;
            border-radius: 15px;
            font-weight: bold;
        }

        /* ===== Select2 to match Bootstrap inputs ===== */
        .select2-container .select2-selection--single {
            height: 38px !important;
            padding: 6px 10px;
            border: 1px solid #ced4da !important;
            border-radius: 4px;
            background-color: #fff;
            display: flex;
            align-items: center;
            transition: all 0.2s ease-in-out;
            font-size: 16px;
        }

        .select2-container .select2-selection--single .select2-selection__rendered {
            line-height: normal !important;
            padding-left: 0 !important;
            color: #495057;
        }

        .select2-container .select2-selection--single .select2-selection__arrow {
            height: 100%;
            right: 8px;
        }

        .select2-container--default.select2-container--open .select2-selection--single,
        .select2-container--default.select2-container--focus .select2-selection--single {
            border-color: #86b7fe;
            box-shadow: 0 0 0 0.2rem rgba(13,110,253,.15);
        }

        .select2-dropdown {
            border-radius: 8px;
            border: 1px solid #ced4da;
            box-shadow: 0 8px 25px rgba(0,0,0,0.08);
        }

        .select2-results__option--highlighted { background-color: #f1f5ff !important; color: #000 !important; }
        .select2-results__option--selected { background-color: #e7f1ff !important; color: #000 !important; }
    </style>
}

<!-- Content Header -->
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0"><i class="fas fa-user-plus mr-2"></i>Add New User</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb @(isRtl ? "float-sm-left" : "float-sm-right")">
                    <li class="breadcrumb-item"><a href="/Admin/Index">Home</a></li>
                    <li class="breadcrumb-item"><a href="/Admin/Users">Users</a></li>
                    <li class="breadcrumb-item active">Add User</li>
                </ol>
            </div>
        </div>
    </div>
</section>

<!-- Main content -->
<section class="content">
    <div class="container-fluid">

        <!-- Alert wrapper -->
        <div id="alertWrapper" style="position: fixed; top: 80px; right: 20px; z-index: 2000;"></div>

        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="card-title mt-1"><i class="fas fa-user-plus mr-1"></i> User Details</h3>
                <p class="required-text mb-0">* : All fields are required</p>
            </div>
            <div class="card-body">

                <form id="addUserForm" enctype="multipart/form-data">
                    <div class="row">
                        <!-- Full Name English -->
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Full Name (English) <span>*</span></label>
                            <input type="text" class="form-control" id="fullNameEn" name="FullName" dir="ltr" required />
                        </div>

                        <!-- Full Name Arabic -->
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Full Name (Arabic) <span>*</span></label>
                            <input type="text" class="form-control" id="fullNameAr" name="FullName_ar" dir="rtl" required />
                        </div>

                        <!-- Email -->
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Email <span>*</span></label>
                            <input type="email" class="form-control" id="email" name="Email" required />
                        </div>

                        <!-- Password -->
                        <div class="col-md-6 mb-3 position-relative">
                            <label class="form-label">Password <span>*</span></label>
                            <div class="input-group">
                                <input type="password" class="form-control" id="password" name="Password" required />
                                <div class="input-group-append">
                                    <span class="input-group-text" id="togglePassword" style="cursor: pointer;">
                                        <i class="fas fa-eye"></i>
                                    </span>
                                    <span class="input-group-text" id="passwordInfo" style="cursor: pointer;">
                                        <i class="fas fa-info-circle text-primary"></i>
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Phone Number -->
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Phone Number <span>*</span></label>
                            <input type="text" class="form-control" id="phoneNumber" name="PhoneNumber" required />
                        </div>

                        <!-- Role -->
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Role <span>*</span></label>
                            <select class="form-control" id="role" name="role" required>
                                <option value="">Select Role</option>
                                @foreach (var role in ViewBag.AllRoles)
                                {
                                    <option value="@role.Name">@role.Name</option>
                                }
                            </select>
                        </div>

                        <!-- Profile Image -->
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Profile Image <span>*</span></label>
                            <input type="file" class="form-control" id="profileImage" name="Image" accept="image/*" required />
                            <img id="profilePreview" src="/Images/missing-image.jpg" alt="Profile Preview" />
                        </div>
                    </div>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-success"><i class="fas fa-plus-circle mr-1"></i> Add User</button>
                        <a href="/Admin/Users" class="btn btn-secondary ml-2">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#role').select2({
                placeholder: "Select Role",
                allowClear: true,
                width: '100%'
            });
        });

        // Preview profile image
        $('#profileImage').on('change', function () {
            const input = this;
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    $('#profilePreview').attr('src', e.target.result);
                }
                reader.readAsDataURL(input.files[0]);
            }
        });

        // Custom Alerts
        function showMessage(message, type = 'danger') {
            const wrapper = document.getElementById('alertWrapper');
            const div = document.createElement('div');
            div.innerHTML = `
                <div class="alert alert-${type} alert-dismissible fade show d-flex align-items-center" role="alert">
                    <i class="fas fa-exclamation-circle mr-2"></i>
                    <div>${message}</div>
                    <button type="button" class="close ml-auto" data-dismiss="alert"><span>&times;</span></button>
                </div>
            `;
            wrapper.append(div);
            setTimeout(() => { $(div).find('.alert').alert('close'); }, 4000);
        }

        // Toggle Password Visibility
        $('#togglePassword').on('click', function () {
            const passwordInput = $('#password');
            const icon = $(this).find('i');

            if (passwordInput.attr('type') === 'password') {
                passwordInput.attr('type', 'text');
                icon.removeClass('fa-eye').addClass('fa-eye-slash');
            } else {
                passwordInput.attr('type', 'password');
                icon.removeClass('fa-eye-slash').addClass('fa-eye');
            }
        });

        // Password Info Alert
        $('#passwordInfo').on('click', function () {
            showMessage(`
                <strong>Password Requirements:</strong>
                <ul style="margin-bottom:0;">
                    <li>Length must be at least 8 characters.</li>
                    <li>Must contain at least one uppercase letter.</li>
                    <li>Must contain at least one lowercase letter.</li>
                    <li>Must contain at least one digit.</li>
                    <li>Must contain at least one special character (e.g., @@, #, $).</li>
                </ul>
            `, 'info');
        });

        // Handle Add User Form
        $('#addUserForm').on('submit', function (e) {
            e.preventDefault();

            const fullNameEn = $('#fullNameEn').val().trim();
            const fullNameAr = $('#fullNameAr').val().trim();
            const email = $('#email').val().trim();
            const password = $('#password').val().trim();
            const phoneNumber = $('#phoneNumber').val().trim();
            const role = $('#role').val();
            const profileImage = $('#profileImage').val();

            if (!fullNameEn || !fullNameAr || !email || !password || !phoneNumber || !role || !profileImage) {
                showMessage('Please fill in all required fields.', 'danger');
                return;
            }

            let missingRequirements = [];
            if (password.length < 8) missingRequirements.push('Length must be at least 8 characters.');
            if (!/[A-Z]/.test(password)) missingRequirements.push('Must contain at least one uppercase letter.');
            if (!/[a-z]/.test(password)) missingRequirements.push('Must contain at least one lowercase letter.');
            if (!/\d/.test(password)) missingRequirements.push('Must contain at least one digit.');
            if (!/[!@@#$%^&*(),.?":{}|<>]/.test(password)) missingRequirements.push('Must contain at least one special character (e.g., @@, #, $).');

            if (missingRequirements.length > 0) {
                showMessage(`<strong>Password missing:</strong><ul style="margin-bottom:0;">${missingRequirements.map(r => `<li>${r}</li>`).join('')}</ul>`, 'danger');
                return;
            }

            const formData = new FormData(this);

            fetch('/Admin/AddUser', { method: 'POST', body: formData })
                .then(res => res.json())
                .then(result => {
                    if (result.success) {
                        showMessage(result.message || 'User added successfully!', 'success');
                        setTimeout(() => window.location.href = '/Admin/Users', 1000);
                    } else {
                        showMessage(result.message || 'Failed to add user!', 'danger');
                    }
                })
                .catch(() => showMessage('An error occurred!', 'danger'));
        });
    </script>
}
