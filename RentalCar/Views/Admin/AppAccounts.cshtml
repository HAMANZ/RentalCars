            margin-top: 25px;
            margin-left: -13px;
            margin-right: -13px;
            margin-bottom: -13px;
            text-align: right;
        }

        label {
            font-weight: 600
        }

        a {
            color: black
        }

        h2 {
            color: black;
            font-size: 20px;
            font-family: Arial, Helvetica, sans-serif;
        }

        .in {
            width: 100px;
            display: inline-flex;
            justify-content: flex-start;
            align-items: flex-start;
        }

