@using RentalCar.DomainLayer.CommonObjects;
@using RentalCar.DomainLayer.DTO;
@model DynamicResponse<AppSettingsDTO>

@{
    Layout = "_AdminLTELayout";
    ViewData["Title"] = "App Privacy";
    var isRtl = (bool?)ViewData["IsRtl"] ?? false;
}

<!-- Content Header -->
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0"><i class="fas fa-user-shield mr-2"></i>Edit App Privacy</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb @(isRtl ? "float-sm-left" : "float-sm-right")">
                    <li class="breadcrumb-item"><a href="/Admin/Index">Home</a></li>
                    <li class="breadcrumb-item active">App Privacy</li>
                </ol>
            </div>
        </div>
    </div>
</section>

<!-- Main content -->
<section class="content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-body">
                @using (Html.BeginForm("UpdateAppPrivacy", "Admin", FormMethod.Post, new { @class = "id", enctype = "multipart/form-data" }))
                {
                    <input name="Id" value="@Model.Data.Id" type="hidden" />

                    <div class="form-group">
                        <label>App Privacy</label>
                        <textarea name="PrivacyPolicy" style="display:none" id="txteditorvalue">@Model.Data.PrivacyPolicy</textarea>
                        <textarea style="height: 200px" name="Text"></textarea>
                    </div>

                    <button class="btn btn-primary submit-form" type="submit">
                        <i class="fas fa-save mr-1"></i> Update
                    </button>
                }
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/Scripts/cms/plugin/ckeditor/ckeditor.js"></script>
    <script>
        var bodyEditor;

        function SetContents() {
            var editor = CKEDITOR.instances.Text;
            editor.setData($("#txteditorvalue").text());
        }

        function GetContents() {
            var editor = CKEDITOR.instances.Text;
            $("#txteditorvalue").html(editor.getData());
        }

        $(function () {
            bodyEditor = CKEDITOR.replace('Text');
            SetContents();

            bodyEditor.on('mode', function () {
                if (this.mode == 'source') {
                    var editable = bodyEditor.editable();
                    editable.attachListener(editable, 'input', function () { GetContents(); });
                }
            });

            bodyEditor.on('change', function () { GetContents(); });
        });
    </script>
}
