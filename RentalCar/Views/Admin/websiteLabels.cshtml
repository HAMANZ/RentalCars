@using RentalCar.DomainLayer.DTO
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Wesbite Labels";
}

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />

<style>
    .section-title {
        color: var(--secondary-color);
    }

    th, td {
        text-align: center !important;
    }

    .websiteLabel-title {
        white-space: nowrap;
    }

    .title-en {
        direction: ltr;
        font-weight: 500;
    }

    .title-ar {
        direction: rtl;
        font-weight: 500;
    }

    .alert-wrapper {
        position: fixed;
        top: 80px;
        right: 20px;
        z-index: 1055;
    }

    .modal-title {
        color: #c30e0e;
        font-weight: bold;
    }
</style>

<div>
    <div class="d-flex justify-content-between align-items-center mb-5 mt-3">
        <h4 class="section-title">
            <i class="bi bi-tags-fill"></i>
            Website Labels
        </h4>

        <button class="btn btn-success"
                data-bs-toggle="modal"
                data-bs-target="#addwebsiteLabelModal">
            <i class="bi bi-plus-circle"></i> Add Website Label
        </button>
    </div>


    <!-- Alert wrapper -->
    <div id="alertWrapper" style="position: fixed; top: 20px; right: 20px; z-index: 1055;"></div>

    <!-- DataTable -->
    <table id="websiteLabelTable"
           class="table table-striped table-bordered nowrap"
           style="width:100%">

        <thead>
            <tr>
                <th>#</th>
                <th>Label Name</th>
                <th>Title English</th>
                <th>Title Arabic</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>
            @{
                var count = 1;

                var websiteLabelEn = ViewBag.websiteLabelEn as List<AppLabelDTO> ?? new();
                var websiteLabelAr = ViewBag.websiteLabelAr as List<AppLabelDTO> ?? new();

                var rowCount = Math.Min(websiteLabelEn.Count, websiteLabelAr.Count);
            }

            @for (int i = 0; i < rowCount; i++)
            {
                <tr>
                    <td>@count</td>

                    <td class="title-en">
                        @websiteLabelEn[i].LabelName
                    </td>

                    <td>
                        @websiteLabelEn[i].Value
                    </td>
                    
                    <td>
                        @websiteLabelAr[i].Value
                    </td>

                    <td>
                        <button class="btn btn-sm btn-primary"
                                data-bs-toggle="modal"
                                data-bs-target="#editwebsiteLabelModal"
                                data-id-en="@websiteLabelEn[i].Id"
                                data-id-ar="@websiteLabelAr[i].Id"
                                data-title-en="@websiteLabelEn[i].Value"
                                data-title-ar="@websiteLabelAr[i].Value"
                                data-website-label="@websiteLabelEn[i].LabelName"
                                >
                            Edit
                        </button>

                        <button class="btn btn-sm btn-danger"
                                data-bs-toggle="modal"
                                data-bs-target="#deletewebsiteLabelModal"
                                data-id-en="@websiteLabelEn[i].Id"
                                data-id-ar="@websiteLabelAr[i].Id"
                                data-title-en="@websiteLabelEn[i].Value"
                                data-title-ar="@websiteLabelAr[i].Value">
                            Delete
                        </button>
                    </td>
                </tr>

                count++;
            }
        </tbody>
    </table>

    <!--Add Modal-->
    <div class="modal fade" id="addwebsiteLabelModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <form id="addwebsiteLabelForm" enctype="multipart/form-data">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            <i class="bi bi-plus-circle"></i> Add Website Label
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body">

                        <!-- Label Name -->
                        <div class="mb-3">
                            <label class="form-label">Label Name *</label>
                            <input type="text"  
                                   class="form-control"
                                      id="addWebsiteLabelName"
                                      required />
                        </div>

                        <!-- English Title -->
                        <div class="mb-3">
                            <label class="form-label">Title (English) *</label>
                            <textarea class="form-control"
                                      id="addTitleEn"
                                      rows="2"
                                      dir="ltr"
                                      required></textarea>
                        </div>

                        <!-- Arabic Title -->
                        <div class="mb-3">
                            <label class="form-label">Title (Arabic) *</label>
                            <textarea class="form-control"
                                      id="addTitleAr"
                                      rows="2"
                                      dir="rtl"
                                      required></textarea>
                        </div>

                    </div>

                    <div class="modal-footer">
                        <button type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-check-circle"></i> Save
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>


    <!-- Edit Modal -->
    <div class="modal fade" id="editwebsiteLabelModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form id="editwebsiteLabelForm">
                    <div class="modal-header">
                        <h5 class="modal-title">Edit Website Label</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" id="editIdEn" name="websiteLabelEnId" />
                        <input type="hidden" id="editIdAr" name="websiteLabelArId" />
                        <input type="hidden" id="editWebsiteLabelName" name="websiteLabelName" />

                        <div class="mb-3">
                            <label class="form-label">Title (English)</label>
                            <input type="text" id="editTitleEn" class="form-control" dir="ltr" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Title (Arabic)</label>
                            <input type="text" id="editTitleAr" class="form-control" dir="rtl" required />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Delete Modal -->
    <div class="modal fade" id="deletewebsiteLabelModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form id="deletewebsiteLabelForm">
                    <div class="modal-header">
                        <h5 class="modal-title">Confirm Delete</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" id="deleteIdEn" name="websiteLabelEnId" />
                        <input type="hidden" id="deleteIdAr" name="websiteLabelArId" />
                        <p>Are you sure you want to delete <strong id="deleteTitle"></strong>?</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger">Delete</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- JS -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

<script>
        $(document).ready(function () {
            $('#websiteLabelTable').DataTable({
                responsive: true,        
                scrollX: true,              
                autoWidth: false,           
                pageLength: 10,

                language: {
                    emptyTable: "No websiteLabels found"
                },

                columnDefs: [
                    { orderable: false, targets: [4] } // Action column
                ]
            });
        });


        // ----------------------
        // Alerts
        // ----------------------
        function showMessage(message, type = 'success') {
            const wrapper = document.getElementById('alertWrapper');

            // Ensure wrapper is always on top
            wrapper.style.position = 'fixed';
            wrapper.style.top = '20px';
            wrapper.style.right = '20px';
            wrapper.style.zIndex = '2000'; // higher than Bootstrap modal (1055)

            const div = document.createElement('div');
            div.innerHTML = `
                <div class="alert alert-${type} alert-dismissible fade show" role="alert">
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            `;

            wrapper.append(div);

            setTimeout(() => {
                bootstrap.Alert.getOrCreateInstance(div.querySelector('.alert')).close();
            }, 3000);
        }


    // ----------------------
    // Update Table Row
    // ----------------------
    function updateRow(data) {
        // Find the button in the table row
        const button = document.querySelector(`button[data-id-en="${data.websiteLabelEnId}"]`);
        if (!button) {
            console.warn("Button not found for websiteLabelEnId =", data.websiteLabelEnId);
            return;
        }

        // Find the table row
        const row = button.closest('tr');
        if (!row) {
            console.warn("Row not found for websiteLabelEnId =", data.websiteLabelEnId);
            return;
        }

        // Update the cells
        const titleEnCell = row.querySelector('.title-en');
        const titleArCell = row.querySelector('.title-ar');

        if (titleEnCell) titleEnCell.innerText = data.TitleEn;
        if (titleArCell) titleArCell.innerText = data.TitleAr;

        // Update Edit button attributes
        const editBtn = row.querySelector('[data-bs-target="#editwebsiteLabelModal"]');
        if (editBtn) {
            editBtn.setAttribute('data-title-en', data.TitleEn);
            editBtn.setAttribute('data-title-ar', data.TitleAr);
            editBtn.setAttribute('data-website-label', data.WebsiteLabelName);
        }

        // Update Delete button attributes
        const deleteBtn = row.querySelector('[data-bs-target="#deletewebsiteLabelModal"]');
        if (deleteBtn) {
            deleteBtn.setAttribute('data-title-en', data.TitleEn);
            deleteBtn.setAttribute('data-title-ar', data.TitleAr);
            deleteBtn.setAttribute('data-website-label', data.WebsiteLabelName);
        }
    }

    // ----------------------
    // Handle Edit Modal
    // ----------------------
    $('#editwebsiteLabelModal').on('show.bs.modal', function (event) {
        const button = event.relatedTarget;

        $('#editIdEn').val(button.dataset.idEn);
        $('#editIdAr').val(button.dataset.idAr);
        $('#editTitleEn').val(button.dataset.titleEn);
        $('#editTitleAr').val(button.dataset.titleAr);
        $('#editWebsiteLabelName').val(button.dataset.websiteLabel);
    });

    // ----------------------
    // Submit Edit Form
    // ----------------------
    $('#editwebsiteLabelForm').on('submit', function (e) {
        e.preventDefault();

        const data = {
            websiteLabelEnId: $('#editIdEn').val(),
            websiteLabelArId: $('#editIdAr').val(),
            WebsiteLabelName: $('#editWebsiteLabelName').val(),
            TitleEn: $('#editTitleEn').val(),
            TitleAr: $('#editTitleAr').val()
        };

        fetch('/Admin/EditWebsiteLabel', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        })
            .then(res => res.json())
            .then(result => {
                const modal = bootstrap.Modal.getInstance(editwebsiteLabelModal);
                if (modal) modal.hide();

                if (result.success) {
                    updateRow(data); // safely update table
                    showMessage(result.message, 'success');
                } else {
                    showMessage(result.message || 'Update failed!', 'danger');
                }
            })
            .catch(err => {
                console.error(err);
                showMessage('Update failed due to network error!', 'danger');
            });
    });

        // ----------------------
        // Handle Delete Modal
        // ----------------------
        $('#deletewebsiteLabelModal').on('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            $('#deleteIdEn').val(button.getAttribute('data-id-en'));
            $('#deleteIdAr').val(button.getAttribute('data-id-ar'));
           
            $('#deleteTitle').text(button.getAttribute('data-title-en') + ' | ' + button.getAttribute('data-title-ar'));
        });

        $('#deletewebsiteLabelForm').on('submit', function (e) {
            e.preventDefault();
            const data = { websiteLabelEnId: $('#deleteIdEn').val(), websiteLabelArId: $('#deleteIdAr').val() };
            fetch('/Admin/DeleteWebsiteLabel', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                body: JSON.stringify(data)
            })
                .then(res => res.json())
                .then(result => {
                    bootstrap.Modal.getInstance(document.getElementById('deletewebsiteLabelModal')).hide();
                    if (result.success) {
                        const row = document.querySelector(`button[data-id-en="${data.websiteLabelEnId}"]`).closest('tr');
                        row.remove();
                        showMessage(result.message, 'success');
                    } else showMessage(result.message, 'danger');
                })
                .catch(() => showMessage('Delete failed!', 'danger'));
        });


    // ----------------------
    // Add websiteLabel
    // ----------------------
    $('#addwebsiteLabelForm').on('submit', async function (e) {
        e.preventDefault();

        const titleEn = $('#addTitleEn').val().trim();
        const titleAr = $('#addTitleAr').val().trim();
        const websiteLabelName = $('#addWebsiteLabelName').val().trim();

        //  Required field validation
        if (!titleEn || !titleAr || !websiteLabelName) {
            showMessage('All data is required.', 'danger');
            return;
        }

        try {
            const formData = new FormData();
            formData.append('TitleEn', titleEn);
            formData.append('TitleAr', titleAr);
            formData.append('WebsiteLabelName', websiteLabelName);

            const response = await fetch('/Admin/AddwebsiteLabel', {
                method: 'POST',
                body: formData
            });

            const result = await response.json();

            // Close modal
            bootstrap.Modal.getInstance(
                document.getElementById('addwebsiteLabelModal')
            ).hide();

            if (result.success) {
                showMessage(result.message, 'success');
                // Optionally: reload or add row dynamically
                location.reload();
            } else {
                showMessage(result.message || 'Failed to add websiteLabel.', 'danger');
            }
        } catch (error) {
            console.error(error);
            showMessage('An unexpected error occurred while adding the websiteLabel.', 'danger');
        }
    });

</script>
