@using RentalCar.DomainLayer.DTO
@{
    Layout = "_AdminLTELayout";
    ViewData["Title"] = "Website Labels";
    var isRtl = (bool?)ViewData["IsRtl"] ?? false;
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
    <style>
        #websiteLabelTable th, #websiteLabelTable td { text-align: center !important; }
        .websiteLabel-title { white-space: nowrap; }
        .title-en { direction: ltr; font-weight: 500; }
        .title-ar { direction: rtl; font-weight: 500; }
        .alert-wrapper { position: fixed; top: 80px; right: 20px; z-index: 1055; }
        .modal-title { color: #c30e0e; font-weight: bold; }
    </style>
}

<!-- Content Header -->
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0"><i class="fas fa-tags mr-2"></i>Website Labels</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb @(isRtl ? "float-sm-left" : "float-sm-right")">
                    <li class="breadcrumb-item"><a href="/Admin/Index">Home</a></li>
                    <li class="breadcrumb-item active">Website Labels</li>
                </ol>
            </div>
        </div>
    </div>
</section>

<!-- Main content -->
<section class="content">
    <div class="container-fluid">

        <!-- Alert wrapper -->
        <div id="alertWrapper" class="alert-wrapper"></div>

        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="card-title mt-1"><i class="fas fa-list mr-1"></i> All Website Labels</h3>
                <button class="btn btn-success btn-sm" data-toggle="modal" data-target="#addwebsiteLabelModal">
                    <i class="fas fa-plus-circle mr-1"></i> Add Website Label
                </button>
            </div>
            <div class="card-body">

                <!-- DataTable -->
                <table id="websiteLabelTable" class="table table-striped table-bordered nowrap" style="width:100%">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Label Name</th>
                            <th>Title English</th>
                            <th>Title Arabic</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var count = 1;
                            var websiteLabelEn = ViewBag.websiteLabelEn as List<AppLabelDTO> ?? new();
                            var websiteLabelAr = ViewBag.websiteLabelAr as List<AppLabelDTO> ?? new();
                            var rowCount = Math.Min(websiteLabelEn.Count, websiteLabelAr.Count);
                        }

                        @for (int i = 0; i < rowCount; i++)
                        {
                            <tr>
                                <td>@count</td>
                                <td class="title-en">@websiteLabelEn[i].LabelName</td>
                                <td>@websiteLabelEn[i].Value</td>
                                <td>@websiteLabelAr[i].Value</td>
                                <td>
                                    <button class="btn btn-sm btn-primary"
                                            data-toggle="modal"
                                            data-target="#editwebsiteLabelModal"
                                            data-id-en="@websiteLabelEn[i].Id"
                                            data-id-ar="@websiteLabelAr[i].Id"
                                            data-title-en="@websiteLabelEn[i].Value"
                                            data-title-ar="@websiteLabelAr[i].Value"
                                            data-website-label="@websiteLabelEn[i].LabelName">
                                        Edit
                                    </button>
                                    <button class="btn btn-sm btn-danger"
                                            data-toggle="modal"
                                            data-target="#deletewebsiteLabelModal"
                                            data-id-en="@websiteLabelEn[i].Id"
                                            data-id-ar="@websiteLabelAr[i].Id"
                                            data-title-en="@websiteLabelEn[i].Value"
                                            data-title-ar="@websiteLabelAr[i].Value">
                                        Delete
                                    </button>
                                </td>
                            </tr>
                            count++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<!--Add Modal-->
<div class="modal fade" id="addwebsiteLabelModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="addwebsiteLabelForm" enctype="multipart/form-data">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-plus-circle mr-1"></i> Add Website Label</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Label Name *</label>
                        <input type="text" class="form-control" id="addWebsiteLabelName" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Title (English) *</label>
                        <textarea class="form-control" id="addTitleEn" rows="2" dir="ltr" required></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Title (Arabic) *</label>
                        <textarea class="form-control" id="addTitleAr" rows="2" dir="rtl" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success"><i class="fas fa-check-circle mr-1"></i> Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editwebsiteLabelModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="editwebsiteLabelForm">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Website Label</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="editIdEn" name="websiteLabelEnId" />
                    <input type="hidden" id="editIdAr" name="websiteLabelArId" />
                    <input type="hidden" id="editWebsiteLabelName" name="websiteLabelName" />

                    <div class="mb-3">
                        <label class="form-label">Title (English)</label>
                        <input type="text" id="editTitleEn" class="form-control" dir="ltr" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Title (Arabic)</label>
                        <input type="text" id="editTitleAr" class="form-control" dir="rtl" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deletewebsiteLabelModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="deletewebsiteLabelForm">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm Delete</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="deleteIdEn" name="websiteLabelEnId" />
                    <input type="hidden" id="deleteIdAr" name="websiteLabelArId" />
                    <p>Are you sure you want to delete <strong id="deleteTitle"></strong>?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#websiteLabelTable').DataTable({
                responsive: true,
                scrollX: true,
                autoWidth: false,
                pageLength: 10,
                language: { emptyTable: "No websiteLabels found" },
                columnDefs: [
                    { orderable: false, targets: [4] } // Action column
                ]
            });
        });

        function showMessage(message, type = 'success') {
            const wrapper = document.getElementById('alertWrapper');
            const div = document.createElement('div');
            div.innerHTML = `
                <div class="alert alert-${type} alert-dismissible fade show" role="alert">
                    ${message}
                    <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                </div>
            `;
            wrapper.append(div);
            setTimeout(() => { $(div).find('.alert').alert('close'); }, 3000);
        }

        function updateRow(data) {
            const button = document.querySelector(`button[data-id-en="${data.websiteLabelEnId}"]`);
            if (!button) { console.warn("Button not found for websiteLabelEnId =", data.websiteLabelEnId); return; }

            const row = button.closest('tr');
            if (!row) { console.warn("Row not found for websiteLabelEnId =", data.websiteLabelEnId); return; }

            const titleEnCell = row.querySelector('.title-en');
            const titleArCell = row.querySelector('.title-ar');
            if (titleEnCell) titleEnCell.innerText = data.TitleEn;
            if (titleArCell) titleArCell.innerText = data.TitleAr;

            const editBtn = row.querySelector('[data-target="#editwebsiteLabelModal"]');
            if (editBtn) {
                editBtn.setAttribute('data-title-en', data.TitleEn);
                editBtn.setAttribute('data-title-ar', data.TitleAr);
                editBtn.setAttribute('data-website-label', data.WebsiteLabelName);
            }

            const deleteBtn = row.querySelector('[data-target="#deletewebsiteLabelModal"]');
            if (deleteBtn) {
                deleteBtn.setAttribute('data-title-en', data.TitleEn);
                deleteBtn.setAttribute('data-title-ar', data.TitleAr);
                deleteBtn.setAttribute('data-website-label', data.WebsiteLabelName);
            }
        }

        $('#editwebsiteLabelModal').on('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            $('#editIdEn').val(button.dataset.idEn);
            $('#editIdAr').val(button.dataset.idAr);
            $('#editTitleEn').val(button.dataset.titleEn);
            $('#editTitleAr').val(button.dataset.titleAr);
            $('#editWebsiteLabelName').val(button.dataset.websiteLabel);
        });

        $('#editwebsiteLabelForm').on('submit', function (e) {
            e.preventDefault();

            const data = {
                websiteLabelEnId: $('#editIdEn').val(),
                websiteLabelArId: $('#editIdAr').val(),
                WebsiteLabelName: $('#editWebsiteLabelName').val(),
                TitleEn: $('#editTitleEn').val(),
                TitleAr: $('#editTitleAr').val()
            };

            fetch('/Admin/EditWebsiteLabel', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            })
                .then(res => res.json())
                .then(result => {
                    $('#editwebsiteLabelModal').modal('hide');
                    if (result.success) {
                        updateRow(data);
                        showMessage(result.message, 'success');
                    } else {
                        showMessage(result.message || 'Update failed!', 'danger');
                    }
                })
                .catch(err => {
                    console.error(err);
                    showMessage('Update failed due to network error!', 'danger');
                });
        });

        $('#deletewebsiteLabelModal').on('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            $('#deleteIdEn').val(button.getAttribute('data-id-en'));
            $('#deleteIdAr').val(button.getAttribute('data-id-ar'));
            $('#deleteTitle').text(button.getAttribute('data-title-en') + ' | ' + button.getAttribute('data-title-ar'));
        });

        $('#deletewebsiteLabelForm').on('submit', function (e) {
            e.preventDefault();
            const data = { websiteLabelEnId: $('#deleteIdEn').val(), websiteLabelArId: $('#deleteIdAr').val() };
            fetch('/Admin/DeleteWebsiteLabel', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                body: JSON.stringify(data)
            })
                .then(res => res.json())
                .then(result => {
                    $('#deletewebsiteLabelModal').modal('hide');
                    if (result.success) {
                        const row = document.querySelector(`button[data-id-en="${data.websiteLabelEnId}"]`).closest('tr');
                        row.remove();
                        showMessage(result.message, 'success');
                    } else showMessage(result.message, 'danger');
                })
                .catch(() => showMessage('Delete failed!', 'danger'));
        });

        $('#addwebsiteLabelForm').on('submit', async function (e) {
            e.preventDefault();

            const titleEn = $('#addTitleEn').val().trim();
            const titleAr = $('#addTitleAr').val().trim();
            const websiteLabelName = $('#addWebsiteLabelName').val().trim();

            if (!titleEn || !titleAr || !websiteLabelName) {
                showMessage('All data is required.', 'danger');
                return;
            }

            try {
                const formData = new FormData();
                formData.append('TitleEn', titleEn);
                formData.append('TitleAr', titleAr);
                formData.append('WebsiteLabelName', websiteLabelName);

                const response = await fetch('/Admin/AddwebsiteLabel', { method: 'POST', body: formData });
                const result = await response.json();

                $('#addwebsiteLabelModal').modal('hide');

                if (result.success) {
                    showMessage(result.message, 'success');
                    location.reload();
                } else {
                    showMessage(result.message || 'Failed to add websiteLabel.', 'danger');
                }
            } catch (error) {
                console.error(error);
                showMessage('An unexpected error occurred while adding the websiteLabel.', 'danger');
            }
        });
    </script>
}
