@using RentalCar.DomainLayer.DTO;

@{
    Layout = "_AdminLTELayout";
    ViewData["Title"] = "Contact Us";
    var isRtl = (bool?)ViewData["IsRtl"] ?? false;
}

<!-- Content Header -->
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0"><i class="fas fa-hand-pointer mr-2"></i>Contact Us</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb @(isRtl ? "float-sm-left" : "float-sm-right")">
                    <li class="breadcrumb-item"><a href="/Admin/Index">Home</a></li>
                    <li class="breadcrumb-item active">Contact Us</li>
                </ol>
            </div>
        </div>
    </div>
</section>

<!-- Main content -->
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title mt-1"><i class="fas fa-hand-pointer mr-1"></i> Message Details</h3>
                    </div>
                    <div class="card-body">
                        <form enctype="multipart/form-data" method="post">
                            <div class="form-group">
                                <label>Name <span class="text-danger">*</span></label>
                                <input type="text" name="UserName" value="@Model.FirstName @Model.LastName" disabled class="form-control" />
                            </div>
                            <div class="form-group">
                                <label>Email <span class="text-danger">*</span></label>
                                <input type="text" name="Email" value="@Model.Email" disabled class="form-control" />
                            </div>
                            <div class="form-group">
                                <label>Subject <span class="text-danger">*</span></label>
                                <input type="text" name="Subject" value="@Model.Subject" disabled class="form-control" />
                            </div>
                            <div class="form-group">
                                <label>Message <span class="text-danger">*</span></label>
                                <textarea disabled name="Text" style="height: 147px;" class="form-control">@Model.Message</textarea>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
