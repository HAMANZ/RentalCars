@using RentalCar.DomainLayer.DTO
@model List<WorkOrderDTO>
@{
    Layout = "_AdminLTELayout";
    ViewData["Title"] = "Work Orders";
    var isRtl = (bool?)ViewData["IsRtl"] ?? false;
    var carModels = ViewBag.CarModels as Dictionary<long, string> ?? new Dictionary<long, string>();
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
    <style>#woTable th, #woTable td { text-align:center !important; vertical-align:middle; }</style>
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6"><h1 class="m-0"><i class="fas fa-clipboard-list mr-2"></i>Work Orders</h1></div>
            <div class="col-sm-6">
                <ol class="breadcrumb @(isRtl ? "float-sm-left" : "float-sm-right")">
                    <li class="breadcrumb-item"><a href="/Admin/Index">Home</a></li>
                    <li class="breadcrumb-item active">Work Orders</li>
                </ol>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        @if (ViewBag.ErrorMessage != null) { <div class="alert alert-danger">@ViewBag.ErrorMessage</div> }
        @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
        @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="card-title mt-1"><i class="fas fa-list mr-1"></i> All Work Orders</h3>
                <a class="btn btn-success btn-sm" href="/WorkOrders/Create"><i class="fas fa-plus-circle mr-1"></i> Add</a>
            </div>
            <div class="card-body">
                <table id="woTable" class="table table-striped table-bordered nowrap" style="width:100%">
                    <thead><tr><th>#</th><th>Car</th><th>Date</th><th>Current KM</th><th>Parts Cost</th><th>Total Cost</th><th>Action</th></tr></thead>
                    <tbody>
                        @{ var count = 1; }
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@count</td>
                                <td>@(item.CarId.HasValue && carModels.ContainsKey(item.CarId.Value) ? carModels[item.CarId.Value] : "-")</td>
                                <td>@item.Date.ToString("yyyy-MM-dd")</td>
                                <td>@item.CurrentKM</td>
                                <td>@item.PartsCost.ToString("N2")</td>
                                <td>@item.TotalCost.ToString("N2")</td>
                                <td>
                                    <form method="post" asp-action="Delete" asp-controller="WorkOrders" class="d-inline"
                                          onsubmit="return confirm('Delete this work order?');">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                            count++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script>
        $(function () {
            $('#woTable').DataTable({ responsive: true, pageLength: 10, lengthMenu: [5,10,25,50],
                language: { emptyTable: "No work orders found" }, columnDefs: [{ orderable:false, targets:[6] }] });
        });
    </script>
}
