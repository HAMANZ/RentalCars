@using RentalCar.DomainLayer.DTO
@using RentalCar.DomainLayer.Models
@using DomainLayer.Models
@model WorkOrderDTO
@{
    Layout = "_AdminLTELayout";
    ViewData["Title"] = "Add Work Order";
    var isRtl = (bool?)ViewData["IsRtl"] ?? false;
    var cars = ViewBag.Cars as List<Car> ?? new List<Car>();
    var statuses = ViewBag.Statuses as List<Status> ?? new List<Status>();
    var repairs = ViewBag.Repairs as List<Repair> ?? new List<Repair>();
    var spareParts = ViewBag.SpareParts as List<SparePart> ?? new List<SparePart>();
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6"><h1 class="m-0"><i class="fas fa-clipboard-list mr-2"></i>Add Work Order</h1></div>
            <div class="col-sm-6">
                <ol class="breadcrumb @(isRtl ? "float-sm-left" : "float-sm-right")">
                    <li class="breadcrumb-item"><a href="/Admin/Index">Home</a></li>
                    <li class="breadcrumb-item"><a href="/WorkOrders">Work Orders</a></li>
                    <li class="breadcrumb-item active">Add</li>
                </ol>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

        <form asp-action="Create" asp-controller="WorkOrders" method="post">
            <div class="card card-primary card-outline">
                <div class="card-header"><h3 class="card-title mt-1"><i class="fas fa-plus mr-1"></i> Work Order Details</h3></div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Car</label>
                            <select name="CarId" class="form-control" required>
                                <option value="">-- Select Car --</option>
                                @foreach (var c in cars)
                                {
                                    <option value="@c.Id" selected="@(Model.CarId == c.Id)">@c.Model (@c.VIN)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Status</label>
                            <select name="StatusId" class="form-control">
                                <option value="">-- Select Status --</option>
                                @foreach (var s in statuses)
                                {
                                    <option value="@s.Id" selected="@(Model.StatusId == s.Id)">@s.Name</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Date</label>
                            <input type="date" name="Date" class="form-control"
                                   value="@(Model.Date == default(DateTime) ? DateTime.Today.ToString("yyyy-MM-dd") : Model.Date.ToString("yyyy-MM-dd"))" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Current KM</label>
                            <input type="number" name="CurrentKM" class="form-control" value="@Model.CurrentKM" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="card card-info card-outline">
                <div class="card-header">
                    <h3 class="card-title mt-1"><i class="fas fa-tools mr-1"></i> Work Order Line Items</h3>
                    <div class="card-tools">
                        <button type="button" id="addDetailRow" class="btn btn-sm btn-info">
                            <i class="fas fa-plus mr-1"></i> Add Row
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <table class="table table-sm table-bordered" id="detailsTable">
                        <thead>
                            <tr>
                                <th style="width:25%">Repair</th>
                                <th style="width:25%">Spare Part</th>
                                <th style="width:15%">Price</th>
                                <th style="width:12%">Quantity</th>
                                <th style="width:18%">Total</th>
                                <th style="width:5%"></th>
                            </tr>
                        </thead>
                        <tbody id="detailsBody">
                            <tr class="text-muted"><td colspan="6" class="text-center">No line items added.</td></tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <th colspan="2" class="text-end">Parts Cost</th>
                                <th colspan="2"><input type="text" id="summaryPartsCost" class="form-control form-control-sm" readonly value="0.00" /></th>
                                <th class="text-end">Total Cost</th>
                                <th><input type="text" id="summaryTotalCost" class="form-control form-control-sm" readonly value="0.00" /></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <div class="mt-3 mb-4">
                <button type="submit" class="btn btn-primary"><i class="fas fa-save mr-1"></i> Save</button>
                <a href="/WorkOrders" class="btn btn-secondary ml-2">Cancel</a>
            </div>
        </form>

        @* Template for a single detail row (parallel arrays bound by row order). *@
        <template id="detailRowTemplate">
            <tr class="detail-row">
                <td>
                    <select name="DetailRepairIds" class="form-control form-control-sm">
                        <option value="0">-- Select Repair --</option>
                        @foreach (var r in repairs)
                        {
                            <option value="@r.Id" data-price="@r.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)">@r.Name</option>
                        }
                    </select>
                </td>
                <td>
                    <select name="DetailSparePartIds" class="form-control form-control-sm">
                        <option value="0">-- Select Spare Part --</option>
                        @foreach (var p in spareParts)
                        {
                            var outOfStock = p.StockQty <= 0;
                            <option value="@p.Id"
                                    data-price="@p.SellingPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                    data-stock="@p.StockQty"
                                    disabled="@outOfStock">
                                @p.Name @(outOfStock ? "(out of stock)" : $"(in stock: {p.StockQty})")
                            </option>
                        }
                    </select>
                </td>
                <td>
                    <input type="text" class="form-control form-control-sm row-price" readonly value="0.00" />
                </td>
                <td>
                    <input type="number" name="DetailQuantities" class="form-control form-control-sm" value="1" min="0" />
                </td>
                <td>
                    <input type="number" step="0.01" name="DetailTotals" class="form-control form-control-sm" value="0" min="0" />
                </td>
                <td class="text-center">
                    <button type="button" class="btn btn-sm btn-danger remove-detail-row"><i class="fas fa-trash"></i></button>
                </td>
            </tr>
        </template>
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            var body = document.getElementById('detailsBody');
            var template = document.getElementById('detailRowTemplate');
            var placeholderHtml = '<tr class="text-muted"><td colspan="6" class="text-center">No line items added.</td></tr>';

            function toNumber(v) {
                var n = parseFloat(v);
                return isNaN(n) ? 0 : n;
            }

            function hasRows() {
                return body.querySelectorAll('tr.detail-row').length > 0;
            }

            function refreshPlaceholder() {
                if (!hasRows()) {
                    body.innerHTML = placeholderHtml;
                }
            }

            function recalcRow(tr) {
                var priceInput = tr.querySelector('.row-price');
                var qtyInput = tr.querySelector('input[name="DetailQuantities"]');
                var totalInput = tr.querySelector('input[name="DetailTotals"]');
                var price = toNumber(priceInput.value);
                var qty = toNumber(qtyInput.value);
                if (price > 0) {
                    totalInput.value = (price * qty).toFixed(2);
                }
            }

            function recalcSummary() {
                var totalCost = 0, partsCost = 0;
                body.querySelectorAll('tr.detail-row').forEach(function (tr) {
                    var totalInput = tr.querySelector('input[name="DetailTotals"]');
                    totalCost += toNumber(totalInput.value);

                    var sparePartSelect = tr.querySelector('select[name="DetailSparePartIds"]');
                    if (sparePartSelect.value && sparePartSelect.value !== '0') {
                        var priceInput = tr.querySelector('.row-price');
                        var qtyInput = tr.querySelector('input[name="DetailQuantities"]');
                        partsCost += toNumber(priceInput.value) * toNumber(qtyInput.value);
                    }
                });
                document.getElementById('summaryTotalCost').value = totalCost.toFixed(2);
                document.getElementById('summaryPartsCost').value = partsCost.toFixed(2);
            }

            document.getElementById('addDetailRow').addEventListener('click', function () {
                if (!hasRows()) {
                    body.innerHTML = '';
                }
                body.appendChild(template.content.cloneNode(true));
                recalcSummary();
            });

            body.addEventListener('click', function (e) {
                var btn = e.target.closest('.remove-detail-row');
                if (!btn) return;
                btn.closest('tr.detail-row').remove();
                refreshPlaceholder();
                recalcSummary();
            });

            body.addEventListener('change', function (e) {
                var tr = e.target.closest('tr.detail-row');
                if (!tr) return;

                if (e.target.matches('select[name="DetailRepairIds"]') || e.target.matches('select[name="DetailSparePartIds"]')) {
                    var opt = e.target.selectedOptions[0];
                    var price = opt ? toNumber(opt.getAttribute('data-price')) : 0;
                    tr.querySelector('.row-price').value = price.toFixed(2);
                    recalcRow(tr);
                }

                if (e.target.matches('input[name="DetailQuantities"]')) {
                    recalcRow(tr);
                }

                recalcSummary();
            });

            body.addEventListener('input', function (e) {
                if (e.target.matches('input[name="DetailTotals"]') || e.target.matches('input[name="DetailQuantities"]')) {
                    recalcSummary();
                }
            });
        })();
    </script>
}
