@using RentalCar.DomainLayer.DTO
@using RentalCar.DomainLayer.Models
@model CarOwnerDTO
@{
    var nationalities = ViewBag.Nationalities as List<Nationality> ?? new List<Nationality>();
    var countries = ViewBag.Countries as List<Country> ?? new List<Country>();
    var cities = ViewBag.Cities as List<City> ?? new List<City>();
}

<input type="hidden" name="Id" value="@Model.Id" />

<div class="row">
    <div class="col-md-6 mb-3">
        <label class="form-label">Full Name</label>
        <input type="text" name="FullName" class="form-control" value="@Model.FullName" required />
    </div>
    <div class="col-md-6 mb-3">
        <label class="form-label">Company Name</label>
        <input type="text" name="CompanyName" class="form-control" value="@Model.CompanyName" />
    </div>

    <div class="col-md-6 mb-3">
        <label class="form-label">Passport No</label>
        <input type="text" name="PassportNo" class="form-control" value="@Model.PassportNo" />
    </div>
    <div class="col-md-6 mb-3">
        <label class="form-label">Commercial Register</label>
        <input type="text" name="CommercialRegister" class="form-control" value="@Model.CommercialRegister" />
    </div>

    <div class="col-md-6 mb-3">
        <label class="form-label">Phone 1</label>
        <input type="text" name="Phone1" class="form-control" value="@Model.Phone1" />
    </div>
    <div class="col-md-6 mb-3">
        <label class="form-label">Phone 2</label>
        <input type="text" name="Phone2" class="form-control" value="@Model.Phone2" />
    </div>

    <div class="col-md-6 mb-3">
        <label class="form-label">Email</label>
        <input type="email" name="Email" class="form-control" value="@Model.Email" />
    </div>
    <div class="col-md-6 mb-3">
        <label class="form-label">Nationality</label>
        <select name="NationalityId" class="form-control">
            <option value="">-- Select Nationality --</option>
            @foreach (var n in nationalities)
            {
                <option value="@n.Id" selected="@(Model.NationalityId == n.Id)">@n.Name</option>
            }
        </select>
    </div>

    <div class="col-md-6 mb-3">
        <label class="form-label">Country</label>
        <select name="CountryId" class="form-control">
            <option value="">-- Select Country --</option>
            @foreach (var c in countries)
            {
                <option value="@c.Id" selected="@(Model.CountryId == c.Id)">@c.Name</option>
            }
        </select>
    </div>
    <div class="col-md-6 mb-3">
        <label class="form-label">City</label>
        <select name="CityId" class="form-control">
            <option value="">-- Select City --</option>
            @foreach (var c in cities)
            {
                <option value="@c.Id" selected="@(Model.CityId == c.Id)">@c.Name</option>
            }
        </select>
    </div>

    <div class="col-md-12 mb-3">
        <label class="form-label">Address</label>
        <input type="text" name="Address" class="form-control" value="@Model.Address" />
    </div>

    <div class="col-md-12 mb-3">
        <label class="form-label">Notes</label>
        <textarea name="Notes" class="form-control" rows="2">@Model.Notes</textarea>
    </div>

    <div class="col-md-6 mb-3">
        <div class="form-check">
            <input type="checkbox" class="form-check-input" id="IsCompany" name="IsCompany" value="true" @(Model.IsCompany ? "checked" : "") />
            <input type="hidden" name="IsCompany" value="false" />
            <label class="form-check-label" for="IsCompany">Is Company</label>
        </div>
    </div>
    <div class="col-md-6 mb-3">
        <div class="form-check">
            <input type="checkbox" class="form-check-input" id="IsActive" name="IsActive" value="true" @(Model.IsActive ? "checked" : "") />
            <input type="hidden" name="IsActive" value="false" />
            <label class="form-check-label" for="IsActive">Active</label>
        </div>
    </div>
</div>
