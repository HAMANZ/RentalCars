@{
    Layout = "_AdminLTELayout";
    ViewData["Title"] = "Import Repair Categories";
    var isRtl = (bool?)ViewData["IsRtl"] ?? false;
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6"><h1 class="m-0"><i class="fas fa-file-excel mr-2"></i>Import Repair Categories</h1></div>
            <div class="col-sm-6">
                <ol class="breadcrumb @(isRtl ? "float-sm-left" : "float-sm-right")">
                    <li class="breadcrumb-item"><a href="/Admin/Index">Home</a></li>
                    <li class="breadcrumb-item"><a href="/RepairCategories">Repair Categories</a></li>
                    <li class="breadcrumb-item active">Import</li>
                </ol>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
        @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

        <div class="card card-primary card-outline">
            <div class="card-header"><h3 class="card-title mt-1"><i class="fas fa-file-import mr-1"></i> Import from Excel</h3></div>
            <div class="card-body">
                <ol class="mb-4">
                    <li>
                        <a asp-action="DownloadTemplate" asp-controller="RepairCategories">
                            <i class="fas fa-download mr-1"></i>Download the Excel template
                        </a>
                    </li>
                    <li>Fill in one row per repair category (keep the header row as-is; the example row can be deleted).</li>
                    <li>Choose the filled file and click Import.</li>
                </ol>

                <form asp-action="Import" asp-controller="RepairCategories" method="post" enctype="multipart/form-data">
                    <div class="col-md-6 mb-3 p-0">
                        <label class="form-label">Excel File (.xlsx)</label>
                        <input type="file" name="File" class="form-control-file" accept=".xlsx" required />
                    </div>
                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary"><i class="fas fa-file-import mr-1"></i> Import</button>
                        <a href="/RepairCategories" class="btn btn-secondary ml-2">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>
